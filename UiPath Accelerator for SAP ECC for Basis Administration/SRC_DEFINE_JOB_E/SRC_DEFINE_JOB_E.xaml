  <Sequence sap2010:Annotation.AnnotationText="- Overview&#xA;  SM36 automation, background job registration&#xA;&#xA;- Input/Output&#xA;  in_ArgumentFilePath as Argument File Path &lt;String&gt;" DisplayName="SRC_DEFINE_JOB_E" sap2010:WorkflowViewState.IdRef="Sequence_429">
