    <Sequence sap2010:Annotation.AnnotationText="[Initial process]&#xA;1. Read Argument file and store data in Dictionary Config.&#xA;2. Check Argument parameters consistency, such as file path.&#xA;3. Read Component Resources file and store in Dictionary Config.&#xA;4. Set Log file name with current timestamp.&#xA;5. Build a Data Table with parameters used for SAP GUI control.&#xA;6. Check if SAP GUI is running and maximize the screen.&#xA;7. Load Input File and Selector File from Excel file." DisplayName="Initialization" sap2010:WorkflowViewState.IdRef="Sequence_833">
      <Sequence sap2010:Annotation.AnnotationText="1. Read Argument file and store data in Dictionary Config." DisplayName="Read Argument File" sap2010:WorkflowViewState.IdRef="Sequence_831">
        <Sequence.Variables>
          <Variable x:TypeArguments="sd:DataTable" Name="dt_ConfigTable" />
        </Sequence.Variables>
        <ui:ReadRange Range="{x:Null}" AddHeaders="True" DataTable="[dt_ConfigTable]" DisplayName="Read Range Config" sap2010:WorkflowViewState.IdRef="ReadRange_4" SheetName="Settings" WorkbookPath="[in_ArgumentFilePath]" />
        <ui:ForEachRow CurrentIndex="{x:Null}" DataTable="[dt_ConfigTable]" DisplayName="For each row in Config" sap2010:WorkflowViewState.IdRef="ForEachRow_7">
          <ui:ForEachRow.Body>
            <ActivityAction x:TypeArguments="sd:DataRow">
              <ActivityAction.Argument>
                <DelegateInArgument x:TypeArguments="sd:DataRow" Name="row" />
              </ActivityAction.Argument>
              <If Condition="[NOT String.IsNullOrEmpty(row(&quot;Name&quot;).ToString.Trim)]" DisplayName="If Name in Config is empty or null" sap2010:WorkflowViewState.IdRef="If_291">
                <If.Then>
                  <Assign DisplayName="Add key/value pair Config" sap2010:WorkflowViewState.IdRef="Assign_748">
                    <Assign.To>
                      <OutArgument x:TypeArguments="x:Object">[Config(row("Name").ToString.Trim)]</OutArgument>
                    </Assign.To>
                    <Assign.Value>
                      <InArgument x:TypeArguments="x:Object">[row("Value")]</InArgument>
                    </Assign.Value>
                  </Assign>
                </If.Then>
              </If>
            </ActivityAction>
          </ui:ForEachRow.Body>
        </ui:ForEachRow>
      </Sequence>
      <ui:InvokeWorkflowFile ContinueOnError="{x:Null}" sap2010:Annotation.AnnotationText="2. Check Argument parameters consistency, such as file path." DisplayName="Invoke Workflow File [CheckArgument]" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_143" UnSafe="False" WorkflowFileName="SRC_DEFINE_JOB_E\CheckArgument.xaml">
        <ui:InvokeWorkflowFile.Arguments>
          <InArgument x:TypeArguments="scg:Dictionary(x:String, x:Object)" x:Key="in_Config">[Config]</InArgument>
        </ui:InvokeWorkflowFile.Arguments>
      </ui:InvokeWorkflowFile>
      <ui:ForEach x:TypeArguments="x:String" CurrentIndex="{x:Null}" sap2010:Annotation.AnnotationText="3. Read Component Resources file and store in Dictionary Config." DisplayName="For each : Read Component Resource File" sap2010:WorkflowViewState.IdRef="ForEach`1_41" Values="[{&quot;BaseSelectors&quot;,&quot;Messages&quot;}]">
        <ui:ForEach.Body>
          <ActivityAction x:TypeArguments="x:String">
