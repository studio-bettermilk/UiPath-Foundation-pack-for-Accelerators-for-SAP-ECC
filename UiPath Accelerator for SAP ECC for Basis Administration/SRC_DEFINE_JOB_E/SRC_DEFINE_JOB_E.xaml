          </ActivityAction>
        </ui:WindowScope.Body>
      </ui:WindowScope>
      <ui:InvokeWorkflowFile ContinueOnError="{x:Null}" sap2010:Annotation.AnnotationText="7. Load Input File and Selector File from Excel file." DisplayName="Invoke Workflow File [SRC_LoadExcelData]" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_144" UnSafe="False" WorkflowFileName="SRC_Common\SRC_LoadExcelData.xaml">
        <ui:InvokeWorkflowFile.Arguments>
          <InArgument x:TypeArguments="x:String" x:Key="in_InputFilePath">[Config("InputFilePath").ToString]</InArgument>
          <InArgument x:TypeArguments="x:String" x:Key="in_SelectorFilePath">[Config("SelectorFilePath").ToString]</InArgument>
          <OutArgument x:TypeArguments="scg:List(x:String)" x:Key="out_SheetNames">[SheetNames]</OutArgument>
          <OutArgument x:TypeArguments="scg:Dictionary(x:String, sd:DataTable)" x:Key="out_InputData">[InputDataSheet]</OutArgument>
          <OutArgument x:TypeArguments="scg:Dictionary(x:String, sd:DataTable)" x:Key="out_SelectorData">[SelectorDataSheet]</OutArgument>
        </ui:InvokeWorkflowFile.Arguments>
      </ui:InvokeWorkflowFile>
    </Sequence>
    <ui:ForEachRow sap2010:Annotation.AnnotationText="Repeat for each row inside InputData." CurrentIndex="[RowCount]" DataTable="[InputDataSheet(SheetNames(0).ToString)]" DisplayName="[Main Loop]" sap2010:WorkflowViewState.IdRef="ForEachRow_5">
      <ui:ForEachRow.Body>
        <ActivityAction x:TypeArguments="sd:DataRow">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="sd:DataRow" Name="row" />
          </ActivityAction.Argument>
          <TryCatch DisplayName="Try Catch" sap2010:WorkflowViewState.IdRef="TryCatch_3">
            <TryCatch.Variables>
              <Variable x:TypeArguments="x:String" Name="HeaderIndex" />
            </TryCatch.Variables>
            <TryCatch.Try>
              <Sequence DisplayName="Process each row" sap2010:WorkflowViewState.IdRef="Sequence_820">
                <Sequence.Variables>
                  <Variable x:TypeArguments="x:Int32" Name="SheetCount" />
                  <Variable x:TypeArguments="x:String" Default="/nSM36" Name="TransactionCode" />
                </Sequence.Variables>
                <ui:InvokeWorkflowFile ContinueOnError="{x:Null}" sap2010:Annotation.AnnotationText="Execute SAP Transaction Code." DisplayName="Move to specified screen" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_128" UnSafe="False" WorkflowFileName="SRC_Common\SRC_SetTransactionCode.xaml">
                  <ui:InvokeWorkflowFile.Arguments>
                    <InArgument x:TypeArguments="x:String" x:Key="in_TransactionCode">[TransactionCode]</InArgument>
                    <InArgument x:TypeArguments="x:String" x:Key="in_Selector">&lt;wnd app='saplogon.exe' cls='SAP_FRONTEND_SESSION' /&gt;&lt;sap id='tbar[0]/okcd' /&gt;</InArgument>
                  </ui:InvokeWorkflowFile.Arguments>
                </ui:InvokeWorkflowFile>
                <Assign DisplayName="Get the primary key of the header" sap2010:WorkflowViewState.IdRef="Assign_740">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:String">[HeaderIndex]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:String">[row.Item(0).ToString]</InArgument>
                  </Assign.Value>
                </Assign>
                <ui:ForEach x:TypeArguments="x:String" CurrentIndex="[SheetCount]" DisplayName="Loop by sheet name" sap2010:WorkflowViewState.IdRef="ForEach`1_38" Values="[SheetNames]">
                  <ui:ForEach.Body>
                    <ActivityAction x:TypeArguments="x:String">
                      <ActivityAction.Argument>
                        <DelegateInArgument x:TypeArguments="x:String" Name="sheet" />
                      </ActivityAction.Argument>
                      <If Condition="[InputDataSheet(sheet).Select(&quot;No = '&quot; &amp; HeaderIndex &amp; &quot;'&quot; ).Count &gt; 0]" DisplayName="If there is input data that matches the header index" sap2010:WorkflowViewState.IdRef="If_287">
                        <If.Then>
                          <ui:InvokeWorkflowFile ContinueOnError="{x:Null}" DisplayName="Invoke Workflow File [SetScreenDataFlow.xaml]" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_135" UnSafe="False" WorkflowFileName="SRC_DEFINE_JOB_E\SetScreenDataFlow.xaml">
                            <ui:InvokeWorkflowFile.Arguments>
                              <InArgument x:TypeArguments="x:String" x:Key="in_HeaderIndex">[HeaderIndex]</InArgument>
                              <InArgument x:TypeArguments="scg:Dictionary(x:String, x:Object)" x:Key="in_Config">[Config]</InArgument>
                              <InArgument x:TypeArguments="sd:DataRow" x:Key="in_Controller">[dt_Controller.Select("SheetName = '" + sheet + "'").CopyToDataTable.Rows(0)]</InArgument>
                              <InArgument x:TypeArguments="sd:DataRow" x:Key="in_TargetSelector">[SelectorDataSheet(sheet).Rows(0)]</InArgument>
                              <InArgument x:TypeArguments="sd:DataRow[]" x:Key="in_TargetValue">[InputDataSheet(sheet).Select("No = '" + HeaderIndex + "'").CopyToDataTable.Select()]</InArgument>
                            </ui:InvokeWorkflowFile.Arguments>
                          </ui:InvokeWorkflowFile>
                        </If.Then>
                        <If.Else>
                          <Throw DisplayName="Target record does not exist in the sheet" Exception="[New UiPath.Core.BusinessRuleException(&quot;[&quot; + sheet + &quot;]&quot; + &quot; sheet has no target record&quot;, New Exception)]" sap2010:WorkflowViewState.IdRef="Throw_1" />
                        </If.Else>
                      </If>
                    </ActivityAction>
                  </ui:ForEach.Body>
                </ui:ForEach>
                <Sequence DisplayName="Save input data" sap2010:WorkflowViewState.IdRef="Sequence_823">
                  <Sequence.Variables>
                    <Variable x:TypeArguments="x:String" Name="StatusMessage" />
                  </Sequence.Variables>
                  <ui:SendHotkey DelayBefore="{x:Null}" DelayBetweenKeys="{x:Null}" DelayMS="{x:Null}" Activate="True" sap2010:Annotation.AnnotationText="Save input data" ClickBeforeTyping="False" DisplayName="Send Hotkey" EmptyField="False" sap2010:WorkflowViewState.IdRef="SendHotkey_65" Key="s" KeyModifiers="Ctrl" SendWindowMessages="False" SpecialKey="False">
                    <ui:SendHotkey.Target>
                      <ui:Target ClippingRegion="{x:Null}" Element="{x:Null}" TimeoutMS="{x:Null}" Selector="[Config(&quot;WND_Main&quot;).ToString()]" WaitForReady="COMPLETE" />
                    </ui:SendHotkey.Target>
                  </ui:SendHotkey>
                  <ui:InvokeWorkflowFile ContinueOnError="{x:Null}" sap2010:Annotation.AnnotationText="Invoke CheckMessage workflow and check the execution result." DisplayName="Invoke Workflow File [CheckMessage]" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_137" UnSafe="False" WorkflowFileName="SRC_DEFINE_JOB_E\CheckMessage.xaml">
                    <ui:InvokeWorkflowFile.Arguments>
                      <InArgument x:TypeArguments="scg:Dictionary(x:String, x:Object)" x:Key="in_Config">[Config]</InArgument>
                      <InArgument x:TypeArguments="x:Boolean" x:Key="in_IsSaveStep">True</InArgument>
                    </ui:InvokeWorkflowFile.Arguments>
                  </ui:InvokeWorkflowFile>
                  <ui:GetValue ContinueOnError="{x:Null}" DisplayName="Get Text StatusBar" sap2010:WorkflowViewState.IdRef="GetValue_10">
                    <ui:GetValue.Target>
                      <ui:Target ClippingRegion="{x:Null}" Element="{x:Null}" TimeoutMS="{x:Null}" Selector="[Config(&quot;WND_MainStatusBar&quot;).ToString()]" WaitForReady="COMPLETE" />
                    </ui:GetValue.Target>
                    <ui:GetValue.Value>
                      <OutArgument x:TypeArguments="x:String">[StatusMessage]</OutArgument>
                    </ui:GetValue.Value>
                  </ui:GetValue>
                  <ui:InvokeWorkflowFile ContinueOnError="{x:Null}" DisplayName="Invoke workflow file [SRC_WriteLogToText]" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_130" UnSafe="False" WorkflowFileName="SRC_Common\SRC_WriteLogToText.xaml">
                    <ui:InvokeWorkflowFile.Arguments>
                      <InArgument x:TypeArguments="x:String" x:Key="in_LogFilePath">[Config("LogFolderPath").ToString]</InArgument>
                      <InArgument x:TypeArguments="x:String" x:Key="in_LogFileName">[LogFileName]</InArgument>
                      <InArgument x:TypeArguments="s:String[]" x:Key="in_LogData">[{Datetime.Now.ToString("yyyy-MM-dd HH:mm:ss"), WorkflowName, "S", HeaderIndex, StatusMessage, "", ""}]</InArgument>
                    </ui:InvokeWorkflowFile.Arguments>
                  </ui:InvokeWorkflowFile>
                </Sequence>
              </Sequence>
            </TryCatch.Try>
            <TryCatch.Catches>
              <Catch x:TypeArguments="s:Exception" sap2010:WorkflowViewState.IdRef="Catch`1_3">
                <ActivityAction x:TypeArguments="s:Exception">
                  <ActivityAction.Argument>
                    <DelegateInArgument x:TypeArguments="s:Exception" Name="exception" />
                  </ActivityAction.Argument>
                  <Sequence DisplayName="Exception Process" sap2010:WorkflowViewState.IdRef="Sequence_826">
                    <Sequence.Variables>
                      <Variable x:TypeArguments="x:String" Name="ScreenShotPath" />
                    </Sequence.Variables>
                    <ui:InvokeWorkflowFile ContinueOnError="{x:Null}" DisplayName="Invoke workflow file [SRC_TakeScreenShot]" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_142" UnSafe="False" WorkflowFileName="SRC_Common\SRC_TakeScreenShot.xaml">
                      <ui:InvokeWorkflowFile.Arguments>
                        <InArgument x:TypeArguments="x:String" x:Key="in_FileName">["ERR_" + WorkflowName + "_" + DateTime.now.ToString("yyyyMMdd_HHmmss") + ".png"]</InArgument>
                        <InArgument x:TypeArguments="x:String" x:Key="in_OutputPath">[Config("ScreenshotsFolderPath").ToString]</InArgument>
                        <OutArgument x:TypeArguments="x:String" x:Key="out_ScreenShotPath">[ScreenShotPath]</OutArgument>
                      </ui:InvokeWorkflowFile.Arguments>
                    </ui:InvokeWorkflowFile>
