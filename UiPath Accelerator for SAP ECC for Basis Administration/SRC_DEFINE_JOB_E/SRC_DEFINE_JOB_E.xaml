              </Sequence.Variables>
              <ui:ReadRange Range="{x:Null}" AddHeaders="True" DataTable="[dt_ConfigTable]" DisplayName="Read Range ComponentResources" sap2010:WorkflowViewState.IdRef="ReadRange_5" SheetName="[sheet]" WorkbookPath="[Config(&quot;ResourceFilePath&quot;).ToString]" />
              <ui:ForEachRow CurrentIndex="{x:Null}" DataTable="[dt_ConfigTable]" DisplayName="For each row in ComponentResources" sap2010:WorkflowViewState.IdRef="ForEachRow_8">
