        <Assign.Value>
          <InArgument x:TypeArguments="x:String">[Now.ToString("yyyyMMdd_HHmmss") &amp; "_" &amp; Config("LogFileName").ToString]</InArgument>
        </Assign.Value>
      </Assign>
      <ui:BuildDataTable sap2010:Annotation.AnnotationText="5. Build a Data Table with parameters used for SAP GUI control.&#xA;&#xA;-SheetName : Key value for DataTable. Sheet Name must be the same value defined in the InputFile.&#xA;-InputType : Parameter used to define wich input type method will be used for the sheet.&#xA;-NullException : Flag to indicate &quot;Selector Not Found&quot; will throw an exception or not.&#xA;-StartIndex : Index used to indicate the start processing point in the InputDataSheet row.&#xA;-DelayTime : Activity delay time in miliseconds." DataTable="[dt_Controller]" DisplayName="Build Data Table" sap2010:WorkflowViewState.IdRef="BuildDataTable_2" TableInfo="&lt;NewDataSet&gt;&#xD;&#xA;  &lt;xs:schema id=&quot;NewDataSet&quot; xmlns=&quot;&quot; xmlns:xs=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:msdata=&quot;urn:schemas-microsoft-com:xml-msdata&quot;&gt;&#xD;&#xA;    &lt;xs:element name=&quot;NewDataSet&quot; msdata:IsDataSet=&quot;true&quot; msdata:MainDataTable=&quot;TableName&quot; msdata:UseCurrentLocale=&quot;true&quot;&gt;&#xD;&#xA;      &lt;xs:complexType&gt;&#xD;&#xA;        &lt;xs:choice minOccurs=&quot;0&quot; maxOccurs=&quot;unbounded&quot;&gt;&#xD;&#xA;          &lt;xs:element name=&quot;TableName&quot;&gt;&#xD;&#xA;            &lt;xs:complexType&gt;&#xD;&#xA;              &lt;xs:sequence&gt;&#xD;&#xA;                &lt;xs:element name=&quot;SheetName&quot; minOccurs=&quot;0&quot;&gt;&#xD;&#xA;                  &lt;xs:simpleType&gt;&#xD;&#xA;                    &lt;xs:restriction base=&quot;xs:string&quot;&gt;&#xD;&#xA;                      &lt;xs:maxLength value=&quot;100&quot; /&gt;&#xD;&#xA;                    &lt;/xs:restriction&gt;&#xD;&#xA;                  &lt;/xs:simpleType&gt;&#xD;&#xA;                &lt;/xs:element&gt;&#xD;&#xA;                &lt;xs:element name=&quot;ScreenType&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xD;&#xA;                &lt;xs:element name=&quot;NullException&quot; type=&quot;xs:boolean&quot; default=&quot;true&quot; minOccurs=&quot;0&quot; /&gt;&#xD;&#xA;                &lt;xs:element name=&quot;StartIndex&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xD;&#xA;                &lt;xs:element name=&quot;DelayTime&quot; type=&quot;xs:int&quot; default=&quot;300&quot; minOccurs=&quot;0&quot; /&gt;&#xD;&#xA;              &lt;/xs:sequence&gt;&#xD;&#xA;            &lt;/xs:complexType&gt;&#xD;&#xA;          &lt;/xs:element&gt;&#xD;&#xA;        &lt;/xs:choice&gt;&#xD;&#xA;      &lt;/xs:complexType&gt;&#xD;&#xA;    &lt;/xs:element&gt;&#xD;&#xA;  &lt;/xs:schema&gt;&#xD;&#xA;  &lt;TableName&gt;&#xD;&#xA;    &lt;SheetName&gt;StartCondition&lt;/SheetName&gt;&#xD;&#xA;    &lt;ScreenType&gt;1&lt;/ScreenType&gt;&#xD;&#xA;    &lt;NullException&gt;true&lt;/NullException&gt;&#xD;&#xA;    &lt;StartIndex&gt;0&lt;/StartIndex&gt;&#xD;&#xA;    &lt;DelayTime&gt;0&lt;/DelayTime&gt;&#xD;&#xA;  &lt;/TableName&gt;&#xD;&#xA;  &lt;TableName&gt;&#xD;&#xA;    &lt;SheetName&gt;Step&lt;/SheetName&gt;&#xD;&#xA;    &lt;ScreenType&gt;2&lt;/ScreenType&gt;&#xD;&#xA;    &lt;NullException&gt;true&lt;/NullException&gt;&#xD;&#xA;    &lt;StartIndex&gt;0&lt;/StartIndex&gt;&#xD;&#xA;    &lt;DelayTime&gt;0&lt;/DelayTime&gt;&#xD;&#xA;  &lt;/TableName&gt;&#xD;&#xA;&lt;/NewDataSet&gt;" />
      <ui:WindowScope ApplicationWindow="{x:Null}" SearchScope="{x:Null}" Window="{x:Null}" sap2010:Annotation.AnnotationText="6. Check if SAP GUI is running and maximize the screen." DisplayName="Attach Window : Focus on SAP GUI Screen" sap2010:WorkflowViewState.IdRef="WindowScope_2" Selector="[Config(&quot;WND_Main&quot;).ToString]" TimeoutMS="3000">
        <ui:WindowScope.Body>
