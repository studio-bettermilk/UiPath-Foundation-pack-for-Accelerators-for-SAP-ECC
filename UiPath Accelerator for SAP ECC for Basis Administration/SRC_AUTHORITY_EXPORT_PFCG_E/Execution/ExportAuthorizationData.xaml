  <Sequence sap2010:Annotation.AnnotationText="- Overview&#xA;Append Worksheet Details data in the specified Excel file.&#xA;&#xA;- Input/Output&#xA;in_AuthorizationObject as Authorization Object &lt;String&gt;&#xA;in_Authorization as Profile Name &lt;String&gt;&#xA;in_WindowSelector Input window selector &lt;String&gt;&#xA;in_Config as Config Data&lt;Dictionary&lt;String, Object&gt;&gt;&#xA;&#xA;&lt;Worksheet Schema : dt_DetailsData&gt;&#xA;-------------------------------------------------&#xA;Column Index     |   Item Name&#xA;-------------------------------------------------&#xA;0                           |    Role&#xA;1                           |    Authorization Object&#xA;2                           |    Authorization&#xA;3                           |    Field name&#xA;4                           |    From Value&#xA;5                           |    To Value&#xA;6                           |    Maintenance Status for Authorizations&#xA;7                           |    Profile Status&#xA;-------------------------------------------------" DisplayName="ExportAuthorizationData" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Default="ExportAuthorizationData" Name="WorkflowName" />
      <Variable x:TypeArguments="sd:DataTable" Name="dt_DetailsData" />
      <Variable x:TypeArguments="x:String" Name="FilePath" />
    </Sequence.Variables>
    <ui:LogMessage DisplayName="Log message - Start" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Trace" Message="[WorkflowName + &quot;  start&quot;]" />
    <ui:BuildDataTable sap2010:Annotation.AnnotationText="Table Schema template for Details Data" DataTable="[dt_DetailsData]" DisplayName="Build Data Table for Details Data" sap2010:WorkflowViewState.IdRef="BuildDataTable_1" TableInfo="&lt;NewDataSet&gt;&#xA;  &lt;xs:schema id=&quot;NewDataSet&quot; xmlns=&quot;&quot; xmlns:xs=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:msdata=&quot;urn:schemas-microsoft-com:xml-msdata&quot;&gt;&#xA;    &lt;xs:element name=&quot;NewDataSet&quot; msdata:IsDataSet=&quot;true&quot; msdata:MainDataTable=&quot;TableName&quot; msdata:UseCurrentLocale=&quot;true&quot;&gt;&#xA;      &lt;xs:complexType&gt;&#xA;        &lt;xs:choice minOccurs=&quot;0&quot; maxOccurs=&quot;unbounded&quot;&gt;&#xA;          &lt;xs:element name=&quot;TableName&quot;&gt;&#xA;            &lt;xs:complexType&gt;&#xA;              &lt;xs:sequence&gt;&#xA;                &lt;xs:element name=&quot;Role&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xA;                &lt;xs:element name=&quot;Authorization_x0020_Object&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xA;                &lt;xs:element name=&quot;Authorization&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xA;                &lt;xs:element name=&quot;Field_x0020_name&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xA;                &lt;xs:element name=&quot;From_x0020_Value&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xA;                &lt;xs:element name=&quot;To_x0020_Value&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xA;                &lt;xs:element name=&quot;Maintenance_x0020_Status_x0020_for_x0020_Authorizations&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xA;                &lt;xs:element name=&quot;Profile_x0020_Status&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xA;              &lt;/xs:sequence&gt;&#xA;            &lt;/xs:complexType&gt;&#xA;          &lt;/xs:element&gt;&#xA;        &lt;/xs:choice&gt;&#xA;      &lt;/xs:complexType&gt;&#xA;    &lt;/xs:element&gt;&#xA;  &lt;/xs:schema&gt;&#xA;&lt;/NewDataSet&gt;" />
    <If sap2010:Annotation.AnnotationText="Check the type of input window is &quot;Evaluate Trace Data&quot;, otherwise throws an exception." Condition="[in_WindowSelector.Contains(in_Config(&quot;EvaluateTraceDataTitle&quot;).ToString)]" DisplayName="If type of input window" sap2010:WorkflowViewState.IdRef="If_2">
      <If.Then>
        <Sequence DisplayName="Export data from Evaluate Trace Data Grid" sap2010:WorkflowViewState.IdRef="Sequence_2">
          <Sequence.Variables>
            <Variable x:TypeArguments="sd:DataTable" Name="dt_AuthorizationGridValues" />
          </Sequence.Variables>
          <ui:ExtractData NextLinkSelector="{x:Null}" DataTable="[dt_AuthorizationGridValues]" DelayBetweenPagesMS="300" DisplayName="Extract Structured Data from Evaluate Trace Data" ExtractMetadata="&lt;extract-table get_columns_name='1' get_empty_columns='1' /&gt;" sap2010:WorkflowViewState.IdRef="ExtractData_1" MaxNumberOfResults="1000">
            <ui:ExtractData.Target>
              <ui:Target ClippingRegion="{x:Null}" Element="{x:Null}" TimeoutMS="{x:Null}" Selector="[in_WindowSelector &amp; in_Config(&quot;GRD_EvaluateTraceData&quot;).ToString]" WaitForReady="INTERACTIVE" />
            </ui:ExtractData.Target>
          </ui:ExtractData>
          <ui:ForEachRow CurrentIndex="{x:Null}" DataTable="[dt_AuthorizationGridValues]" DisplayName="For Each Row in dt_AuthorizationGridValues" sap2010:WorkflowViewState.IdRef="ForEachRow_1">
            <ui:ForEachRow.Body>
              <ActivityAction x:TypeArguments="sd:DataRow">
                <ActivityAction.Argument>
                  <DelegateInArgument x:TypeArguments="sd:DataRow" Name="row" />
                </ActivityAction.Argument>
                <Sequence DisplayName="Get Authorization Data" sap2010:WorkflowViewState.IdRef="Sequence_4">
                  <Sequence.Variables>
                    <Variable x:TypeArguments="x:String" Name="FieldName" />
                    <Variable x:TypeArguments="x:String" Name="FromValue" />
                    <Variable x:TypeArguments="x:String" Name="ToValue" />
                    <Variable x:TypeArguments="x:String" Name="ProfileStatusText" />
                    <Variable x:TypeArguments="x:String" Name="FieldStatusType" />
                    <Variable x:TypeArguments="x:String" Name="MaintenanceStatus" />
                  </Sequence.Variables>
                  <Assign DisplayName="Assign FieldName" sap2010:WorkflowViewState.IdRef="Assign_7">
                    <Assign.To>
                      <OutArgument x:TypeArguments="x:String">[FieldName]</OutArgument>
                    </Assign.To>
                    <Assign.Value>
                      <InArgument x:TypeArguments="x:String">[row(in_Config("EvaluateTraceData_Field").ToString).ToString]</InArgument>
                    </Assign.Value>
                  </Assign>
                  <Assign DisplayName="Assign FromValue" sap2010:WorkflowViewState.IdRef="Assign_5">
                    <Assign.To>
                      <OutArgument x:TypeArguments="x:String">[FromValue]</OutArgument>
                    </Assign.To>
                    <Assign.Value>
                      <InArgument x:TypeArguments="x:String">[row(in_Config("EvaluateTraceData_From").ToString).ToString]</InArgument>
                    </Assign.Value>
                  </Assign>
                  <Assign DisplayName="Assign ToValue" sap2010:WorkflowViewState.IdRef="Assign_6">
                    <Assign.To>
                      <OutArgument x:TypeArguments="x:String">[ToValue]</OutArgument>
                    </Assign.To>
                    <Assign.Value>
                      <InArgument x:TypeArguments="x:String">[row(in_Config("EvaluateTraceData_To").ToString).ToString]</InArgument>
                    </Assign.Value>
                  </Assign>
                  <Assign DisplayName="Assign FieldStatusType">
                    <Assign.To>
                      <OutArgument x:TypeArguments="x:String">[FieldStatusType]</OutArgument>
                    </Assign.To>
                    <Assign.Value>
                      <InArgument x:TypeArguments="x:String">[row(in_Config("EvaluateTraceData_Display").ToString).ToString]</InArgument>
                    </Assign.Value>
                    <sap2010:WorkflowViewState.IdRef>Assign_15</sap2010:WorkflowViewState.IdRef>
                  </Assign>
                  <If Condition="[FieldStatusType.Contains(in_Config(&quot;OrgLevelStatusType&quot;).ToString)]" DisplayName="If Status is Organizational Level">
                    <If.Then>
                      <Assign DisplayName="Assign MaintenanceStatus (Org Level)">
                        <Assign.To>
                          <OutArgument x:TypeArguments="x:String">[MaintenanceStatus]</OutArgument>
                        </Assign.To>
                        <Assign.Value>
                          <InArgument x:TypeArguments="x:String">[in_Config("OrgLevelStatusType").ToString]</InArgument>
                        </Assign.Value>
                        <sap2010:WorkflowViewState.IdRef>Assign_16</sap2010:WorkflowViewState.IdRef>
                      </Assign>
                    </If.Then>
                    <If.Else>
                      <Assign DisplayName="Assign MaintenanceStatus (Manual)">
                        <Assign.To>
                          <OutArgument x:TypeArguments="x:String">[MaintenanceStatus]</OutArgument>
                        </Assign.To>
                        <Assign.Value>
                          <InArgument x:TypeArguments="x:String">[in_Config("MaintenanceFieldStatus").ToString]</InArgument>
                        </Assign.Value>
                        <sap2010:WorkflowViewState.IdRef>Assign_17</sap2010:WorkflowViewState.IdRef>
                      </Assign>
                    </If.Else>
                    <sap2010:WorkflowViewState.IdRef>If_5</sap2010:WorkflowViewState.IdRef>
                  </If>
                  <Switch x:TypeArguments="x:String" DisplayName="Switch" Expression="[in_Config(&quot;ProfileStatusIcon&quot;).ToString]" sap2010:WorkflowViewState.IdRef="Switch`1_1">
                    <Assign x:Key="S_TL_G" DisplayName="Assign ProfileStatusText (Green)" sap2010:WorkflowViewState.IdRef="Assign_8">
                      <Assign.To>
                        <OutArgument x:TypeArguments="x:String">[ProfileStatusText]</OutArgument>
                      </Assign.To>
                      <Assign.Value>
                        <InArgument x:TypeArguments="x:String">[in_Config("ProfileStatus_Green").ToString]</InArgument>
                      </Assign.Value>
                    </Assign>
                    <Assign x:Key="S_TL_Y" DisplayName="Assign ProfileStatusText (Yellow)" sap2010:WorkflowViewState.IdRef="Assign_11">
                      <Assign.To>
                        <OutArgument x:TypeArguments="x:String">[ProfileStatusText]</OutArgument>
                      </Assign.To>
                      <Assign.Value>
                        <InArgument x:TypeArguments="x:String">[in_Config("ProfileStatus_Yellow").ToString]</InArgument>
                      </Assign.Value>
                    </Assign>
                    <Assign x:Key="S_TL_R" DisplayName="Assign ProfileStatusText (Red)" sap2010:WorkflowViewState.IdRef="Assign_12">
                      <Assign.To>
                        <OutArgument x:TypeArguments="x:String">[ProfileStatusText]</OutArgument>
                      </Assign.To>
                      <Assign.Value>
                        <InArgument x:TypeArguments="x:String">[in_Config("ProfileStatus_Red").ToString]</InArgument>
                      </Assign.Value>
                    </Assign>
                  </Switch>
                  <ui:AddDataRow DataRow="{x:Null}" sap2010:Annotation.AnnotationText="Set Define Values data" ArrayRow="[{in_Config(&quot;RoleName&quot;).ToString, in_AuthorizationObject, in_Authorization, FieldName, FromValue, ToValue, MaintenanceStatus, ProfileStatusText}]" DataTable="[dt_DetailsData]" DisplayName="Add Data Row for Define Values" sap2010:WorkflowViewState.IdRef="AddDataRow_1" />
                </Sequence>
              </ActivityAction>
            </ui:ForEachRow.Body>
          </ui:ForEachRow>
        </Sequence>
      </If.Then>
      <If.Else>
        <Throw sap2010:Annotation.AnnotationText="BusinessRuleException" Exception="[New UiPath.Core.BusinessRuleException(in_Config(&quot;MSG_ExportAuthorizationData_001&quot;).ToString, New Exception)]" sap2010:WorkflowViewState.IdRef="Throw_1" />
      </If.Else>
    </If>
    <Assign sap2010:Annotation.AnnotationText="Get from Config collection the Authorization Data Export File Full Path." DisplayName="Assign FilePath" sap2010:WorkflowViewState.IdRef="Assign_14">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[FilePath]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[in_Config("AuthDataExportFileFullPath").ToString]</InArgument>
      </Assign.Value>
    </Assign>
    <If sap2010:Annotation.AnnotationText="Check if worksheet already exists to append DataTable data, otherwise use write range to create a worksheet adding also the column headers." Condition="[File.Exists(FilePath)]" DisplayName="If file exists" sap2010:WorkflowViewState.IdRef="If_4">
      <If.Then>
        <ui:AppendRange DataTable="[dt_DetailsData]" DisplayName="Append Range" sap2010:WorkflowViewState.IdRef="AppendRange_2" SheetName="Sheet1" WorkbookPath="[FilePath]" />
      </If.Then>
      <If.Else>
        <ui:WriteRange AddHeaders="True" DataTable="[dt_DetailsData]" DisplayName="Write Range" sap2010:WorkflowViewState.IdRef="WriteRange_2" SheetName="Sheet1" StartingCell="A1" WorkbookPath="[FilePath]" />
      </If.Else>
    </If>
    <ui:LogMessage DisplayName="Log message - End" sap2010:WorkflowViewState.IdRef="LogMessage_2" Level="Trace" Message="[WorkflowName + &quot; end&quot;]" />
    <sads:DebugSymbol.Symbol></sads:DebugSymbol.Symbol>
  </Sequence>
