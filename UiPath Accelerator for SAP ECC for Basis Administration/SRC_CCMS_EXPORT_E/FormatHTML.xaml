    <ui:Replace sap2010:Annotation.AnnotationText="Remove multiple white spaces from HTML" DisplayName="Replace (Multiple white spaces)" sap2010:WorkflowViewState.IdRef="Replace_3" Input="[SourceText]" Pattern="\s+" RegexOption="IgnoreCase, Compiled" Replacement=" " Result="[SourceText]" />
    <ui:Replace sap2010:Annotation.AnnotationText="Replace list tree junction symbol." DisplayName="Replace (Replace junction)" sap2010:WorkflowViewState.IdRef="Replace_8" Input="[SourceText]" Pattern="5&amp;nbsp;" RegexOption="IgnoreCase, Compiled" Replacement="+&amp;nbsp;" Result="[SourceText]" />
