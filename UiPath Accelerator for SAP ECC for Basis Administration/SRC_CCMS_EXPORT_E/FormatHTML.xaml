  <Sequence sap2010:Annotation.AnnotationText="- Overview&#xA;Convert the exported Monitor Alerts HTML file in plain text, filtering by errors. &#xA;&#xA;- Input/Output&#xA;in_Config as Config Data&lt;Dictionary&lt;String, Object&gt;&gt;&#xA;in_HeaderNo as Header Number &lt;String&gt;" DisplayName="FormatHTML" sap2010:WorkflowViewState.IdRef="Sequence_1">
