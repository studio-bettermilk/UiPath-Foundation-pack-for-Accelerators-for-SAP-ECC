    </Assign>
    <Assign DisplayName="Assign Workbook (Initialization)" sap2010:WorkflowViewState.IdRef="Assign_6">
      <Assign.To>
        <OutArgument x:TypeArguments="ce:XLWorkbook">[Workbook]</OutArgument>
