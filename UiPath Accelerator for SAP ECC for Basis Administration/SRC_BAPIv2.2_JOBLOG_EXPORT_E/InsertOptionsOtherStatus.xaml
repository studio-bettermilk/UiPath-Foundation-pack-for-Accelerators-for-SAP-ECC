              <Switch x:TypeArguments="x:String" sap2010:Annotation.AnnotationText="Rewrite the each search criteria into query which is sent to RFC_READ_TABLE." DisplayName="Switch : ItemName" Expression="[row.Item(0).ToString]" sap2010:WorkflowViewState.IdRef="Switch`1_2">
                <Assign x:Key="Job Name" DisplayName="Add row.Item(1)" sap2010:WorkflowViewState.IdRef="Assign_7">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:String">[OptionString]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:String">["JOBNAME LIKE " + "'" + row.Item(1).ToString.Replace("*","%") + "'"]</InArgument>
                  </Assign.Value>
                </Assign>
                <Assign x:Key="User Name" DisplayName="Assign - OptionString(SDLUNAME)" sap2010:WorkflowViewState.IdRef="Assign_8">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:String">[OptionString]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
