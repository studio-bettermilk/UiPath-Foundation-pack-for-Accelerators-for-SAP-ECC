                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:String">["SDLSTRTDT GE " + "'" + row.Item(1).ToString + "'"]</InArgument>
                  </Assign.Value>
                </Assign>
                <Assign x:Key="To Date" DisplayName="Assign - OptionString(SDLSTRTDT LE)" sap2010:WorkflowViewState.IdRef="Assign_10">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:String">[OptionString]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:String">["SDLSTRTDT LE " + "'" + row.Item(1).ToString + "'"]</InArgument>
                  </Assign.Value>
                </Assign>
              </Switch>
              <If sap2010:Annotation.AnnotationText="Add the search criteria to DataTable other than job status. " Condition="[StatusType.IndexOf(row.Item(0).ToString) = -1]" DisplayName="If : Other than job status" sap2010:WorkflowViewState.IdRef="If_18">
