                  </Assign.Value>
                </Assign>
                <If x:Key="Sched" Condition="[row.Item(1).ToString.ToUpper = &quot;X&quot;]" DisplayName="Add &quot;P&quot;" sap2010:WorkflowViewState.IdRef="If_10">
                  <If.Then>
