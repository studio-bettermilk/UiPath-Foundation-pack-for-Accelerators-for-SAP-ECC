        <Variable x:TypeArguments="x:Int32" Name="IndexNo" />
      </Sequence.Variables>
      <ui:ForEachRow CurrentIndex="[IndexNo]" DataTable="[in_dt_SearchCriteria]" DisplayName="For Each Row(dt_SearchCriteria)" sap2010:WorkflowViewState.IdRef="ForEachRow_2">
