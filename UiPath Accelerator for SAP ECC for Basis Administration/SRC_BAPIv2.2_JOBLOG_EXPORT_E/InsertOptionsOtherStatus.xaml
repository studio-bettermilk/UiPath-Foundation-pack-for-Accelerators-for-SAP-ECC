  <Sequence sap2010:Annotation.AnnotationText="- Overview&#xA;Add the search criteria to DataTable other than job status. Job status is stored in List.&#xA;&#xA;- Input/Output&#xA;in_dt_SearchCriteria as search criteria aquired from Excel file&lt;DataTable&gt;&#xA;out_dt_Options as search criteria table [OPTIONS] that searches SAP table [TBTCO]&lt;DataTable&gt;&#xA;out_SelectedStatus as Job status &lt;List(Of String)&gt;" DisplayName="InsertOptionsOtherStatus" sap2010:WorkflowViewState.IdRef="Sequence_1">
