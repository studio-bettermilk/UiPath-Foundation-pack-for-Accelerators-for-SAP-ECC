    <ui:ForEachRow sap2010:Annotation.AnnotationText="Search TBTCP and get the join key [LISTIDENT] with TSP01." CurrentIndex="[Position]" DataTable="[in_dt_TbtcpKey]" DisplayName="Get LISTIDENT" sap2010:WorkflowViewState.IdRef="ForEachRow_8">
      <ui:ForEachRow.Body>
        <ActivityAction x:TypeArguments="sd:DataRow">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="sd:DataRow" Name="row" />
          </ActivityAction.Argument>
          <Sequence sap2010:Annotation.AnnotationText="Create search query for TBTCP.&#xA;&#xA;Example)&#xA;(JOBNAME EQ (&quot;EXAMPLE_JOBNAME001&quot;) &#xA;AND JOBCOUNT EQ (&quot;12345&quot;))&#xA;OR (JOBNAME EQ (&quot;EXAMPLE_JOBNAME002&quot;) &#xA;AND JOBCOUNT EQ (&quot;6789&quot;))&#xA;OR (...&#xA;....&#xA;&#xA;※Since OPTIONS has a limit of 72 characters per line, devide 1 condition into 2 records and add to DataTable." DisplayName="Sequence" sap2010:WorkflowViewState.IdRef="Sequence_16">
            <If sap2010:Annotation.AnnotationText="Create search query for TBTCP.&#xA;After the second condition, enter &quot;OR&quot; to the top and add Data Row." Condition="[DatasetForQuery(&quot;TBTCP_OPTIONS&quot;).Rows.Count = 0]" DisplayName="If - Whether in the first row or after the second row(TBTCP_OPTIONS)" sap2010:WorkflowViewState.IdRef="If_21">
              <If.Then>
                <Sequence DisplayName="First row" sap2010:WorkflowViewState.IdRef="Sequence_50">
                  <ui:AddDataRow DataRow="{x:Null}" ArrayRow="[{&quot;(JOBNAME EQ '&quot;+ row.Item(&quot;Job Name&quot;).ToString +&quot;'&quot;}]" DataTable="[DatasetForQuery(&quot;TBTCP_OPTIONS&quot;)]" DisplayName="Add Data Row(JOBNAME) First Line" sap2010:WorkflowViewState.IdRef="AddDataRow_14" />
                  <ui:AddDataRow DataRow="{x:Null}" ArrayRow="[{&quot; AND &quot; + &quot;JOBCOUNT EQ '&quot; + row.Item(&quot;Job No.&quot;).ToString + &quot;')&quot; }]" DataTable="[DatasetForQuery(&quot;TBTCP_OPTIONS&quot;)]" DisplayName="Add Data Row(JOBCOUNT) First Line" sap2010:WorkflowViewState.IdRef="AddDataRow_15" />
                </Sequence>
              </If.Then>
              <If.Else>
                <Sequence DisplayName="2nd row and after" sap2010:WorkflowViewState.IdRef="Sequence_51">
                  <ui:AddDataRow DataRow="{x:Null}" ArrayRow="[{&quot; OR ( JOBNAME EQ '&quot;+ row.Item(&quot;Job Name&quot;).ToString + &quot;'&quot;}]" DataTable="[DatasetForQuery(&quot;TBTCP_OPTIONS&quot;)]" DisplayName="Add Data Row(JOBNAME) 2nd line and after" sap2010:WorkflowViewState.IdRef="AddDataRow_16" />
                  <ui:AddDataRow DataRow="{x:Null}" ArrayRow="[{&quot; AND &quot; + &quot;JOBCOUNT EQ '&quot; + row.Item(&quot;Job No.&quot;).ToString + &quot;')&quot;}]" DataTable="[DatasetForQuery(&quot;TBTCP_OPTIONS&quot;)]" DisplayName="Add Data Row(JOBCOUNT) 2nd line and after" sap2010:WorkflowViewState.IdRef="AddDataRow_17" />
                </Sequence>
              </If.Else>
            </If>
            <If sap2010:Annotation.AnnotationText="Exceptions may occur during a large number of searches, so when performing a TBTCP search, execute the number of criteria set in RFC_READ_TABLE separately up to LimitNumberOfRow." Condition="[Position Mod LimitNumberOfRow = 0 OrElse in_dt_TbtcpKey.Rows.Count - 1 = Position]" DisplayName="If  - Whether it is divisible by LimitNumberOfRow or the end of the array" sap2010:WorkflowViewState.IdRef="If_19">
              <If.Then>
                <Sequence DisplayName="Get TBTCP" sap2010:WorkflowViewState.IdRef="Sequence_35">
                  <ui:InvokeWorkflowFile ContinueOnError="{x:Null}" sap2010:Annotation.AnnotationText="Search TBTCP using RFC_READ_TABLE." DisplayName="Invoke SRC_CallRecReadTable Workflow File (TBTCP)" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_7" UnSafe="False" WorkflowFileName="SRC_Common\SRC_RFC_READ_TABLE_v2.2.xaml">
                    <ui:InvokeWorkflowFile.Arguments>
                      <InArgument x:TypeArguments="usbc:IConnectionService" x:Key="in_SAPService">[in_SAPService]</InArgument>
                      <InArgument x:TypeArguments="x:String" x:Key="in_QueryTableStr">TBTCP</InArgument>
                      <InOutArgument x:TypeArguments="sd:DataTable" x:Key="io_dt_Data">[DatasetForQuery("TBTCP_DATA")]</InOutArgument>
                      <InOutArgument x:TypeArguments="sd:DataTable" x:Key="io_dt_Fields">[DatasetForQuery("TBTCP_FIELDS")]</InOutArgument>
                      <InOutArgument x:TypeArguments="sd:DataTable" x:Key="io_dt_Options">[DatasetForQuery("TBTCP_OPTIONS")]</InOutArgument>
                    </ui:InvokeWorkflowFile.Arguments>
                  </ui:InvokeWorkflowFile>
                  <Sequence sap2010:Annotation.AnnotationText="・Convert search results to List format.&#xA;・Save the number of digits for each field in List format." DisplayName="Convert DataTable (TBTCP) to List" sap2010:WorkflowViewState.IdRef="Sequence_34">
                    <Assign DisplayName="Assign : RetWAList (TBTCP)" sap2010:WorkflowViewState.IdRef="Assign_17">
                      <Assign.To>
                        <OutArgument x:TypeArguments="scg:List(x:String)">[RetWAList]</OutArgument>
                      </Assign.To>
                      <Assign.Value>
                        <InArgument x:TypeArguments="scg:List(x:String)">[DatasetForQuery("TBTCP_DATA").AsEnumerable().Select(Function(r) r("WA").ToString()).ToList()]</InArgument>
                      </Assign.Value>
                    </Assign>
                    <Assign DisplayName="Assign : RetLengList (TBTCP)" sap2010:WorkflowViewState.IdRef="Assign_18">
                      <Assign.To>
                        <OutArgument x:TypeArguments="scg:List(x:String)">[RetLengList]</OutArgument>
                      </Assign.To>
                      <Assign.Value>
                        <InArgument x:TypeArguments="scg:List(x:String)">[DatasetForQuery("TBTCP_FIELDS").AsEnumerable().Select(Function(r) r("LENGTH").ToString()).ToList()]</InArgument>
                      </Assign.Value>
                    </Assign>
                  </Sequence>
                  <InvokeMethod sap2010:Annotation.AnnotationText="Add the result of RFC_READ_TABLE to the end of the list for storage." DisplayName="Invoke Method - AddRange(TmpWAList_TBTCP)" sap2010:WorkflowViewState.IdRef="InvokeMethod_14" MethodName="AddRange">
                    <InvokeMethod.TargetObject>
                      <InArgument x:TypeArguments="scg:List(x:String)">[TmpWAList]</InArgument>
                    </InvokeMethod.TargetObject>
                    <InArgument x:TypeArguments="scg:List(x:String)">[RetWAList]</InArgument>
                  </InvokeMethod>
                  <InvokeMethod sap2010:Annotation.AnnotationText="Clear the processing result variable of RFC_READ_TABLE." DisplayName="Invoke Method - Clear(RetWAList_TBTCP)" sap2010:WorkflowViewState.IdRef="InvokeMethod_15" MethodName="Clear">
                    <InvokeMethod.TargetObject>
                      <InArgument x:TypeArguments="scg:List(x:String)">[RetWAList]</InArgument>
