                  </Sequence.Variables>
                  <ui:SendHotkey DelayBefore="{x:Null}" DelayBetweenKeys="{x:Null}" DelayMS="{x:Null}" Activate="True" sap2010:Annotation.AnnotationText="Save input data." ClickBeforeTyping="False" DisplayName="Send Hotkey Ctrl+S" EmptyField="False" sap2010:WorkflowViewState.IdRef="SendHotkey_66" Key="s" KeyModifiers="Ctrl" SendWindowMessages="False" SpecialKey="False">
