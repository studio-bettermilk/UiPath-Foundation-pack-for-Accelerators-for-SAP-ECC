    <ui:ForEachRow sap2010:Annotation.AnnotationText="[Main Loop]&#xA;Repeat for each row inside InputData." CurrentIndex="[RowCount]" DataTable="[InputDataSheet(SheetNames(0).ToString)]" DisplayName="For Each row in InputDataSheet" sap2010:WorkflowViewState.IdRef="ForEachRow_5">
