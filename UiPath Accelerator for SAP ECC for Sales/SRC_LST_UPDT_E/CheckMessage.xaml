                  <Assign.To>
                    <OutArgument x:TypeArguments="x:Boolean">[IsDoLoop]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:Boolean">False</InArgument>
                  </Assign.Value>
                </Assign>
              </If.Else>
            </If>
          </Switch.Default>
          <Assign x:Key="S" DisplayName="Assign IsDoLoop (Success)" sap2010:WorkflowViewState.IdRef="Assign_35">
            <Assign.To>
              <OutArgument x:TypeArguments="x:Boolean">[IsDoLoop]</OutArgument>
            </Assign.To>
