            <OutArgument x:TypeArguments="x:String" x:Key="out_MessageNumber">[MessageNumber]</OutArgument>
            <OutArgument x:TypeArguments="x:String" x:Key="out_MessageText">[StatusMessage]</OutArgument>
          </ui:InvokeWorkflowFile.Arguments>
        </ui:InvokeWorkflowFile>
        <Switch x:TypeArguments="x:String" sap2010:Annotation.AnnotationText="StatusCode description:  &#xA;  S = Success&#xA;  E = Error&#xA;  W = Warning" DisplayName="Switch (based on StatusCode)" Expression="[StatusCode]" sap2010:WorkflowViewState.IdRef="Switch`1_2">
          <Switch.Default>
