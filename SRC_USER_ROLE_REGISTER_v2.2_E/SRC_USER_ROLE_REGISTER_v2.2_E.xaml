  <Sequence sap2010:Annotation.AnnotationText="- Overview&#xA;Register SAP users and authority using &quot;BAPI_USER_CREATE1 &quot;and &quot;BAPI_USER_ACTGROUPS_ASSIGN. &#xA;&#xA;- Input/Output&#xA;in_SapConnection as SAP Connect Info &lt;IConnectionService&gt; &#xA;in_Import as BAPI input parameters &lt;Dictionary&lt;String,Object&gt;&gt; &#xA;io_DataTable as BAPI in/Out parameter Dictionary data table&lt;String,DataTable&gt;&gt; &#xA;io_Option as DataTable for optional parameter Dictionary&lt;Dictionary&lt;String,DataTable&gt;&gt;&#xA;out_RegistReturn  as  BAPI return message &lt;List&lt;Dictionary&lt;String,Object&gt;&gt;&gt; &#xA;" DisplayName="SRC_USER_ROLE_REGISTER_E" sap:VirtualizedContainerService.HintSize="1025,3127" sap2010:WorkflowViewState.IdRef="Sequence_3">
