  <Sequence sap2010:Annotation.AnnotationText="- Overview&#xA;Input the data on SAP GUI according each sheet data.&#xA;&#xA;- Input/Output&#xA;in_HeaderIndex as Header Data Index &lt;String&gt;&#xA;in_Config as Config Parameters &lt;Dictorionary&lt;String, Object&gt;&gt;&#xA;in_Controller as Parameters used to control SAP GUI screen &lt;DataRow&gt;&#xA;in_SelectorData as Selector Data &lt;DataRow&gt;&#xA;in_InputData as Input Data&lt;DataRow[]&gt;" DisplayName="SetScreenDataFlow" sap2010:WorkflowViewState.IdRef="Sequence_11">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Default="SetScreenDataFlow" Name="WorkflowName" />
      <Variable x:TypeArguments="x:String" Name="InputType" />
      <Variable x:TypeArguments="x:String" Name="ParticularSelector" />
