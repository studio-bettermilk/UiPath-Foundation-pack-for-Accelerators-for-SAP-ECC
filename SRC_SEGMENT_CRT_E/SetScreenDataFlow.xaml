        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:LogMessage DisplayName="Log message - Start" sap2010:WorkflowViewState.IdRef="LogMessage_3" Level="Info" Message="[WorkflowName + &quot;  start&quot;]" />
    <Sequence sap2010:Annotation.AnnotationText="Input Type is the type of input method for each item.&#xA; 1 = Initial screen &#xA; 2 = Screens that allows to enter a value in items with just &quot;SRC Set Values&quot;&#xA; 3 = Input type is other than &quot;1&quot; and &quot;2&quot;.(Since the input fields changes according the entered data, a particular selector information is used to decide Input Type.)" DisplayName="Check which Input Type method must be used" sap2010:WorkflowViewState.IdRef="Sequence_9">
      <Sequence.Variables>
        <Variable x:TypeArguments="ui:UiElement" Name="ElementParticular" />
      </Sequence.Variables>
      <Assign sap2010:Annotation.AnnotationText="Get InputType value from Controller Dictionary." DisplayName="Assign InputType (Initialization)" sap2010:WorkflowViewState.IdRef="Assign_22">
        <Assign.To>
          <OutArgument x:TypeArguments="x:String">[InputType]</OutArgument>
        </Assign.To>
        <Assign.Value>
          <InArgument x:TypeArguments="x:String">[in_Controller("InputType").ToString]</InArgument>
        </Assign.Value>
      </Assign>
      <If Condition="[in_Config.ContainsKey(in_Controller(&quot;SheetName&quot;).ToString)]" DisplayName="If config contains SheetName parameter" sap2010:WorkflowViewState.IdRef="If_8">
        <If.Then>
          <Sequence DisplayName="Get selector" sap2010:WorkflowViewState.IdRef="Sequence_8">
            <ui:Click DelayBefore="{x:Null}" DelayMS="{x:Null}" AlterIfDisabled="True" sap2010:Annotation.AnnotationText="Click process of screen transition before execution" ClickType="CLICK_SINGLE" DisplayName="Click - in_Config the selector" sap2010:WorkflowViewState.IdRef="Click_7" KeyModifiers="None" MouseButton="BTN_LEFT" SendWindowMessages="False" SimulateClick="True">
              <ui:Click.CursorPosition>
                <ui:CursorPosition Position="Center">
                  <ui:CursorPosition.OffsetX>
                    <InArgument x:TypeArguments="x:Int32" />
                  </ui:CursorPosition.OffsetX>
                  <ui:CursorPosition.OffsetY>
                    <InArgument x:TypeArguments="x:Int32" />
                  </ui:CursorPosition.OffsetY>
                </ui:CursorPosition>
              </ui:Click.CursorPosition>
              <ui:Click.Target>
                <ui:Target ClippingRegion="{x:Null}" Element="{x:Null}" Id="61fa44a4-6c66-4ebe-a15f-038a8c464efe" Selector="[in_Config(in_Controller(&quot;SheetName&quot;).ToString).ToString]" WaitForReady="INTERACTIVE">
                  <ui:Target.TimeoutMS>
                    <InArgument x:TypeArguments="x:Int32" />
                  </ui:Target.TimeoutMS>
                </ui:Target>
              </ui:Click.Target>
            </ui:Click>
            <Assign DisplayName="Assign particular selector" sap2010:WorkflowViewState.IdRef="Assign_25">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">[ParticularSelector]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">[in_Config(in_Controller("SheetName").ToString).ToString.Substring(0, in_Config(in_Controller("SheetName").ToString).ToString.LastIndexOf("' /&gt;")) &amp; "/ssubSUB1:SAPMKAL1:*/txtRKAL1-KGALKPOS' /&gt;"]</InArgument>
              </Assign.Value>
            </Assign>
            <ui:WaitUiElementAppear ContinueOnError="True" DisplayName="Find Element - Particular screen" FoundElement="[ElementParticular]" sap2010:WorkflowViewState.IdRef="WaitUiElementAppear_3" WaitActive="False" WaitVisible="False">
              <ui:WaitUiElementAppear.Target>
                <ui:Target ClippingRegion="{x:Null}" Element="{x:Null}" Id="ec99563e-b051-4f03-9e90-1f46336cc403" Selector="[ParticularSelector]" TimeoutMS="500" WaitForReady="INTERACTIVE" />
              </ui:WaitUiElementAppear.Target>
            </ui:WaitUiElementAppear>
            <If sap2010:Annotation.AnnotationText="Check the ElementParticular returns is not nothing." Condition="[ElementParticular isNot Nothing]" DisplayName="If selector was found" sap2010:WorkflowViewState.IdRef="If_7">
              <If.Then>
