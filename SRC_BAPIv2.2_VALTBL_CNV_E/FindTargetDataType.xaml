  <Sequence sap2010:Annotation.AnnotationText="- Overview (這個工作流程的功能很簡單：掃描一整列資料的所有欄位，找出哪些欄位的「資料型態」是 UNIT（單位型態），並把這些欄位的位置（索引）整理成一份清單回傳。這正是前面看過的 ConvertUnits.xaml 所需要的輸入 —— 它們是上下游關係：FindTargetDataType.xaml 先找出「哪幾欄是單位欄」，ConvertUnits.xaml 再拿這份清單去做真正的單位轉換。)&#xA;   Search data type [UNIT] and return column index&#xA;&#xA;- Arguments&#xA;   in_DataType as row data&lt;DataRow&gt;&#xA;   out_UnitColList as column index&lt;List(Of Int32)&gt;" DisplayName="FindTargetDataType" sap:VirtualizedContainerService.HintSize="973,1835" sap2010:WorkflowViewState.IdRef="Sequence_463">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Default="FindTargetDataType" Name="WorkflowName" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
        <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:Comment sap:VirtualizedContainerService.HintSize="532,284" sap2010:WorkflowViewState.IdRef="Comment_1" Text="假設 in_DataType 這一列的內容依序是：&#xD;&#xA;第0欄: &quot;CHAR&quot;   第1欄: &quot;NUMC&quot;   第2欄: &quot;UNIT&quot;   第3欄: &quot;CHAR&quot;   第4欄: &quot;UNIT&quot;&#xD;&#xA;&#xD;&#xA;跑完這個流程後，out_UnitColList 會得到：{2, 4}&#xD;&#xA;&#xD;&#xA;這份 {2, 4} 之後就會被拿去餵給 ConvertUnits.xaml 的 in_UnitColList 參數，讓那個流程知道「只需要處理第 2 欄跟第 4 欄的單位轉換」。" />
    <ui:Comment sap:VirtualizedContainerService.HintSize="532,303" sap2010:WorkflowViewState.IdRef="Comment_2" Text="整體串接關係&#xD;&#xA;&#xD;&#xA;資料型態定義列 (in_DataType)&#xD;&#xA;      ↓&#xD;&#xA;FindTargetDataType.xaml  ← 掃描找出所有 &quot;UNIT&quot; 型態的欄位位置&#xD;&#xA;      ↓ (out_UnitColList)&#xD;&#xA;ConvertUnits.xaml  ← 針對這些欄位位置，做外部單位→SAP內部單位的轉換&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;您目前選中的 Assign_441（初始化 out_UnitColList） 正是整個流程一開始，先把輸出清單清空、準備開始收集結果的第一步。" />
    <ui:LogMessage DisplayName="Log message - Start" sap:VirtualizedContainerService.HintSize="532,57" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Trace" Message="[WorkflowName + &quot;  start&quot;]">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsExpanded">False</x:Boolean>
          <x:Boolean x:Key="IsPinned">False</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    </ui:LogMessage>
    <Assign DisplayName="Assign(Initialize out_UnitColList)" sap:VirtualizedContainerService.HintSize="532,57" sap2010:WorkflowViewState.IdRef="Assign_441">
      <Assign.To>
        <OutArgument x:TypeArguments="scg:List(x:Int32)">[out_UnitColList]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="scg:List(x:Int32)">[New List(Of Int32)]</InArgument>
      </Assign.Value>
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsExpanded">False</x:Boolean>
          <x:Boolean x:Key="IsPinned">False</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    </Assign>
    <While sap2010:Annotation.AnnotationText=" While 迴圈，逐欄檢查 in_DataType 這一列的每一個欄位&#xD;&#xA;&gt; 用 LoopCount 當作目前檢查到第幾欄的計數器&#xD;&#xA;&gt; 迴圈條件：LoopCount &lt; in_DataType.Table.Columns.Count（還沒檢查完所有欄位就繼續）&#xD;&#xA;&gt; 每一輪迴圈：&#xD;&#xA;1. 檢查目前這一欄的值是否等於 &quot;UNIT&quot;（in_DataType.Item(LoopCount).ToString() = &quot;UNIT&quot;）&#xD;&#xA;  &gt;&gt;如果是 → 用 AddToCollection 把目前的欄位索引 LoopCount 加進 out_UnitColList&#xD;&#xA;  &gt;&gt;如果不是 → 不做任何事，直接跳過&#xD;&#xA;2. LoopCount + 1，繼續檢查下一欄" DisplayName="While Column Loop" sap:VirtualizedContainerService.HintSize="532,868" sap2010:WorkflowViewState.IdRef="While_1">
      <While.Variables>
        <Variable x:TypeArguments="x:Int32" Name="LoopCount" />
      </While.Variables>
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
      <While.Condition>[LoopCount &lt; in_DataType.Table.Columns.Count]</While.Condition>
      <Sequence DisplayName="Search ColumnType(UNIT)" sap:VirtualizedContainerService.HintSize="486,499" sap2010:WorkflowViewState.IdRef="Sequence_462">
        <sap:WorkflowViewStateService.ViewState>
          <scg:Dictionary x:TypeArguments="x:String, x:Object">
            <x:Boolean x:Key="IsExpanded">True</x:Boolean>
          </scg:Dictionary>
        </sap:WorkflowViewStateService.ViewState>
        <If Condition="[in_DataType.Item(LoopCount).ToString() = &quot;UNIT&quot;]" DisplayName="If Is the target UNIT?" sap:VirtualizedContainerService.HintSize="452,273" sap2010:WorkflowViewState.IdRef="If_3">
          <If.Then>
            <AddToCollection x:TypeArguments="x:Int32" Collection="[out_UnitColList]" DisplayName="Add To Collection" sap:VirtualizedContainerService.HintSize="450,22" sap2010:WorkflowViewState.IdRef="AddToCollection`1_1" Item="[LoopCount]" />
          </If.Then>
        </If>
        <Assign DisplayName="Count up(LoopCount)" sap:VirtualizedContainerService.HintSize="452,166" sap2010:WorkflowViewState.IdRef="Assign_440">
          <Assign.To>
            <OutArgument x:TypeArguments="x:Int32">[LoopCount]</OutArgument>
          </Assign.To>
          <Assign.Value>
            <InArgument x:TypeArguments="x:Int32">[LoopCount + 1]</InArgument>
          </Assign.Value>
        </Assign>
      </Sequence>
    </While>
    <ui:LogMessage DisplayName="Log message - End" sap:VirtualizedContainerService.HintSize="532,166" sap2010:WorkflowViewState.IdRef="LogMessage_2" Level="Trace" Message="[WorkflowName + &quot;  end&quot;]" />
  </Sequence>
</Activity>