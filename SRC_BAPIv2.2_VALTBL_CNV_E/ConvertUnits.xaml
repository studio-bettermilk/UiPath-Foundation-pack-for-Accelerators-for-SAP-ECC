  <Sequence sap2010:Annotation.AnnotationText="- Overview (把資料列（一筆記錄）裡「單位」相關的欄位，從外部單位代碼轉換成 SAP 內部單位代碼（例如把 Excel 或外部系統輸入的單位縮寫，轉換成 SAP MSEHI 標準內部單位格式），確保後續要送進 SAP BAPI 的資料格式是正確的。)&#xA;   Perform unit conversion for columns of data type [UNIT] in the sheet.&#xA;&#xA;- Arguments&#xA;   in_UnitColList as Column index where data type [UNIT] is inserted.&lt;List(Of Int32)&gt;&#xA;   in_dt_UnitOfMeas as Internal unit of measure list data&lt;DataTable&gt;&#xA;   io_TargetData as  Line data&lt;DataRow&gt;" DisplayName="ConvertUnits" sap:VirtualizedContainerService.HintSize="1351,2608" sap2010:WorkflowViewState.IdRef="Sequence_464">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Default="ConvertUnits" Name="WorkflowName" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
        <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:Comment sap:VirtualizedContainerService.HintSize="514,245" sap2010:WorkflowViewState.IdRef="Comment_1" Text="舉例說明&#xD;&#xA;假設 in_UnitColList = {5, 8}（表示第 5 欄跟第 8 欄是單位欄位），資料列的第 5 欄原本是 &quot;KG&quot;（外部單位）：&#xD;&#xA;1. 檢查第 5 欄不是空白 → 進入轉換&#xD;&#xA;2. 拿 &quot;KG&quot; 去 in_dt_UnitOfMeas 表裡對照 MSEH3 欄位&#xD;&#xA;3. 找到對應列，取出 MSEHI 欄位值，例如 SAP 內部代碼是 &quot;KGM&quot;&#xD;&#xA;4. 因為查到有值 → 把第 5 欄的值改成 &quot;KGM&quot;&#xD;&#xA;5. 接著處理第 8 欄，重複同樣邏輯" />
    <ui:Comment sap:VirtualizedContainerService.HintSize="514,225" sap2010:WorkflowViewState.IdRef="Comment_2" Text="這是 SAP BAPI 整合裡很常見的一個「單位代碼轉換器」：因為 SAP 系統內部使用自己的一套單位代碼（MSEHI），跟外部（Excel 輸入、其他系統）常用的單位縮寫（MSEH3，例如常見的 KG、PC、M 等）不一定一致，所以在把資料送進 SAP BAPI 之前，必須先透過這個對照轉換，避免因為單位代碼不符而導致 BAPI 執行失敗。" />
    <ui:LogMessage DisplayName="Log message - Start" sap:VirtualizedContainerService.HintSize="514,57" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Trace" Message="[WorkflowName + &quot;  start&quot;]">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsExpanded">False</x:Boolean>
          <x:Boolean x:Key="IsPinned">False</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    </ui:LogMessage>
    <ui:ForEach x:TypeArguments="x:Int32" CurrentIndex="{x:Null}" sap2010:Annotation.AnnotationText=" 用 ForEach 迴圈，遍歷 in_UnitColList 裡每一個「單位欄位」的索引（UnitCol）&#xD;&#xA;&gt; 也就是說，一列資料裡如果有多個單位欄位（例如「重量單位」、「數量單位」…），每一個都會被檢查跟轉換一次" DisplayName="For Each Convert UNIT" sap:VirtualizedContainerService.HintSize="514,1933" sap2010:WorkflowViewState.IdRef="ForEach`1_25" Values="[in_UnitColList]">
      <ui:ForEach.Body>
        <ActivityAction x:TypeArguments="x:Int32">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="x:Int32" Name="UnitCol" />
          </ActivityAction.Argument>
          <If sap2010:Annotation.AnnotationText="針對每個單位欄位，先檢查該欄的值是不是空白&#xD;&#xA;&gt; 條件：io_TargetData.Item(UnitCol) 不是空白/空字串&#xD;&#xA;&gt; 只有欄位有值才需要轉換，空白的就跳過不處理&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;如果有值，進行轉換：&#xD;&#xA;1. 先把暫存變數 ConvertedValue 初始化成空字串&#xD;&#xA;2. 用 LookupDataTable，拿目前欄位的值（外部單位代碼），去 in_dt_UnitOfMeas 對照表裡的 MSEH3（外部單位欄位）去查&#xD;&#xA;&gt; 查到符合的那一列後，取出該列的 MSEHI（SAP 內部單位代碼）欄位值，存到 ConvertedValue&#xD;&#xA;3. 再檢查一次：如果查找結果 ConvertedValue 不是空白（表示對照表裡真的有找到對應的單位）&#xD;&#xA;&gt; 就把 io_TargetData.Item(UnitCol) 這一欄的值，直接覆寫成轉換後的 ConvertedValue&#xD;&#xA;&gt; ⚠️ 如果對照表查不到（ConvertedValue 是空的），就維持原值不變，不會硬轉換" Condition="[Not String.IsNullOrWhiteSpace(io_TargetData.Item(UnitCol).ToString())]" DisplayName="If - If the column Value was not empty" sap:VirtualizedContainerService.HintSize="488,1671" sap2010:WorkflowViewState.IdRef="If_4">
            <sap:WorkflowViewStateService.ViewState>
              <scg:Dictionary x:TypeArguments="x:String, x:Object">
                <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
              </scg:Dictionary>
            </sap:WorkflowViewStateService.ViewState>
            <If.Then>
              <Sequence DisplayName="Convert Value" sap:VirtualizedContainerService.HintSize="486,1184" sap2010:WorkflowViewState.IdRef="Sequence_463">
                <Sequence.Variables>
                  <Variable x:TypeArguments="ui:GenericValue" Name="ConvertedValue" />
                </Sequence.Variables>
                <sap:WorkflowViewStateService.ViewState>
                  <scg:Dictionary x:TypeArguments="x:String, x:Object">
                    <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                  </scg:Dictionary>
                </sap:WorkflowViewStateService.ViewState>
                <Assign sap2010:Annotation.AnnotationText="先把暫存變數 ConvertedValue 初始化成空字串" DisplayName="Assign - Initialize(ConvertedValue)" sap:VirtualizedContainerService.HintSize="452,206" sap2010:WorkflowViewState.IdRef="Assign_446">
                  <Assign.To>
                    <OutArgument x:TypeArguments="ui:GenericValue">[ConvertedValue]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="ui:GenericValue">[""]</InArgument>
                  </Assign.Value>
                  <sap:WorkflowViewStateService.ViewState>
                    <scg:Dictionary x:TypeArguments="x:String, x:Object">
                      <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
                    </scg:Dictionary>
                  </sap:WorkflowViewStateService.ViewState>
                </Assign>
                <ui:LookupDataTable LookupColumnIndex="{x:Null}" LookupDataColumn="{x:Null}" RowIndex="{x:Null}" TargetColumnIndex="{x:Null}" TargetDataColumn="{x:Null}" sap2010:Annotation.AnnotationText="用 LookupDataTable，拿目前欄位的值（外部單位代碼），去 in_dt_UnitOfMeas 對照表裡的 MSEH3（外部單位欄位）去查&#xD;&#xA;&gt; 查到符合的那一列後，取出該列的 MSEHI（SAP 內部單位代碼）欄位值，存到 ConvertedValue" DataTable="[in_dt_UnitOfMeas]" DisplayName="Lookup Data Table" sap:VirtualizedContainerService.HintSize="452,423" sap2010:WorkflowViewState.IdRef="LookupDataTable_2" LookupColumnName="MSEH3" LookupValue="[io_TargetData.Item(UnitCol).ToString()]" TargetColumnName="MSEHI">
                  <ui:LookupDataTable.CellValue>
                    <OutArgument x:TypeArguments="ui:GenericValue">[ConvertedValue]</OutArgument>
                  </ui:LookupDataTable.CellValue>
                  <sap:WorkflowViewStateService.ViewState>
                    <scg:Dictionary x:TypeArguments="x:String, x:Object">
                      <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
                    </scg:Dictionary>
                  </sap:WorkflowViewStateService.ViewState>
                </ui:LookupDataTable>
                <If sap2010:Annotation.AnnotationText="再檢查一次：如果查找結果 ConvertedValue 不是空白（表示對照表裡真的有找到對應的單位）&#xD;&#xA;&gt; 就把 io_TargetData.Item(UnitCol) 這一欄的值，直接覆寫成轉換後的 ConvertedValue&#xD;&#xA;&gt; ⚠️ 如果對照表查不到（ConvertedValue 是空的），就維持原值不變，不會硬轉換" Condition="[Not String.IsNullOrWhiteSpace(ConvertedValue)]" DisplayName="If - If the LookupValue was not empty" sap:VirtualizedContainerService.HintSize="452,495" sap2010:WorkflowViewState.IdRef="If_5">
                  <sap:WorkflowViewStateService.ViewState>
                    <scg:Dictionary x:TypeArguments="x:String, x:Object">
                      <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
                    </scg:Dictionary>
                  </sap:WorkflowViewStateService.ViewState>
                  <If.Then>
                    <Assign DisplayName="Assign - Replace(row.Item(UnitCol)" sap:VirtualizedContainerService.HintSize="450,143" sap2010:WorkflowViewState.IdRef="Assign_444">
                      <Assign.To>
                        <OutArgument x:TypeArguments="x:Object">[io_TargetData.Item(UnitCol)]</OutArgument>
                      </Assign.To>
                      <Assign.Value>
                        <InArgument x:TypeArguments="x:Object">[ConvertedValue]</InArgument>
                      </Assign.Value>
                    </Assign>
                  </If.Then>
                </If>
              </Sequence>
            </If.Then>
          </If>
        </ActivityAction>
      </ui:ForEach.Body>
