    <Assign sap2010:Annotation.AnnotationText="初始化 out_ConversionTarget 為一個空字典" DisplayName="Assign - Initialize(InputDataDic)" sap:VirtualizedContainerService.HintSize="520,206" sap2010:WorkflowViewState.IdRef="Assign_437">
