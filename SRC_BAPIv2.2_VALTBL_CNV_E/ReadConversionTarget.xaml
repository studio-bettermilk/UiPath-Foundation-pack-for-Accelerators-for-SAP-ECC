            <ui:ForEach x:TypeArguments="x:String" CurrentIndex="{x:Null}" sap2010:Annotation.AnnotationText="3. 用 ForEach 迴圈，逐一讀取剩下每一張工作表（sheet）：&#xD;&#xA;&gt; 用 ExcelReadRange 把該工作表從 A1 開始的資料整個讀出來（AddHeaders=&quot;True&quot;，會把第一列當作欄位標題），存到 dt_SheetData&#xD;&#xA;&gt; 把 dt_SheetData 存進 out_ConversionTarget(sheet)，也就是用工作表名稱當 Key，資料表當 Value，塞進輸出字典裡" DisplayName="For Each Read Loop " sap:VirtualizedContainerService.HintSize="452,534" sap2010:WorkflowViewState.IdRef="ForEach`1_23" Values="[AllSheetName]">
              <ui:ForEach.Body>
                <ActivityAction x:TypeArguments="x:String">
                  <ActivityAction.Argument>
                    <DelegateInArgument x:TypeArguments="x:String" Name="sheet" />
                  </ActivityAction.Argument>
                  <Sequence DisplayName="Body" sap:VirtualizedContainerService.HintSize="450,318" sap2010:WorkflowViewState.IdRef="Sequence_455">
                    <Sequence.Variables>
                      <Variable x:TypeArguments="sd:DataTable" Name="dt_SheetData" />
                    </Sequence.Variables>
                    <sap:WorkflowViewStateService.ViewState>
