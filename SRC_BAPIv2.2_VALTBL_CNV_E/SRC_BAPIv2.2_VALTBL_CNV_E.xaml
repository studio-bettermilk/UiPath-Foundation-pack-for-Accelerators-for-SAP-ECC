    <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" sap2010:Annotation.AnnotationText="呼叫 GetUnitsOfMeasurement.xaml（您之前也問過這支！）&#xA;&gt; 用 in_SAPService 連線、依 in_LanguageKey 語言代碼，從SAP的 T006(單位主表) + T006A(單位語系文字表) 撈資料，做Left Join&#xA;&gt; 產出 dt_UnitOfMeas（內部單位MSEHI ↔ 外部單位MSEH3的對照表）" DisplayName="Invoke GetUnitsOfMeasurement workflow" sap:VirtualizedContainerService.HintSize="450,303" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_4" UnSafe="False" WorkflowFileName="SRC_BAPIv2.2_VALTBL_CNV_E\GetUnitsOfMeasurement.xaml">
