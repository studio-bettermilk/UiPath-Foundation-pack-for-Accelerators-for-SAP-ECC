    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
        <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:Comment sap:VirtualizedContainerService.HintSize="450,362" sap2010:WorkflowViewState.IdRef="Comment_1" Text="這個流程可以理解為「單位對照表產生器」：&#xD;&#xA;&#xD;&#xA;GetT006.xaml  ──→ dt_T006  (SAP 內部單位代碼主表)&#xD;&#xA;                     ↘&#xD;&#xA;                      Left Join (依 MSEHI 關聯) ──→ out_dt_UnitOfMeas&#xD;&#xA;                     ↗                                (MSEHI + MSEH3)&#xD;&#xA;GetT006A.xaml ──→ dt_T006A (依語系顯示的單位縮寫文字表)&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;最終產出的 out_dt_UnitOfMeas，就是提供給 ConvertUnits.xaml 用來「查表轉換」的核心對照資料 —— 讓外部輸入的單位縮寫（MSEH3，例如 KG）可以正確轉換成 SAP 系統認得的內部單位代碼（MSEHI，例如 KGM）。" />
    <ui:Comment sap:VirtualizedContainerService.HintSize="450,323" sap2010:WorkflowViewState.IdRef="Comment_2" Text="整體串接關係（完整補上這一塊後）&#xD;&#xA;&#xD;&#xA;GetUnitsOfMeasurement.xaml  ← 從 SAP 抓單位對照表 (T006 + T006A Join)&#xD;&#xA;      ↓ (out_dt_UnitOfMeas)&#xD;&#xA;ReadConversionTarget.xaml   ← 讀取 Excel 各工作表資料&#xD;&#xA;      ↓ (out_ConversionTarget)&#xD;&#xA;DataConversion.xaml         ← 逐表逐列處理&#xD;&#xA;      ├─ FindTargetDataType.xaml  ← 找 UNIT 欄位&#xD;&#xA;      └─ ConvertUnits.xaml        ← 用對照表做轉換&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;至此，SRC_BAPIv2.2_VALTBL_CNV_E 這個單位轉換模組的所有核心流程都串接清楚了！" />
    <ui:LogMessage DisplayName="Log message - Start" sap:VirtualizedContainerService.HintSize="450,175" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Trace" Message="[WorkflowName + &quot;  start&quot;]" />
    <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" sap2010:Annotation.AnnotationText="呼叫子流程 GetT006.xaml&#xD;&#xA;&gt; 用 RFC_READ_TABLE 去查 SAP 標準表 T006（度量單位主表），結果存到 dt_T006&#xD;&#xA;&gt; T006 是 SAP 存放所有「單位代碼」的主表（例如 MSEHI 內部代碼）" DisplayName="Invoke GetT006 workflow" sap:VirtualizedContainerService.HintSize="450,271" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_2" UnSafe="False" WorkflowFileName="SRC_BAPIv2.2_VALTBL_CNV_E\GetT006.xaml">
