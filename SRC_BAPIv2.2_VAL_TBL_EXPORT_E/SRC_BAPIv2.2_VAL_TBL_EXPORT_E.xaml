    </ui:InvokeWorkflowFile>
    <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" sap2010:Annotation.AnnotationText=" 呼叫 GetUnitsOfMeasurement.xaml（這支流程您之前已經問過！）&#xA;&gt; 同樣傳入 in_SAPService、in_FilePath、in_LanguageKey&#xA;&gt; 這支子流程內部會：&#xA;&gt;&gt; 呼叫 GetT006.xaml 撈SAP單位主表(T006)&#xA;&gt;&gt; 呼叫 GetT006A.xaml 撈對應語系的單位文字表(T006A，依in_LanguageKey篩選語言)&#xA;&gt;&gt; 用 Left Join 把兩者合併，產出「內部單位(MSEHI) ↔ 外部單位(MSEH3)」的對照表&#xA;&gt;&gt; 最後把結果寫入 in_FilePath 指定的Excel檔案" DisplayName="Invoke GetUnitsOfMeasurement workflow" sap:VirtualizedContainerService.HintSize="450,369" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_4" UnSafe="False" WorkflowFileName="SRC_BAPIv2.2_VAL_TBL_EXPORT_E\GetUnitsOfMeasurement.xaml">
