    </ui:LogMessage>
    <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" sap2010:Annotation.AnnotationText=" 呼叫 CheckArgument.xaml&#xA;&gt;把 in_SAPService、in_FilePath、in_LanguageKey 全部傳入&#xA;&gt;目的是先驗證這三個參數是否正確、完整（例如連線是否有效、檔案路徑是否存在、語言代碼是否合法），確保後面正式撈資料前不會因參數缺漏而失敗" DisplayName="Invoke CheckArgument workflow" sap:VirtualizedContainerService.HintSize="450,287" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_5" UnSafe="False" WorkflowFileName="SRC_BAPIv2.2_VAL_TBL_EXPORT_E\CheckArgument.xaml">
