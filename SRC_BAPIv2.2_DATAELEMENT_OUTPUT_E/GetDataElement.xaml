    <ui:Comment DisplayName="Private: Comment" sap:VirtualizedContainerService.HintSize="450,147" sap2010:WorkflowViewState.IdRef="Comment_2" Text="dt_Options：用來裝「查詢條件」的容器，欄位是 TEXT（純文字條件式，最長 72 字元，因為 SAP RFC_READ_TABLE 的 OPTIONS 參數本身就是這樣設計的）" />
    <Assign sap2010:Annotation.AnnotationText="Get SAP Table Element Info from DD03VT.&#xD;&#xA;&#xD;&#xA;設定要查詢的來源表：QueryTable = &quot;DD03VT&quot;&#xD;&#xA;&#xD;&#xA;這是 SAP 標準的「資料字典欄位文字說明表」，専門用來查某個資料表底下每個欄位的定義資訊" DisplayName="Assign QueryTable" sap:VirtualizedContainerService.HintSize="450,285" sap2010:WorkflowViewState.IdRef="Assign_1">
