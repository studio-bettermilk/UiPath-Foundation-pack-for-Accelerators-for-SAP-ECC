    <ui:BuildDataTable sap2010:Annotation.AnnotationText="Build a Data Table with parameters used for save the table element information.&#xA;(Function modle : RFC_READ_TABLE  have &quot;FIELDS&quot; in &quot;Tables&quot;.&#xA;&quot;FIELDS&quot;  have table element information.)&#xA;&#xA;-FIELDNAME as name of Element&#xA;-OFFSET as offset of Element&#xA;-LENGTH as length of Element&#xA;-TYPE as ABAP data type (C,D,N,...)&#xA;-FIELDTEXT as explanation of repository object&#xA;&#xA;Preset following items as FIELDNAME of DataTable to get Info from DD03VT.&#xA;&#xA;FIELDNAME as name of Element&#xA;POSITION as position in the target Table&#xA;DATATYPE as type of ABAP dictionary&#xA;KEYFLAG as key flag of the target Table&#xA;LENG as length (String) of Element&#xA;DDTEXT as explanation of repository object" DataTable="[dt_Fields]" DisplayName="Build Data Table dt_Fields" sap:VirtualizedContainerService.HintSize="450,447" sap2010:WorkflowViewState.IdRef="BuildDataTable_1" TableInfo="&lt;NewDataSet&gt;&#xA;  &lt;xs:schema id=&quot;NewDataSet&quot; xmlns=&quot;&quot; xmlns:xs=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:msdata=&quot;urn:schemas-microsoft-com:xml-msdata&quot;&gt;&#xA;    &lt;xs:element name=&quot;NewDataSet&quot; msdata:IsDataSet=&quot;true&quot; msdata:MainDataTable=&quot;TableName&quot; msdata:UseCurrentLocale=&quot;true&quot;&gt;&#xA;      &lt;xs:complexType&gt;&#xA;        &lt;xs:choice minOccurs=&quot;0&quot; maxOccurs=&quot;unbounded&quot;&gt;&#xA;          &lt;xs:element name=&quot;TableName&quot;&gt;&#xA;            &lt;xs:complexType&gt;&#xA;              &lt;xs:sequence&gt;&#xA;                &lt;xs:element name=&quot;FIELDNAME&quot; minOccurs=&quot;0&quot;&gt;&#xA;                  &lt;xs:simpleType&gt;&#xA;                    &lt;xs:restriction base=&quot;xs:string&quot;&gt;&#xA;                      &lt;xs:maxLength value=&quot;100&quot; /&gt;&#xA;                    &lt;/xs:restriction&gt;&#xA;                  &lt;/xs:simpleType&gt;&#xA;                &lt;/xs:element&gt;&#xA;                &lt;xs:element name=&quot;OFFSET&quot; minOccurs=&quot;0&quot;&gt;&#xA;                  &lt;xs:simpleType&gt;&#xA;                    &lt;xs:restriction base=&quot;xs:string&quot;&gt;&#xA;                      &lt;xs:maxLength value=&quot;100&quot; /&gt;&#xA;                    &lt;/xs:restriction&gt;&#xA;                  &lt;/xs:simpleType&gt;&#xA;                &lt;/xs:element&gt;&#xA;                &lt;xs:element name=&quot;LENGTH&quot; minOccurs=&quot;0&quot;&gt;&#xA;                  &lt;xs:simpleType&gt;&#xA;                    &lt;xs:restriction base=&quot;xs:string&quot;&gt;&#xA;                      &lt;xs:maxLength value=&quot;100&quot; /&gt;&#xA;                    &lt;/xs:restriction&gt;&#xA;                  &lt;/xs:simpleType&gt;&#xA;                &lt;/xs:element&gt;&#xA;                &lt;xs:element name=&quot;TYPE&quot; minOccurs=&quot;0&quot;&gt;&#xA;                  &lt;xs:simpleType&gt;&#xA;                    &lt;xs:restriction base=&quot;xs:string&quot;&gt;&#xA;                      &lt;xs:maxLength value=&quot;100&quot; /&gt;&#xA;                    &lt;/xs:restriction&gt;&#xA;                  &lt;/xs:simpleType&gt;&#xA;                &lt;/xs:element&gt;&#xA;                &lt;xs:element name=&quot;FIELDTEXT&quot; minOccurs=&quot;0&quot;&gt;&#xA;                  &lt;xs:simpleType&gt;&#xA;                    &lt;xs:restriction base=&quot;xs:string&quot;&gt;&#xA;                      &lt;xs:maxLength value=&quot;100&quot; /&gt;&#xA;                    &lt;/xs:restriction&gt;&#xA;                  &lt;/xs:simpleType&gt;&#xA;                &lt;/xs:element&gt;&#xA;              &lt;/xs:sequence&gt;&#xA;            &lt;/xs:complexType&gt;&#xA;          &lt;/xs:element&gt;&#xA;        &lt;/xs:choice&gt;&#xA;      &lt;/xs:complexType&gt;&#xA;    &lt;/xs:element&gt;&#xA;  &lt;/xs:schema&gt;&#xA;  &lt;TableName&gt;&#xA;    &lt;FIELDNAME&gt;FIELDNAME&lt;/FIELDNAME&gt;&#xA;    &lt;OFFSET&gt;000000&lt;/OFFSET&gt;&#xA;    &lt;LENGTH&gt;000000&lt;/LENGTH&gt;&#xA;  &lt;/TableName&gt;&#xA;  &lt;TableName&gt;&#xA;    &lt;FIELDNAME&gt;POSITION&lt;/FIELDNAME&gt;&#xA;    &lt;OFFSET&gt;000000&lt;/OFFSET&gt;&#xA;    &lt;LENGTH&gt;000000&lt;/LENGTH&gt;&#xA;  &lt;/TableName&gt;&#xA;  &lt;TableName&gt;&#xA;    &lt;FIELDNAME&gt;KEYFLAG&lt;/FIELDNAME&gt;&#xA;    &lt;OFFSET&gt;000000&lt;/OFFSET&gt;&#xA;    &lt;LENGTH&gt;000000&lt;/LENGTH&gt;&#xA;  &lt;/TableName&gt;&#xA;  &lt;TableName&gt;&#xA;    &lt;FIELDNAME&gt;DATATYPE&lt;/FIELDNAME&gt;&#xA;    &lt;OFFSET&gt;000000&lt;/OFFSET&gt;&#xA;    &lt;LENGTH&gt;000000&lt;/LENGTH&gt;&#xA;  &lt;/TableName&gt;&#xA;  &lt;TableName&gt;&#xA;    &lt;FIELDNAME&gt;LENG&lt;/FIELDNAME&gt;&#xA;    &lt;OFFSET&gt;000000&lt;/OFFSET&gt;&#xA;    &lt;LENGTH&gt;000000&lt;/LENGTH&gt;&#xA;  &lt;/TableName&gt;&#xA;  &lt;TableName&gt;&#xA;    &lt;FIELDNAME&gt;DDTEXT&lt;/FIELDNAME&gt;&#xA;    &lt;OFFSET&gt;000000&lt;/OFFSET&gt;&#xA;    &lt;LENGTH&gt;000000&lt;/LENGTH&gt;&#xA;  &lt;/TableName&gt;&#xA;&lt;/NewDataSet&gt;">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
