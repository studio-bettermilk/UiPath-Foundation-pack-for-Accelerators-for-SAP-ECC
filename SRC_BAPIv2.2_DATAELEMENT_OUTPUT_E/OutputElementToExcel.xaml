  <Sequence sap2010:Annotation.AnnotationText="- Overview (把前面 GetDataElement.xaml 查到的 SAP 資料表欄位結構資訊，套用到一份預先做好的 Excel 範本裡，輸出成一份格式化好、附帶自動計算公式的成品 Excel 檔（這份檔案的格式，剛好可以直接被 SRC_TABLEDATA_OUTPUT 系列流程拿來讀取使用）。)&#xA;Output Excel file based on DataTable of SAP Table Element Info, of which format can be processed by SRC_TABLEDATA_OUTPUT.&#xA;&#xA;- input&#xA;in_TableName as name of target Table &lt;String&gt;&#xA;in_OutPath as file path of output file &lt;String&gt;&#xA;in_OutFileName as name of output file &lt;String&gt;&#xA;in_OutColumnData as name of output DataTable &lt;DataTable&gt;" DisplayName="OutputElementToExcel" sap:VirtualizedContainerService.HintSize="973,5741" sap2010:WorkflowViewState.IdRef="Sequence_4">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="LengthPosition" />
      <Variable x:TypeArguments="x:String" Name="EquationPosition" />
      <Variable x:TypeArguments="x:String" Name="EquationSheetName" />
      <Variable x:TypeArguments="x:String" Name="MaxLengthSheetName" />
      <Variable x:TypeArguments="x:String" Name="CopyPosition" />
      <Variable x:TypeArguments="x:String" Name="MasterFile" />
      <Variable x:TypeArguments="x:String" Name="MasterSheetName" />
      <Variable x:TypeArguments="sd:DataTable" Name="dt_OutputData" />
      <Variable x:TypeArguments="x:String" Name="OutRowPosition" />
      <Variable x:TypeArguments="x:String" Name="OutDataSheetName" />
      <Variable x:TypeArguments="x:String" Name="TableNamePosition" />
      <Variable x:TypeArguments="x:String" Default="OutputElementToExcel" Name="WorkflowName" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
        <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:Comment sap:VirtualizedContainerService.HintSize="512,421" sap2010:WorkflowViewState.IdRef="Comment_1" Text="這個流程可以理解為「用範本產生 SAP 表結構文件的產生器」：&#xD;&#xA;1. 複製一份範本 Excel（裡面已經內建好格式、標題、公式範本）&#xD;&#xA;2. 把查到的欄位資料寫進新複製出來的工作表（改名成表名稱，例如 SRC_DataElement）&#xD;&#xA;3. 從範本裡「借用」公式（總長度加總、超長警示、其他計算公式）貼到正式資料上&#xD;&#xA;4. 最後把當初拿來「借公式」的那幾張暫時性輔助工作表刪掉，讓成品檔案乾乾淨淨，只留下真正有用的資料工作表&#xD;&#xA;&#xD;&#xA;您目前選中的 ForEach 1_2（For Each Sheet delete） 活動，正是最後這個「清理輔助工作表」步驟的核心——逐一檢查並刪除 MasterSheetName、EquationSheetName、MaxLengthSheetName 這三張暫時性的工作表。" />
    <ui:LogMessage DisplayName="Log message - Start" sap:VirtualizedContainerService.HintSize="512,57" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Trace" Message="[WorkflowName + &quot;  start&quot;]">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsExpanded">False</x:Boolean>
          <x:Boolean x:Key="IsPinned">False</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    </ui:LogMessage>
    <Sequence sap2010:Annotation.AnnotationText="Set sheet name and position in Excel file.&#xD;&#xA;&#xD;&#xA;設定「範本檔」相關資訊&#xD;&#xA;&gt; MasterFile = &quot;SRC_Common\SRC_DATAELEMENT_OUTPUT.xlsx&quot; ← 這就是前面搜尋 SRC_DataElement 工作表時找到的範本檔！&#xD;&#xA;&gt; MasterSheetName = &quot;SRC&quot;（範本裡預先做好、要被複製的那張工作表名稱）&#xD;&#xA;&gt; OutRowPosition = &quot;3&quot;（資料要從第 3 列開始寫，因為前 2 列是標題/表頭）&#xD;&#xA;&gt; EquationPosition = &quot;F&quot; &amp; OutRowPosition（公式要貼到的欄位位置，第 F 欄）&#xD;&#xA;&gt; TableNamePosition = &quot;A1&quot;（表名稱要寫在 A1）&#xD;&#xA;&gt; （還設定了 MaxLengthSheetName、EquationSheetName、CopyPosition、OutDataSheetName 等，這些都是範本裡預先做好的「輔助工作表」名稱，用來提供公式和格式範本）" DisplayName="設定「範本檔」相關資訊 Sequence Set Constant" sap:VirtualizedContainerService.HintSize="512,673" sap2010:WorkflowViewState.IdRef="Sequence_1">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsExpanded">True</x:Boolean>
          <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
      <Assign sap2010:Annotation.AnnotationText="Set Master file name to copy." DisplayName="Assign MasterFile" sap:VirtualizedContainerService.HintSize="450,206" sap2010:WorkflowViewState.IdRef="Assign_8">
        <Assign.To>
          <OutArgument x:TypeArguments="x:String">[MasterFile]</OutArgument>
        </Assign.To>
        <Assign.Value>
          <InArgument x:TypeArguments="x:String">SRC_Common\SRC_DATAELEMENT_OUTPUT.xlsx</InArgument>
        </Assign.Value>
        <sap:WorkflowViewStateService.ViewState>
          <scg:Dictionary x:TypeArguments="x:String, x:Object">
            <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
          </scg:Dictionary>
