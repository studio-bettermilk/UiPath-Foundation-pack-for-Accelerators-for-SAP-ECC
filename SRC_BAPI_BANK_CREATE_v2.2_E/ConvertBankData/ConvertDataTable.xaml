                        </Assign.To>
                        <Assign.Value>
                          <InArgument x:TypeArguments="x:Object">[(Convert.ToInt32(row("InputValue")) * (RowCount+1)).ToString]</InArgument>
                        </Assign.Value>
                      </Assign>
                    </Switch>
                  </ActivityAction>
                </ui:ForEachRow.Body>
