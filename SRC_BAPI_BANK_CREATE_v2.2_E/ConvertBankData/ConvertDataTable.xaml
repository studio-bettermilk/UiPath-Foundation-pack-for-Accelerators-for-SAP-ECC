                        </Assign.To>
                        <Assign.Value>
                          <InArgument x:TypeArguments="x:String">[inputrow(row("InputValue").ToString).ToString.PadLeft(Convert.ToInt32(row("PadLeft").ToString), "0"c)]</InArgument>
                        </Assign.Value>
                      </Assign>
                      <Assign x:Key="FixedValue" DisplayName="Assign Set a fixed value" sap2010:WorkflowViewState.IdRef="Assign_786">
                        <Assign.To>
                          <OutArgument x:TypeArguments="x:Object">[OutputDatas(row("OutputSheetName").ToString).Rows(OutputDatas(row("OutputSheetName").ToString).Rows.Count-1).item(row("OutputColumnName").ToString)]</OutArgument>
                        </Assign.To>
                        <Assign.Value>
