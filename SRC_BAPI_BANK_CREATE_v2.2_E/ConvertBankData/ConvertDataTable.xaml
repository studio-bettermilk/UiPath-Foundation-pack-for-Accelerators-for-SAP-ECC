  <Sequence sap2010:Annotation.AnnotationText="-Overview&#xD;&#xA;Convert the DataTable passed as an argument to a file used in BAPI (Bank Master Registration)&#xD;&#xA;&#xD;&#xA;-Input / Output&#xD;&#xA;in_ConvertFilePath as the conversion table file path &lt;String&gt;&#xD;&#xA;in_CopyFilePath as the file path of the template file used for BAPI (Bank Master Registration) &lt;String&gt;&#xD;&#xA;in_OutputFilePath as the file path of the output destination of the file used in BAPI (Bank Master Registration) &lt;String&gt;&#xD;&#xA;in_dt_BankDataList as a DataTable that contains financial institution data values" DisplayName="ConvertDataTable" sap2010:WorkflowViewState.IdRef="Sequence_429">
