  <Sequence sap2010:Annotation.AnnotationText="- Overview&#xA;Acquire data based on table search conditions and enter search conditions&#xA;&#xA;- Input/Output&#xA;in_Config as Config Data&lt;Dictionary&lt;String, Object&gt;&gt;&#xA;in_Messages as Message File Data&lt;Dictionary&lt;String,String&gt;&gt;&#xA;in_dt_SingleData as Set data table to input &lt;DataTable&gt;&#xA;in_dt_MultipleData  as When multiple conditions and inputs are DataTable &lt;Dictionary(Of String,DataTable)&gt;&#xA;in_SearchTechList as MultipleSearch Technical name&lt;List&lt;String&gt;&gt;" DisplayName="SetCondition" sap2010:WorkflowViewState.IdRef="Sequence_1">
