          </ui:InvokeWorkflowFile.Arguments>
        </ui:InvokeWorkflowFile>
      </If.Else>
    </If>
    <If Condition="[SearchTechErrorList.Count &lt;&gt; 0]" DisplayName="If : Check If Technical name Not Found" sap2010:WorkflowViewState.IdRef="If_2">
      <If.Then>
        <Sequence sap2010:Annotation.AnnotationText="Set Custom Exception and throw" DisplayName="Set Custom Exception Technical name not found" sap2010:WorkflowViewState.IdRef="Sequence_2">
          <Sequence.Variables>
            <Variable x:TypeArguments="ui:BusinessRuleException" Name="CustomException" />
          </Sequence.Variables>
          <Assign DisplayName="Assign Technical name not found" sap2010:WorkflowViewState.IdRef="Assign_1">
            <Assign.To>
              <OutArgument x:TypeArguments="ui:BusinessRuleException">[CustomException]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="ui:BusinessRuleException">[new UiPath.Core.BusinessRuleException()]</InArgument>
            </Assign.Value>
          </Assign>
          <Assign DisplayName="Assign Technical name not found StatusMessage" sap2010:WorkflowViewState.IdRef="Assign_2">
            <Assign.To>
              <OutArgument x:TypeArguments="x:Object">[CustomException.Data("StatusMessage")]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">["Technical name not found " &amp; string.Join(" ", SearchTechErrorList)]</InArgument>
            </Assign.Value>
          </Assign>
          <Throw sap2010:Annotation.AnnotationText="BusinessRuleException" DisplayName="Throw Technical name not found" Exception="[CustomException]" sap2010:WorkflowViewState.IdRef="Throw_2" />
        </Sequence>
      </If.Then>
    </If>
