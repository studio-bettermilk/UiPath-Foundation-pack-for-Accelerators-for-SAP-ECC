  <Sequence sap2010:Annotation.AnnotationText="- Overview&#xA;Check Arguments for SRC_TABLEDATA_OUTPUT.&#xA;In case of error, throw BusinessRuleException.&#xA;&#xA;- input&#xA;in_OutPath as file path of output file &lt;String&gt;&#xA;in_OutFileName as name of output file &lt;String&gt;&#xA;in_AppServer as AppServer &lt;String&gt;&#xA;in_Client as Client &lt;String&gt;&#xA;in_Language as Language &lt;String&gt;&#xA;in_Password as Password &lt;SecureString&gt;&#xA;in_SystemNumber as SystemNumber &lt;String&gt;&#xA;in_User as User &lt;String&gt;&#xA;in_ExcelDataFilePath as Excel file path created by SRC_DATAELEMENT_OUTPUT &lt;String&gt;" DisplayName="CheckArguments" sap2010:WorkflowViewState.IdRef="Sequence_1">
