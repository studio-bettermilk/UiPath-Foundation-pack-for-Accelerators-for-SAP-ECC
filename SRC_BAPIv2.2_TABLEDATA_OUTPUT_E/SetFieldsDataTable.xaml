    <ui:ForEachRow ColumnNames="{x:Null}" CurrentIndex="{x:Null}" sap2010:Annotation.AnnotationText="Set in_dt_InputExcel data to out_dt_Fields.&#xA;RFC_READ_TABLE parameter &quot;FIELDS&quot; creation process.&#xD;&#xA;&#xD;&#xA;用 ForEachRow 逐列走過 in_dt_InputExcel&#xD;&#xA;&gt; 每一列（row）都先檢查：row.Item(&quot;FIELDNAME&quot;) 是不是空白&#xD;&#xA;&gt;&gt; 不是空白 → 才進行後續處理：&#xD;&#xA;1. 用 out_dt_Fields.NewRow 建立一筆新的空白列 TempRow&#xD;&#xA;2. 把 row.Item(&quot;FIELDNAME&quot;) 的值指定給 TempRow.Item(&quot;FIELDNAME&quot;)&#xD;&#xA;3. 用 AddDataRow 把這筆 TempRow 加進 out_dt_Fields&#xD;&#xA;&gt;&gt; 是空白 → 直接跳過，這一列不會被加進輸出表." DataTable="[in_dt_InputExcel]" DisplayName="For Each Row Set out_dt_Fields" sap:VirtualizedContainerService.HintSize="478,1246" sap2010:WorkflowViewState.IdRef="ForEachRow_1">
      <ui:ForEachRow.Body>
        <ActivityAction x:TypeArguments="sd:DataRow">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="sd:DataRow" Name="row" />
          </ActivityAction.Argument>
          <If Condition="[Not String.IsNullOrWhiteSpace(row.Item(&quot;FIELDNAME&quot;).ToString)]" DisplayName="If Set out_dt_Fields" sap:VirtualizedContainerService.HintSize="452,819" sap2010:WorkflowViewState.IdRef="If_1">
            <If.Then>
              <Sequence DisplayName="Sequence Set TempRow" sap:VirtualizedContainerService.HintSize="450,622" sap2010:WorkflowViewState.IdRef="Sequence_2">
                <Sequence.Variables>
                  <Variable x:TypeArguments="sd:DataRow" Name="TempRow" />
                </Sequence.Variables>
                <sap:WorkflowViewStateService.ViewState>
                  <scg:Dictionary x:TypeArguments="x:String, x:Object">
                    <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                  </scg:Dictionary>
                </sap:WorkflowViewStateService.ViewState>
                <Assign DisplayName="Assign Set TempRow" sap:VirtualizedContainerService.HintSize="416,175" sap2010:WorkflowViewState.IdRef="Assign_1">
                  <Assign.To>
                    <OutArgument x:TypeArguments="sd:DataRow">[TempRow]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="sd:DataRow">[out_dt_Fields.NewRow]</InArgument>
                  </Assign.Value>
                </Assign>
                <Assign DisplayName="Assign Set TempRow.Item(&quot;FIELDNAME&quot;)" sap:VirtualizedContainerService.HintSize="416,175" sap2010:WorkflowViewState.IdRef="Assign_2">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:Object">[TempRow.Item("FIELDNAME")]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:Object">[row.Item("FIELDNAME").ToString]</InArgument>
                  </Assign.Value>
                </Assign>
                <ui:AddDataRow ArrayRow="{x:Null}" DataRow="[TempRow]" DataTable="[out_dt_Fields]" DisplayName="Add Data Row - dt_FieldsData" sap:VirtualizedContainerService.HintSize="416,212" sap2010:WorkflowViewState.IdRef="AddDataRow_1" />
              </Sequence>
            </If.Then>
          </If>
        </ActivityAction>
      </ui:ForEachRow.Body>
