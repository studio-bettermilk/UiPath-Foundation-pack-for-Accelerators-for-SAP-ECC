            <Assign.Value>
              <InArgument x:TypeArguments="scg:List(x:String)">[new list(of String)]</InArgument>
            </Assign.Value>
          </Assign>
          <Switch x:TypeArguments="x:String" sap2010:Annotation.AnnotationText="Create condition string by checking the input range values and equation argument.&#xA;Bellow are some examples that explain how condition is made. &#xA; &#xA;&lt;INPUT PATTERN&gt;&#xA;pattern         FIELDNAME                Equation        From                              To&#xA;1,                          A                                                20190801                              &#xA;2,                          A                                                                                     20190830&#xA;3,                          A                                                20190801                     20190830&#xA;4,                          A                                  &lt;&gt;         20190801 &#xA;5.                          A                                    *           (A = 'B' OR A = 'N')&#xA;&#xA;&lt;OUTPUT CONDITION&gt;&#xA;1 ,     A  =  '20190801' &#xA;2 ,     A  &gt;=  '20190830' &#xA;3,      A  &lt;= '20190801' AND A  &gt;=  '20190830' &#xA;4,      A  &lt;&gt; '20190801'&#xA;5.      (A = 'B' OR A = 'N') &#xA;" DisplayName="Switch Create condition string" Expression="[in_Equation]" sap2010:WorkflowViewState.IdRef="Switch`1_1">
