                    <Assign DisplayName="Assign TempValue" sap2010:WorkflowViewState.IdRef="Assign_10">
                      <Assign.To>
                        <OutArgument x:TypeArguments="x:String">[TempValue]</OutArgument>
                      </Assign.To>
                      <Assign.Value>
                        <InArgument x:TypeArguments="x:String">["'" &amp; in_From &amp; "'"]</InArgument>
                      </Assign.Value>
                    </Assign>
                    <If Condition="[in_To = &quot;&quot;]" DisplayName="If  Check if &quot;To&quot; is set (case (empty))" sap2010:WorkflowViewState.IdRef="If_9">
                      <If.Then>
