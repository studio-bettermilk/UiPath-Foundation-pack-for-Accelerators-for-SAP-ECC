  <Sequence sap2010:Annotation.AnnotationText="- Overview (這個工作流程的功能是：從一張參考資料表（in_dt_InputData）裡，取出指定欄位（in_ColumnName）每一列的值，橫向排成一整列，並把這一整列資料插入到目標資料表（io_dt_OutDataTable）的最上方（第一列）。這通常是用來在輸出資料表最上面加一列「說明/標頭資訊」，例如加上每個欄位對應的中文說明、或原始欄位名稱等。)&#xA;Add Info to the header of DataTable.&#xA;Add Info of target Column of reference DataTable defined as Argument to the header of DataTable.&#xA;&#xA;- Input/Output&#xA;in_dt_InputData as reference DataTable  &lt;DataTable&gt;&#xA;in_ColumnName as reference ColumnName &lt;String&gt;&#xA;io_dt_OutDataTable as DataTable to insert a row &lt;DataTable&gt;" DisplayName="AddInformation" sap:VirtualizedContainerService.HintSize="880,2160" sap2010:WorkflowViewState.IdRef="Sequence_9">
    <Sequence.Variables>
      <Variable x:TypeArguments="sd:DataRow" Name="TempRow" />
      <Variable x:TypeArguments="x:String" Default="AddInformation" Name="WorkflowName" />
      <Variable x:TypeArguments="x:Int32" Name="Index" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
        <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:Comment sap2010:Annotation.AnnotationText="舉例說明&#xD;&#xA;假設 in_dt_InputData（參考表）的 FIELDTEXT 欄位，依列順序內容是：&#xD;&#xA;&#xD;&#xA;第0列: &quot;料號&quot;   第1列: &quot;工廠&quot;   第2列: &quot;料號類型&quot;&#xD;&#xA;&#xD;&#xA;且 in_ColumnName = &quot;FIELDTEXT&quot;：&#xD;&#xA;跑完這個流程後，TempRow 會變成：&#xD;&#xA;&#xD;&#xA;第0欄: &quot;料號&quot;   第1欄: &quot;工廠&quot;   第2欄: &quot;料號類型&quot;&#xD;&#xA;&#xD;&#xA;然後這整列會被插入到 io_dt_OutDataTable 的最上面，變成一列「欄位說明標頭」。" sap:VirtualizedContainerService.HintSize="450,449" sap2010:WorkflowViewState.IdRef="Comment_1" Text="舉例說明&#xD;&#xA;假設 in_dt_InputData（參考表）的 FIELDTEXT 欄位，依列順序內容是：&#xD;&#xA;Text&#xD;&#xA;第0列: &quot;料號&quot;   第1列: &quot;工廠&quot;   第2列: &quot;料號類型&quot;&#xD;&#xA;且 in_ColumnName = &quot;FIELDTEXT&quot;：&#xD;&#xA;跑完這個流程後，TempRow 會變成：&#xD;&#xA;Text&#xD;&#xA;第0欄: &quot;料號&quot;   第1欄: &quot;工廠&quot;   第2欄: &quot;料號類型&quot;&#xD;&#xA;然後這整列會被插入到 io_dt_OutDataTable 的最上面，變成一列「欄位說明標頭」。">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    </ui:Comment>
    <ui:Comment sap:VirtualizedContainerService.HintSize="450,225" sap2010:WorkflowViewState.IdRef="Comment_2" Text="這個流程的用途&#xD;&#xA;這是 SRC_BAPIv2.2_TABLEDATA_OUTPUT_E 模組裡用來美化輸出結果的小工具：把 SAP 抓回來的原始資料表（欄位名通常是英文代碼，例如 MATNR、WERKS）輸出前，先在最上面插入一列「中文說明」或「欄位描述」，讓最終產出的 Excel/報表更容易閱讀，不用只看到 SAP 的代碼欄位名。" />
    <ui:LogMessage DisplayName="Log message - Start" sap:VirtualizedContainerService.HintSize="450,57" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Trace" Message="[WorkflowName + &quot;  start&quot;]">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsExpanded">False</x:Boolean>
          <x:Boolean x:Key="IsPinned">False</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    </ui:LogMessage>
    <Assign sap2010:Annotation.AnnotationText="用 io_dt_OutDataTable.NewRow 建立一筆空白的新資料列 TempRow&#xD;&#xA;&gt; 這筆新列的欄位結構會跟目標表 io_dt_OutDataTable 完全一致" DisplayName="Assign NewRow" sap:VirtualizedContainerService.HintSize="450,252" sap2010:WorkflowViewState.IdRef="Assign_4">
      <Assign.To>
        <OutArgument x:TypeArguments="sd:DataRow">[TempRow]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="sd:DataRow">[io_dt_OutDataTable.NewRow]</InArgument>
      </Assign.Value>
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    </Assign>
    <ui:ForEachRow ColumnNames="{x:Null}" sap2010:Annotation.AnnotationText="Convert Info of target Column of reference DataTable into a Row of DataTable.&#xD;&#xA;&#xD;&#xA;用 ForEachRow 逐列走過 in_dt_InputData（參考表）&#xD;&#xA;&gt; 用 Index 記錄目前跑到第幾列（CurrentIndex=&quot;[Index]&quot;）&#xD;&#xA;&gt; 每一列（row）都執行：&#xD;&#xA;&gt;&gt; 把 row(in_ColumnName) 的值（也就是參考表這一列、指定欄位的內容）指定給 TempRow.Item(Index)&#xD;&#xA;&gt; ⚠️ 關鍵技巧：這裡是用 Index（目前是第幾列）當作 TempRow 的「欄位索引」，也就是說：&#xD;&#xA;&gt;&gt; 參考表第 0 列的 in_ColumnName 值 → 放到 TempRow 的第 0 欄&#xD;&#xA;&gt;&gt; 參考表第 1 列的 in_ColumnName 值 → 放到 TempRow 的第 1 欄&#xD;&#xA;&gt;&gt; 以此類推……&#xD;&#xA;&gt; 這樣一來，參考表原本是「直向排列」的資料，就被轉換成「橫向排列」成一整列了！" CurrentIndex="[Index]" DataTable="[in_dt_InputData]" DisplayName="For Each Row 原「直向排列」資料表，轉成「橫向排列」成一整列" sap:VirtualizedContainerService.HintSize="450,701" sap2010:WorkflowViewState.IdRef="ForEachRow_1">
      <ui:ForEachRow.Body>
        <ActivityAction x:TypeArguments="sd:DataRow">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="sd:DataRow" Name="row" />
          </ActivityAction.Argument>
          <Assign DisplayName="Assign TempRow.Item(Index)" sap:VirtualizedContainerService.HintSize="334,143" sap2010:WorkflowViewState.IdRef="Assign_5">
            <Assign.To>
              <OutArgument x:TypeArguments="x:Object">[TempRow.Item(Index)]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:Object">[row(in_ColumnName).ToString]</InArgument>
            </Assign.Value>
          </Assign>
        </ActivityAction>
      </ui:ForEachRow.Body>
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    </ui:ForEachRow>
    <InvokeMethod sap2010:Annotation.AnnotationText="Add TempRow to the first line&#xD;&#xA;&#xD;&#xA;用 InvokeMethod 呼叫 io_dt_OutDataTable.Rows.InsertAt(TempRow, 0)&#xD;&#xA;&gt; 把組好的 TempRow插入到目標表的第 0 列（也就是最上面）.&#xD;&#xA;&gt; 用 InsertAt 而不是 Add，就是為了確保這筆資訊列一定會出現在表格最上方，不管目標表原本有沒有其他資料." DisplayName="Invoke Method" sap:VirtualizedContainerService.HintSize="450,328" sap2010:WorkflowViewState.IdRef="InvokeMethod_1" MethodName="InsertAt">
      <InvokeMethod.TargetObject>
        <InArgument x:TypeArguments="sd:DataRowCollection">[io_dt_OutDataTable.Rows]</InArgument>
      </InvokeMethod.TargetObject>
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
      <InArgument x:TypeArguments="sd:DataRow">[TempRow]</InArgument>
      <InArgument x:TypeArguments="x:Int32">0</InArgument>
    </InvokeMethod>
    <ui:LogMessage DisplayName="Log message - End" sap:VirtualizedContainerService.HintSize="450,48" sap2010:WorkflowViewState.IdRef="LogMessage_2" Level="Trace" Message="[WorkflowName + &quot;  end&quot;]">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsExpanded">False</x:Boolean>
          <x:Boolean x:Key="IsPinned">False</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    </ui:LogMessage>
  </Sequence>
</Activity>