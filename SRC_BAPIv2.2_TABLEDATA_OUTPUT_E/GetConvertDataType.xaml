  <Sequence sap2010:Annotation.AnnotationText="- Overview (把 SAP 的 ABAP 資料型態代碼（例如 CHAR、DEC、INT4…），轉換成比較「通用、簡化」的三種型態分類：String、Int、Byte，這樣後續在組查詢條件時，就能依照這個簡化後的型態，決定要用什麼格式來寫判斷式（例如字串要加引號、數字不用加）。)&#xA;Return  value (&quot;String&quot;or&quot;Int&quot;or&quot;Byte&quot;).&#xA;If nothing value it ,return blank.&#xA;&#xA;- Input/Output&#xA;in_ConvertDataType as string to be checked&#xA;out_ConvertType as converted string" DisplayName="GetConvertDataType" sap:VirtualizedContainerService.HintSize="973,2003" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Default="GetConvertDataType" Name="WorkflowName" />
      <Variable x:TypeArguments="sd:DataRow[]" Name="Rows" />
      <Variable x:TypeArguments="sd:DataTable" Name="TypeDataTable" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
        <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:Comment sap2010:Annotation.AnnotationText="舉例說明&#xD;&#xA;&gt; 輸入 in_ConvertDataType = &quot;CHAR&quot; → 對照表查到 → out_ConvertType = &quot;String&quot;&#xD;&#xA;&gt; 輸入 in_ConvertDataType = &quot;DEC&quot; → 對照表查到 → out_ConvertType = &quot;Int&quot;&#xD;&#xA;&gt; 輸入 in_ConvertDataType = &quot;XYZ&quot;（不存在的型態）→ 查不到 → out_ConvertType = &quot;&quot;（空白）" sap:VirtualizedContainerService.HintSize="452,215" sap2010:WorkflowViewState.IdRef="Comment_1" Text="//">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    </ui:Comment>
    <ui:Comment sap2010:Annotation.AnnotationText="這個流程正是前面 SetOptionDataTable.xaml 裡第一步呼叫的子流程：&#xD;&#xA;&#xD;&#xA;SetOptionDataTable.xaml&#xD;&#xA;   ↓ (傳入 row.Item(&quot;DATATYPE&quot;))&#xD;&#xA;GetConvertDataType.xaml  ← 把 SAP 型態代碼簡化成 String/Int/Byte&#xD;&#xA;   ↓ (out_ConvertType)&#xD;&#xA;MakeOptionDataTable.xaml  ← 依照這個簡化型態，決定查詢條件的寫法&#xD;&#xA;                              (例如 String 型態的值要加單引號 &#xD;&#xA;                               '值'，Int 型態則不需要加引號)&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;這樣設計的好處是：不用針對每一種 SAP 底層的細分型態都寫一套判斷邏輯，只要簡化成 3 大類，後續組 SQL-like 查詢字串時的邏輯就會簡單很多。&#xD;&#xA;至此，SRC_BAPIv2.2_TABLEDATA_OUTPUT_E 這個模組裡「查詢條件組裝」相關的三個流程（SetOptionDataTable、GetConvertDataType、以及尚未看過的 MakeOptionDataTable）的關聯已經很清楚了。" sap:VirtualizedContainerService.HintSize="452,461" sap2010:WorkflowViewState.IdRef="Comment_2" Text="//">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    </ui:Comment>
