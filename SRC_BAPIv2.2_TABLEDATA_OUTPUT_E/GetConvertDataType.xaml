    <ui:BuildDataTable sap2010:Annotation.AnnotationText="Create a comparison table of data types used by SAP.&#xA;&#xA;-SAPDataType : Data type used by SAP&#xA;-ConvertType: Corresponding data type&#xD;&#xA;&#xD;&#xA;用 BuildDataTable 建立一張「型態對照表」TypeDataTable&#xD;&#xA;&gt; 欄位：SAPDataType（SAP 型態代碼）、ConvertType（對應的簡化型態）&#xD;&#xA;&gt; 表裡預先寫好了完整的對照清單：&#xD;&#xA;SAP 資料型態（ABAP Type）| 轉換後型態&#xD;&#xA;CUKY、UNIT、NUMC、CHAR、LCHR、DATS、ACCP、TIMS、CLNT、LANG | String&#xD;&#xA;DEC、INT4、CURR、QUAN、FLTP | Int&#xD;&#xA;INT1、INT2、PREC、RAWSTRING、RAW、LRAW |Byte" DataTable="[TypeDataTable]" DisplayName="Build Data Table TypeDataTable" sap:VirtualizedContainerService.HintSize="452,365" sap2010:WorkflowViewState.IdRef="BuildDataTable_1" TableInfo="&lt;NewDataSet&gt;&#xA;  &lt;xs:schema id=&quot;NewDataSet&quot; xmlns=&quot;&quot; xmlns:xs=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:msdata=&quot;urn:schemas-microsoft-com:xml-msdata&quot;&gt;&#xA;    &lt;xs:element name=&quot;NewDataSet&quot; msdata:IsDataSet=&quot;true&quot; msdata:MainDataTable=&quot;TableName&quot; msdata:UseCurrentLocale=&quot;true&quot;&gt;&#xA;      &lt;xs:complexType&gt;&#xA;        &lt;xs:choice minOccurs=&quot;0&quot; maxOccurs=&quot;unbounded&quot;&gt;&#xA;          &lt;xs:element name=&quot;TableName&quot;&gt;&#xA;            &lt;xs:complexType&gt;&#xA;              &lt;xs:sequence&gt;&#xA;                &lt;xs:element name=&quot;SAPDataType&quot; minOccurs=&quot;0&quot;&gt;&#xA;                  &lt;xs:simpleType&gt;&#xA;                    &lt;xs:restriction base=&quot;xs:string&quot;&gt;&#xA;                      &lt;xs:maxLength value=&quot;100&quot; /&gt;&#xA;                    &lt;/xs:restriction&gt;&#xA;                  &lt;/xs:simpleType&gt;&#xA;                &lt;/xs:element&gt;&#xA;                &lt;xs:element name=&quot;ConvertType&quot; minOccurs=&quot;0&quot;&gt;&#xA;                  &lt;xs:simpleType&gt;&#xA;                    &lt;xs:restriction base=&quot;xs:string&quot;&gt;&#xA;                      &lt;xs:maxLength value=&quot;100&quot; /&gt;&#xA;                    &lt;/xs:restriction&gt;&#xA;                  &lt;/xs:simpleType&gt;&#xA;                &lt;/xs:element&gt;&#xA;              &lt;/xs:sequence&gt;&#xA;            &lt;/xs:complexType&gt;&#xA;          &lt;/xs:element&gt;&#xA;        &lt;/xs:choice&gt;&#xA;      &lt;/xs:complexType&gt;&#xA;    &lt;/xs:element&gt;&#xA;  &lt;/xs:schema&gt;&#xA;  &lt;TableName&gt;&#xA;    &lt;SAPDataType&gt;CUKY&lt;/SAPDataType&gt;&#xA;    &lt;ConvertType&gt;String&lt;/ConvertType&gt;&#xA;  &lt;/TableName&gt;&#xA;  &lt;TableName&gt;&#xA;    &lt;SAPDataType&gt;UNIT&lt;/SAPDataType&gt;&#xA;    &lt;ConvertType&gt;String&lt;/ConvertType&gt;&#xA;  &lt;/TableName&gt;&#xA;  &lt;TableName&gt;&#xA;    &lt;SAPDataType&gt;NUMC&lt;/SAPDataType&gt;&#xA;    &lt;ConvertType&gt;String&lt;/ConvertType&gt;&#xA;  &lt;/TableName&gt;&#xA;  &lt;TableName&gt;&#xA;    &lt;SAPDataType&gt;CHAR&lt;/SAPDataType&gt;&#xA;    &lt;ConvertType&gt;String&lt;/ConvertType&gt;&#xA;  &lt;/TableName&gt;&#xA;  &lt;TableName&gt;&#xA;    &lt;SAPDataType&gt;LCHR&lt;/SAPDataType&gt;&#xA;    &lt;ConvertType&gt;String&lt;/ConvertType&gt;&#xA;  &lt;/TableName&gt;&#xA;  &lt;TableName&gt;&#xA;    &lt;SAPDataType&gt;DATS&lt;/SAPDataType&gt;&#xA;    &lt;ConvertType&gt;String&lt;/ConvertType&gt;&#xA;  &lt;/TableName&gt;&#xA;  &lt;TableName&gt;&#xA;    &lt;SAPDataType&gt;ACCP&lt;/SAPDataType&gt;&#xA;    &lt;ConvertType&gt;String&lt;/ConvertType&gt;&#xA;  &lt;/TableName&gt;&#xA;  &lt;TableName&gt;&#xA;    &lt;SAPDataType&gt;TIMS&lt;/SAPDataType&gt;&#xA;    &lt;ConvertType&gt;String&lt;/ConvertType&gt;&#xA;  &lt;/TableName&gt;&#xA;  &lt;TableName&gt;&#xA;    &lt;SAPDataType&gt;CLNT&lt;/SAPDataType&gt;&#xA;    &lt;ConvertType&gt;String&lt;/ConvertType&gt;&#xA;  &lt;/TableName&gt;&#xA;  &lt;TableName&gt;&#xA;    &lt;SAPDataType&gt;LANG&lt;/SAPDataType&gt;&#xA;    &lt;ConvertType&gt;String&lt;/ConvertType&gt;&#xA;  &lt;/TableName&gt;&#xA;  &lt;TableName&gt;&#xA;    &lt;SAPDataType&gt;DEC&lt;/SAPDataType&gt;&#xA;    &lt;ConvertType&gt;Int&lt;/ConvertType&gt;&#xA;  &lt;/TableName&gt;&#xA;  &lt;TableName&gt;&#xA;    &lt;SAPDataType&gt;INT4&lt;/SAPDataType&gt;&#xA;    &lt;ConvertType&gt;Int&lt;/ConvertType&gt;&#xA;  &lt;/TableName&gt;&#xA;  &lt;TableName&gt;&#xA;    &lt;SAPDataType&gt;CURR&lt;/SAPDataType&gt;&#xA;    &lt;ConvertType&gt;Int&lt;/ConvertType&gt;&#xA;  &lt;/TableName&gt;&#xA;  &lt;TableName&gt;&#xA;    &lt;SAPDataType&gt;QUAN&lt;/SAPDataType&gt;&#xA;    &lt;ConvertType&gt;Int&lt;/ConvertType&gt;&#xA;  &lt;/TableName&gt;&#xA;  &lt;TableName&gt;&#xA;    &lt;SAPDataType&gt;FLTP&lt;/SAPDataType&gt;&#xA;    &lt;ConvertType&gt;Int&lt;/ConvertType&gt;&#xA;  &lt;/TableName&gt;&#xA;  &lt;TableName&gt;&#xA;    &lt;SAPDataType&gt;INT1&lt;/SAPDataType&gt;&#xA;    &lt;ConvertType&gt;Byte&lt;/ConvertType&gt;&#xA;  &lt;/TableName&gt;&#xA;  &lt;TableName&gt;&#xA;    &lt;SAPDataType&gt;INT2&lt;/SAPDataType&gt;&#xA;    &lt;ConvertType&gt;Byte&lt;/ConvertType&gt;&#xA;  &lt;/TableName&gt;&#xA;  &lt;TableName&gt;&#xA;    &lt;SAPDataType&gt;PREC&lt;/SAPDataType&gt;&#xA;    &lt;ConvertType&gt;Byte&lt;/ConvertType&gt;&#xA;  &lt;/TableName&gt;&#xA;  &lt;TableName&gt;&#xA;    &lt;SAPDataType&gt;RAWSTRING&lt;/SAPDataType&gt;&#xA;    &lt;ConvertType&gt;Byte&lt;/ConvertType&gt;&#xA;  &lt;/TableName&gt;&#xA;  &lt;TableName&gt;&#xA;    &lt;SAPDataType&gt;RAW&lt;/SAPDataType&gt;&#xA;    &lt;ConvertType&gt;Byte&lt;/ConvertType&gt;&#xA;  &lt;/TableName&gt;&#xA;  &lt;TableName&gt;&#xA;    &lt;SAPDataType&gt;LRAW&lt;/SAPDataType&gt;&#xA;    &lt;ConvertType&gt;Byte&lt;/ConvertType&gt;&#xA;  &lt;/TableName&gt;&#xA;&lt;/NewDataSet&gt;">
