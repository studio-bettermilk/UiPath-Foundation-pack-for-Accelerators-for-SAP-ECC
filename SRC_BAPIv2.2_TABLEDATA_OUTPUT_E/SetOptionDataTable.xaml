    <If sap2010:Annotation.AnnotationText="Remove unnecessary &quot;AND&quot; on the first row" Condition="[out_dt_Options.Rows.Count &lt;&gt; 0]" DisplayName="If out_dt_Options.Rows.Count &lt;&gt; 0" sap2010:WorkflowViewState.IdRef="If_2">
