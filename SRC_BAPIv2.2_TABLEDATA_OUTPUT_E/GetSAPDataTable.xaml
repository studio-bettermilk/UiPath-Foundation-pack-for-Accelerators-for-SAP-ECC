    <ui:InvokeWorkflowFile ContinueOnError="{x:Null}" sap2010:Annotation.AnnotationText="Set &quot;Option&quot; info." DisplayName="Invoke Workflow File SetOptionDataTable" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_5" UnSafe="False" WorkflowFileName="SRC_BAPIv2.2_TABLEDATA_OUTPUT_E\SetOptionDataTable.xaml">
