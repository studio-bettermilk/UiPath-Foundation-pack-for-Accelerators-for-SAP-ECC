  <Sequence sap2010:Annotation.AnnotationText="- Overview&#xA;Read Excel file created by SRC_BAPIv2.2_DATAELEMENT_OUTPUT_E(Data extraction conditions are entered) .&#xA;Output SAP Table Data Info as DataTable based on search conditions.&#xA;&#xA;- Input/Output&#xA;in_SAPService as SAP Connect Info &#xA;in_ExcelDataFilePath as file path of Excel file created by SRC_BAPIv2.2_DATAELEMENT_OUTPUT_E &lt;String&gt;&#xA;in_AddInformationFlg as flag to output DDTEXT, DATATYPE, LENG to first row of the output file &lt;String&gt;&#xA;   X ・・・Output&#xA;   Non-X・・・No output&#xA;out_dt_SAPDataTable as SAP Table Data &lt;DataTable&gt;" DisplayName="GetSAPDataTable" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="QueryTableStr" />
      <Variable x:TypeArguments="sd:DataTable" Name="dt_Data" />
      <Variable x:TypeArguments="sd:DataTable" Name="dt_Fields" />
      <Variable x:TypeArguments="sd:DataTable" Name="dt_Options" />
      <Variable x:TypeArguments="sd:DataTable" Name="dt_InputExcel" />
      <Variable x:TypeArguments="sd:DataTable" Name="dt_OutDataTable" />
      <Variable x:TypeArguments="x:String" Default="GetSAPDataTable" Name="WorkflowName" />
    </Sequence.Variables>
    <ui:LogMessage DisplayName="Log message - Start" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Trace" Message="[WorkflowName + &quot;  start&quot;]" />
    <ui:ExcelApplicationScope Password="{x:Null}" sap2010:Annotation.AnnotationText="Read Excel file in which data extraction conditions are entered." AutoSave="False" CreateNewFile="False" DisplayName="Excel Application Scope" sap2010:WorkflowViewState.IdRef="ExcelApplicationScope_1" ReadOnly="True" Visible="False" WorkbookPath="[in_ExcelDataFilePath]">
      <ui:ExcelApplicationScope.Body>
        <ActivityAction x:TypeArguments="ui:WorkbookApplication">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="ui:WorkbookApplication" Name="ExcelWorkbookScope" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Do" sap2010:WorkflowViewState.IdRef="Sequence_8">
            <ui:ExcelReadCell sap2010:Annotation.AnnotationText="Get DataTable name" Cell="A1" DisplayName="Read Cell Set" sap2010:WorkflowViewState.IdRef="ExcelReadCell_1" SheetName="SRC_DataElement">
              <ui:ExcelReadCell.Result>
                <OutArgument x:TypeArguments="x:String">[QueryTableStr]</OutArgument>
              </ui:ExcelReadCell.Result>
            </ui:ExcelReadCell>
            <ui:ExcelReadRange AddHeaders="True" sap2010:Annotation.AnnotationText="Get DataTable of Data Element Info" DataTable="[dt_InputExcel]" DisplayName="Read Range" sap2010:WorkflowViewState.IdRef="ExcelReadRange_1" Range="A2" SheetName="SRC_DataElement" />
