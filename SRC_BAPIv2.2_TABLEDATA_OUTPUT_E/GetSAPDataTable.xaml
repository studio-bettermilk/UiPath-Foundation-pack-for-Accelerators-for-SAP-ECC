    <Sequence sap2010:Annotation.AnnotationText="The io_dt_Data column ”WA” is returned as a string with the contents of dt_Fields concatenated.&#xA;&#xA;Decompose column &quot;WA&quot; by each character length and set to DataTable." DisplayName="Sequence Set dt_OutDataTable" sap2010:WorkflowViewState.IdRef="Sequence_12">
      <Sequence.Variables>
