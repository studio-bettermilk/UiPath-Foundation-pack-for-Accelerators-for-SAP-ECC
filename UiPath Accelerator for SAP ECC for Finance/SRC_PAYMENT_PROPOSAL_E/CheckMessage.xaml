          </ui:InvokeWorkflowFile.Arguments>
        </ui:InvokeWorkflowFile>
        <Switch x:TypeArguments="x:Int32" sap2010:Annotation.AnnotationText="StatusCode description:  &#xA;  Default = Non-image&#xA;  1 = Success Image&#xA;  2 = Error Image&#xA;  3 = Warning Image" DisplayName="Switch (based on StatusCode)" Expression="[StatusCode]" sap2010:WorkflowViewState.IdRef="Switch`1_1">
