                </Sequence>
              </If.Then>
              <If.Else>
                <Assign DisplayName="Assign IsDoLoop (Non-image)" sap2010:WorkflowViewState.IdRef="Assign_33">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:Boolean">[IsDoLoop]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:Boolean">False</InArgument>
                  </Assign.Value>
                </Assign>
              </If.Else>
            </If>
          </Switch.Default>
          <Assign x:Key="1" DisplayName="Assign IsDoLoop (Success)" sap2010:WorkflowViewState.IdRef="Assign_24">
