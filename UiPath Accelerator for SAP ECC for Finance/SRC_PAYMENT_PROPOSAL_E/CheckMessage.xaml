  <Sequence sap2010:Annotation.AnnotationText="- Overview&#xA;Check the SAP Status Image (Success, Error or Warning displayed on the SAP GUI screen.&#xA;&#xA;- Input/Output&#xA;in_Config as Config Data&lt;Dictionary&lt;String, Object&gt;&gt;&#xA;in_IsSaveStep as Flag indicating is Save Step. True will check the Success status when saving&lt;Boolean&gt;" DisplayName="CheckMessage" sap2010:WorkflowViewState.IdRef="Sequence_557">
