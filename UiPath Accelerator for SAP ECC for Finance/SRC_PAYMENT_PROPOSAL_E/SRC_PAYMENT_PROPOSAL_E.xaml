  <Sequence sap2010:Annotation.AnnotationText="- Overview&#xA;Run proposal for Automatic Payment Transactions&#xA;&#xA;- Input/Output&#xA;in_ArgumentFilePath as File path for Config &lt;String&gt;" DisplayName="SRC_PAYMENT_PROPOSAL_E" sap2010:WorkflowViewState.IdRef="Sequence_429">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Default="SRC_PAYMENT_PROPOSAL_E" Name="WorkflowName" />
      <Variable x:TypeArguments="scg:Dictionary(x:String, sd:DataTable)" Default="[new Dictionary(of String, system.Data.DataTable)]" Name="InputDataSheet" />
      <Variable x:TypeArguments="scg:List(x:String)" Default="[new List(of String)]" Name="SheetNames" />
      <Variable x:TypeArguments="scg:Dictionary(x:String, sd:DataTable)" Default="[new Dictionary(of String, system.Data.DataTable)]" Name="SelectorDataSheet" />
      <Variable x:TypeArguments="x:String" Default="/nF110" Name="TransactionCode" />
      <Variable x:TypeArguments="x:Int32" Name="RowCount" />
      <Variable x:TypeArguments="scg:Dictionary(x:String, x:Object)" Default="[new Dictionary(of String, Object)]" Name="Config" />
      <Variable x:TypeArguments="x:String" Name="LogFileName" />
      <Variable x:TypeArguments="sd:DataTable" Default="[new DataTable()]" Name="dt_Controller" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:LogMessage DisplayName="Log message - Start" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Info" Message="[WorkflowName + &quot; start&quot;]" />
    <Sequence sap2010:Annotation.AnnotationText="[Initial process]&#xA;1. Read Argument file and store data in Dictionary Config.&#xA;2. Check Argument parameters consistency, such as file path.&#xA;3. Read Component Resources file and store in Dictionary Config.&#xA;4. Set Log file name with current timestamp.&#xA;5. Build a Data Table with parameters used for SAP GUI control.&#xA;6. Check if SAP GUI is running and maximize the screen.&#xA;7. Load Input File and Selector File from Excel file" DisplayName="Initialization" sap2010:WorkflowViewState.IdRef="Sequence_834">
      <Sequence sap2010:Annotation.AnnotationText="1. Read Argument file and store data in Dictionary Config." DisplayName="Read Argument File" sap2010:WorkflowViewState.IdRef="Sequence_832">
        <Sequence.Variables>
          <Variable x:TypeArguments="sd:DataTable" Name="dt_ConfigTable" />
        </Sequence.Variables>
        <ui:ReadRange Range="{x:Null}" AddHeaders="True" DataTable="[dt_ConfigTable]" DisplayName="Read Range Config" sap2010:WorkflowViewState.IdRef="ReadRange_4" SheetName="Settings" WorkbookPath="[in_ArgumentFilePath]" />
        <ui:ForEachRow ColumnNames="{x:Null}" CurrentIndex="{x:Null}" DataTable="[dt_ConfigTable]" DisplayName="For each row in Config" sap2010:WorkflowViewState.IdRef="ForEachRow_7">
          <ui:ForEachRow.Body>
            <ActivityAction x:TypeArguments="sd:DataRow">
              <ActivityAction.Argument>
                <DelegateInArgument x:TypeArguments="sd:DataRow" Name="row" />
              </ActivityAction.Argument>
              <If Condition="[NOT String.IsNullOrEmpty(row(&quot;Name&quot;).ToString.Trim)]" DisplayName="If Name in Config is empty or null" sap2010:WorkflowViewState.IdRef="If_292">
                <If.Then>
                  <Assign DisplayName="Add key/value pair Config" sap2010:WorkflowViewState.IdRef="Assign_748">
                    <Assign.To>
                      <OutArgument x:TypeArguments="x:Object">[Config(row("Name").ToString.Trim)]</OutArgument>
                    </Assign.To>
                    <Assign.Value>
                      <InArgument x:TypeArguments="x:Object">[row("Value")]</InArgument>
                    </Assign.Value>
                  </Assign>
                </If.Then>
              </If>
            </ActivityAction>
          </ui:ForEachRow.Body>
