            <ui:InputDialog OptionsString="{x:Null}" DisplayName="Input dialog" sap2010:WorkflowViewState.IdRef="InputDialog_2" IsPassword="False" Label="Select the parameter settings Excel file" Options="[DirectoryFiles]" Title="File List" TopMost="False">
