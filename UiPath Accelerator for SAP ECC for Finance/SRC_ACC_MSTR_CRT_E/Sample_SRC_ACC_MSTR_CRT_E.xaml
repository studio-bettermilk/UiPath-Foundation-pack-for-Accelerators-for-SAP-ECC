      <TryCatch.Try>
        <Sequence DisplayName="Main Sequence" sap2010:WorkflowViewState.IdRef="Sequence_10">
          <Sequence sap2010:Annotation.AnnotationText="Show a dialog box with a list of Excel files inside of specified folder to be choosed as Config Parameter Arguments. " DisplayName="Choose Argument File" sap2010:WorkflowViewState.IdRef="Sequence_7">
            <Sequence.Variables>
              <Variable x:TypeArguments="x:String" Name="ParameterFolder" />
              <Variable x:TypeArguments="s:String[]" Name="DirectoryFiles" />
            </Sequence.Variables>
            <Assign DisplayName="Assign - ParameterFolder" sap2010:WorkflowViewState.IdRef="Assign_10">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">[ParameterFolder]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">\SRC_ACC_MSTR_CRT_E\Data</InArgument>
              </Assign.Value>
            </Assign>
            <Assign DisplayName="Assign - DirectoryFiles" sap2010:WorkflowViewState.IdRef="Assign_11">
              <Assign.To>
                <OutArgument x:TypeArguments="s:String[]">[DirectoryFiles]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="s:String[]">[System.IO.Directory.GetFiles(Directory.GetCurrentDirectory + ParameterFolder ,"*.xlsx" , System.IO.SearchOption.AllDirectories)]</InArgument>
              </Assign.Value>
