              <Assign.To>
                <OutArgument x:TypeArguments="x:String">[SelectedFile]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">[SelectedFile.Replace("~$","")]</InArgument>
              </Assign.Value>
            </Assign>
          </Sequence>
