  <Sequence sap2010:Annotation.AnnotationText="- Overview&#xA;Read CSV file and specify header name.&#xD;&#xA;&#xA;It is assumed that the columns of CSV data are displayed in the following order.&#xD;&#xA; 1. Bank Code&#xD;&#xA; 2. Branch code&#xD;&#xA; 3. Financial institution name(Kana)&#xD;&#xA; 4. Financial institution name(kanji)&#xD;&#xA; 5. Branch name(Kana)&#xD;&#xA; 6. Branch name(Kanji)&#xD;&#xA; 7. Postal code&#xD;&#xA; 8. Store location(Kanji)&#xD;&#xA; 9. Phone number&#xD;&#xA; 10. Bill exchange number&#xD;&#xA; 11. List code&#xD;&#xA; (12. Participation in the domestic exchange system )&#xD;&#xA;&#xA;- Input / Output&#xA;in_CSVFilePath as CSV file path used for reading &lt;String&gt;&#xA;out_dt_CSVData as DataTable Argument that stored the read CSV data&lt;DataTable&gt;&#xA;" DisplayName="LoadCSVData" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Default="LoadCSVData" Name="WorkflowName" />
    </Sequence.Variables>
    <ui:LogMessage DisplayName="Log message - start" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Trace" Message="[WorkflowName + &quot;  start&quot;]" />
    <Sequence DisplayName="Main Sequence" sap2010:WorkflowViewState.IdRef="Sequence_2">
      <Sequence.Variables>
        <Variable x:TypeArguments="x:Int32" Name="Counter" />
        <Variable x:TypeArguments="s:String[]" Name="HeaderName" />
      </Sequence.Variables>
      <ui:ReadCsvFile DataTable="[out_dt_CSVData]" Delimitator="Comma" DisplayName="Read CSV" Encoding="Shift-JIS" FilePath="[in_CSVFilePath]" sap2010:WorkflowViewState.IdRef="ReadCsvFile_1" IncludeColumnNames="False" />
      <Switch x:TypeArguments="x:Int32" DisplayName="Switch" Expression="[out_dt_CSVData.Columns.Count]" sap2010:WorkflowViewState.IdRef="Switch`1_1">
        <Switch.Default>
          <Throw sap2010:Annotation.AnnotationText="BusinessRuleException" DisplayName="Throw - CSV column count" Exception="[new UiPath.Core.BusinessRuleException(&quot;Check the number of CSV columns.&quot;, New Exception)]" sap2010:WorkflowViewState.IdRef="Throw_1" />
        </Switch.Default>
        <Assign x:Key="11" sap2010:Annotation.AnnotationText="Assign in case of columns count is 11." DisplayName="Assgin HeaderName ( 11 Columns )" sap2010:WorkflowViewState.IdRef="Assign_5">
          <Assign.To>
            <OutArgument x:TypeArguments="s:String[]">[HeaderName]</OutArgument>
          </Assign.To>
          <Assign.Value>
            <InArgument x:TypeArguments="s:String[]">[{ "BANK_KEY", "BANK_KEY_BRANCH", "BANK_NAME", "SKIP1", "BANK_BRANCH", "SKIP2", "SKIP3", "SKIP4", "SKIP5", "SKIP6", "SKIP7" }]</InArgument>
          </Assign.Value>
        </Assign>
        <Assign x:Key="12" sap2010:Annotation.AnnotationText="Assign in case of columns count is 12." DisplayName="Assgin HeaderName ( 12 Columns )" sap2010:WorkflowViewState.IdRef="Assign_4">
          <Assign.To>
            <OutArgument x:TypeArguments="s:String[]">[HeaderName]</OutArgument>
          </Assign.To>
          <Assign.Value>
            <InArgument x:TypeArguments="s:String[]">[{ "BANK_KEY", "BANK_KEY_BRANCH", "BANK_NAME", "SKIP1", "BANK_BRANCH", "SKIP2", "SKIP3", "SKIP4", "SKIP5", "SKIP6", "SKIP7", "SKIP8" }]</InArgument>
          </Assign.Value>
        </Assign>
      </Switch>
      <Assign DisplayName="Assign Counter (Initialize)" sap2010:WorkflowViewState.IdRef="Assign_1">
        <Assign.To>
          <OutArgument x:TypeArguments="x:Int32">[Counter]</OutArgument>
        </Assign.To>
        <Assign.Value>
          <InArgument x:TypeArguments="x:Int32">0</InArgument>
        </Assign.Value>
      </Assign>
      <ui:ForEach x:TypeArguments="x:String" CurrentIndex="{x:Null}" DisplayName="For Each" sap2010:WorkflowViewState.IdRef="ForEach`1_1" Values="[HeaderName]">
        <ui:ForEach.Body>
          <ActivityAction x:TypeArguments="x:String">
            <ActivityAction.Argument>
              <DelegateInArgument x:TypeArguments="x:String" Name="column" />
            </ActivityAction.Argument>
            <Sequence DisplayName="Specify header name" sap2010:WorkflowViewState.IdRef="Sequence_3">
              <Assign DisplayName="Assign column" sap2010:WorkflowViewState.IdRef="Assign_2">
                <Assign.To>
                  <OutArgument x:TypeArguments="x:String">[out_dt_CSVData.Columns(Counter).ColumnName]</OutArgument>
                </Assign.To>
                <Assign.Value>
                  <InArgument x:TypeArguments="x:String">[column]</InArgument>
                </Assign.Value>
              </Assign>
              <Assign DisplayName="Assign count up" sap2010:WorkflowViewState.IdRef="Assign_3">
                <Assign.To>
                  <OutArgument x:TypeArguments="x:Int32">[Counter]</OutArgument>
                </Assign.To>
                <Assign.Value>
                  <InArgument x:TypeArguments="x:Int32">[Counter + 1]</InArgument>
                </Assign.Value>
              </Assign>
            </Sequence>
          </ActivityAction>
        </ui:ForEach.Body>
      </ui:ForEach>
    </Sequence>
    <ui:LogMessage DisplayName="Log message - end" sap2010:WorkflowViewState.IdRef="LogMessage_2" Level="Trace" Message="[WorkflowName + &quot;  end&quot;]" />
