                <ui:ForEach x:TypeArguments="x:String" CurrentIndex="[SheetCount]" DisplayName="For Each sheet in SheetNames" sap2010:WorkflowViewState.IdRef="ForEach`1_38" Values="[SheetNames]">
                  <ui:ForEach.Body>
                    <ActivityAction x:TypeArguments="x:String">
                      <ActivityAction.Argument>
                        <DelegateInArgument x:TypeArguments="x:String" Name="sheet" />
                      </ActivityAction.Argument>
                      <If Condition="[InputDataSheet(sheet).Select(&quot;No = '&quot; &amp; HeaderIndex &amp; &quot;'&quot; ).Count &gt; 0]" DisplayName="If there is input data that matches the header index" sap2010:WorkflowViewState.IdRef="If_287">
