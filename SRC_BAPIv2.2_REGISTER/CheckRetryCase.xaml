  <Sequence sap2010:Annotation.AnnotationText="- Overview&#xA;Wait for processing for one second and write the number of retry count to the log file in the following cases.&#xA; - in_BAPIResultType is &quot;E&quot;.&#xA; - in_ErrorId equals in_BAPIResultId.&#xA; - in_ErrorNumber equals in_BAPIResultNumber.&#xA;&#xA;- Input/Output&#xA;in_RetryCount as the number of the retry count &lt;Int32&gt;&#xA;in_ErrorId as the specific Id &lt;String&gt;&#xA;in_ErrorNumber as the specific Number &lt;String&gt;&#xA;out_ErrorFlag as Processing flag for error &lt;Boolean&gt;&#xA;in_BAPIResultType as the value of BAPI return Type &lt;String&gt;&#xA;in_BAPIResultId as the value of BAPI return Id &lt;String&gt;&#xA;in_BAPIResultNumber as the value of BAPI return Number &lt;String&gt;&#xA;" DisplayName="CheckRetryCase" sap2010:WorkflowViewState.IdRef="Sequence_438">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Default="CheckRetryCase" Name="WorkflowName" />
    </Sequence.Variables>
    <ui:LogMessage DisplayName="Log message - Start" sap2010:WorkflowViewState.IdRef="LogMessage_8" Level="Trace" Message="[WorkflowName + &quot;  start&quot;]" />
    <Assign DisplayName="Assign ErrorFlag (Initialize)" sap2010:WorkflowViewState.IdRef="Assign_30">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Boolean">[out_ErrorFlag]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Boolean">False</InArgument>
      </Assign.Value>
    </Assign>
    <If Condition="[in_BAPIResultType = &quot;E&quot;]" DisplayName="if : Check if Type of the BAPIResult is &quot;E&quot;." sap2010:WorkflowViewState.IdRef="If_11">
      <If.Then>
        <If Condition="[in_BAPIResultId = in_ErrorId And in_BAPIResultNumber = in_ErrorNumber]" DisplayName="if : Check if the BAPIResult has a specific value." sap2010:WorkflowViewState.IdRef="If_10">
          <If.Then>
            <Sequence sap2010:Annotation.AnnotationText="If Error Id and Error Number in BAPIResult are returned to the specific error code in SAP, BAPI waits for one second." DisplayName="Sequence - Retry case" sap2010:WorkflowViewState.IdRef="Sequence_445">
              <Assign DisplayName="Assign True to ErrorFlag" sap2010:WorkflowViewState.IdRef="Assign_31">
                <Assign.To>
                  <OutArgument x:TypeArguments="x:Boolean">[out_ErrorFlag]</OutArgument>
                </Assign.To>
                <Assign.Value>
                  <InArgument x:TypeArguments="x:Boolean">True</InArgument>
                </Assign.Value>
              </Assign>
              <ui:LogMessage DisplayName="Log Message - Retry count" sap2010:WorkflowViewState.IdRef="LogMessage_10" Level="Trace" Message="[WorkflowName &amp; &quot; : Retry count is &quot; &amp; in_RertyCount + 1]" />
              <Delay sap2010:Annotation.AnnotationText="Wait for one second." DisplayName="Delay" Duration="00:00:01" sap2010:WorkflowViewState.IdRef="Delay_7" />
            </Sequence>
          </If.Then>
        </If>
      </If.Then>
    </If>
    <ui:LogMessage DisplayName="Log message - End" sap2010:WorkflowViewState.IdRef="LogMessage_9" Level="Trace" Message="[WorkflowName + &quot;  end&quot;]" />
    <sads:DebugSymbol.Symbol></sads:DebugSymbol.Symbol>
  </Sequence>
