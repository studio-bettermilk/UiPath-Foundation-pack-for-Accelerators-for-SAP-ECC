            <Assign DisplayName="Assign Create Dictionary" sap2010:WorkflowViewState.IdRef="Assign_682">
              <Assign.To>
                <OutArgument x:TypeArguments="scg:Dictionary(x:String, sd:DataTable)">[out_InputDataSheet]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="scg:Dictionary(x:String, sd:DataTable)">[new Dictionary(of String, system.Data.DataTable)]</InArgument>
              </Assign.Value>
            </Assign>
            <ui:ForEach x:TypeArguments="x:String" CurrentIndex="{x:Null}" DisplayName="For Each Read Loop" sap2010:WorkflowViewState.IdRef="ForEach`1_25" Values="[out_SheetNames]">
              <ui:ForEach.Body>
                <ActivityAction x:TypeArguments="x:String">
                  <ActivityAction.Argument>
                    <DelegateInArgument x:TypeArguments="x:String" Name="item" />
                  </ActivityAction.Argument>
                  <Sequence sap2010:WorkflowViewState.IdRef="Sequence_701">
                    <Sequence.Variables>
                      <Variable x:TypeArguments="sd:DataTable" Name="dt_Temp" />
                    </Sequence.Variables>
                    <ui:ExcelReadRange AddHeaders="True" DataTable="[dt_Temp]" DisplayName="Read Range" sap2010:WorkflowViewState.IdRef="ExcelReadRange_2" Range="A1" SheetName="[item]" />
                    <Assign DisplayName="Assign set data" sap2010:WorkflowViewState.IdRef="Assign_683">
                      <Assign.To>
                        <OutArgument x:TypeArguments="sd:DataTable">[out_InputDataSheet(item)]</OutArgument>
                      </Assign.To>
                      <Assign.Value>
                        <InArgument x:TypeArguments="sd:DataTable">[dt_Temp]</InArgument>
                      </Assign.Value>
                    </Assign>
                  </Sequence>
                </ActivityAction>
              </ui:ForEach.Body>
            </ui:ForEach>
          </Sequence>
        </ActivityAction>
      </ui:ExcelApplicationScope.Body>
