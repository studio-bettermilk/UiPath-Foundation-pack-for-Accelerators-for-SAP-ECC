  <Sequence sap2010:Annotation.AnnotationText="- OverView&#xA;Output the value of in_dt_LogData to Excel or text format.&#xA;If the number of record of in_dt_LogData is over the value of in_ExcelOutputLine, the data exceeding the value is output as text format.&#xA;&#xA;- Input/Output&#xA;in_ExcelFilePath as Outpu Excel File Path &lt;String&gt;&#xA;in_ExcelOutputLine as Excel output row count &lt;Int32&gt;&#xA;in_dt_LogData as Output Data &lt;DataTable&gt;&#xA;in_TextFilePath as Outpu Text File Path &lt;String&gt;" DisplayName="WriteLogToExcelAndText" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Default="WriteLogToExcelAndText" Name="WorkflowName" />
      <Variable x:TypeArguments="sd:DataTable" Default="[new DataTable]" Name="dt_Text" />
    </Sequence.Variables>
    <ui:LogMessage DisplayName="Log message - Start" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Trace" Message="[WorkflowName + &quot; start&quot;]" />
    <Assign DisplayName="Assign Copy LogData" sap2010:WorkflowViewState.IdRef="Assign_6">
      <Assign.To>
        <OutArgument x:TypeArguments="sd:DataTable">[dt_Text]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="sd:DataTable">[in_dt_LogData.Copy]</InArgument>
      </Assign.Value>
    </Assign>
    <Sequence DisplayName="Sequence WriteExcel" sap2010:WorkflowViewState.IdRef="Sequence_4">
      <ui:InvokeWorkflowFile ContinueOnError="{x:Null}" sap2010:Annotation.AnnotationText="Delete rows from in_dt_LogData which exceeds the value of in_ExcelOutputLine." DisplayName="Invoke DeleteRow Workflow File (Excel)" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_1" UnSafe="False" WorkflowFileName="SRC_BAPIv2.2_REGISTER\DeleteRow.xaml">
        <ui:InvokeWorkflowFile.Arguments>
          <InArgument x:TypeArguments="x:Int32" x:Key="in_DeleteRow">[in_ExcelOutputLine]</InArgument>
          <InArgument x:TypeArguments="x:Int32" x:Key="in_DeleteCount">[in_dt_LogData.Rows.Count - in_ExcelOutputLine]</InArgument>
          <InOutArgument x:TypeArguments="sd:DataTable" x:Key="io_dt_Target">[in_dt_LogData]</InOutArgument>
        </ui:InvokeWorkflowFile.Arguments>
      </ui:InvokeWorkflowFile>
      <ui:WriteRange AddHeaders="True" DataTable="[in_dt_LogData]" DisplayName="Write Range" sap2010:WorkflowViewState.IdRef="WriteRange_1" SheetName="SRC_Log" StartingCell="A1" WorkbookPath="[in_ExcelFilePath]" />
      <Sequence DisplayName="Change the position of the sheet" sap2010:WorkflowViewState.IdRef="Sequence_3">
        <Sequence.Variables>
          <Variable x:TypeArguments="ce:XLWorkbook" Name="Workbook" />
        </Sequence.Variables>
        <Assign DisplayName="Assign Create XLWorkbook" sap2010:WorkflowViewState.IdRef="Assign_5">
          <Assign.To>
            <OutArgument x:TypeArguments="ce:XLWorkbook">[Workbook]</OutArgument>
          </Assign.To>
          <Assign.Value>
            <InArgument x:TypeArguments="ce:XLWorkbook">[New XLWorkbook(in_ExcelFilePath)]</InArgument>
          </Assign.Value>
        </Assign>
        <Assign sap2010:Annotation.AnnotationText="Move [SRC_Log] to the first sheet." DisplayName="Assign first sheet" sap2010:WorkflowViewState.IdRef="Assign_2">
          <Assign.To>
            <OutArgument x:TypeArguments="x:Int32">[Workbook.Worksheet("SRC_Log").Position]</OutArgument>
          </Assign.To>
          <Assign.Value>
            <InArgument x:TypeArguments="x:Int32">1</InArgument>
          </Assign.Value>
        </Assign>
        <Assign sap2010:Annotation.AnnotationText="Change [SRC_Log] Date/Number format to text." DisplayName="Assign format" sap2010:WorkflowViewState.IdRef="Assign_3">
          <Assign.To>
            <OutArgument x:TypeArguments="x:Int32">[Workbook.Worksheet("SRC_Log").Style.NumberFormat.NumberFormatId]</OutArgument>
          </Assign.To>
          <Assign.Value>
            <InArgument x:TypeArguments="x:Int32">49</InArgument>
          </Assign.Value>
        </Assign>
        <InvokeMethod DisplayName="Invoke Method Save" sap2010:WorkflowViewState.IdRef="InvokeMethod_3" MethodName="Save">
          <InvokeMethod.TargetObject>
            <InArgument x:TypeArguments="ce:XLWorkbook">[Workbook]</InArgument>
          </InvokeMethod.TargetObject>
        </InvokeMethod>
      </Sequence>
    </Sequence>
    <If Condition="[in_ExcelOutputLine &lt; dt_Text.Rows.Count]" DisplayName="If Check if output log as text format or not" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Then>
        <Sequence DisplayName="Sequence Write Text" sap2010:WorkflowViewState.IdRef="Sequence_8">
          <ui:InvokeWorkflowFile ContinueOnError="{x:Null}" sap2010:Annotation.AnnotationText="Delete rows which is already output into Excel." DisplayName="Invoke DeleteRow Workflow File (Text)" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_2" UnSafe="False" WorkflowFileName="SRC_BAPIv2.2_REGISTER\DeleteRow.xaml">
            <ui:InvokeWorkflowFile.Arguments>
              <InArgument x:TypeArguments="x:Int32" x:Key="in_DeleteRow">0</InArgument>
              <InArgument x:TypeArguments="x:Int32" x:Key="in_DeleteCount">[in_ExcelOutputLine]</InArgument>
              <InOutArgument x:TypeArguments="sd:DataTable" x:Key="io_dt_Target">[dt_Text]</InOutArgument>
            </ui:InvokeWorkflowFile.Arguments>
          </ui:InvokeWorkflowFile>
          <ui:WriteCsvFile Encoding="{x:Null}" AddHeaders="True" DataTable="[dt_Text]" Delimitator="Comma" DisplayName="Write CSV" FilePath="[in_TextFilePath]" sap2010:WorkflowViewState.IdRef="WriteCsvFile_1" />
        </Sequence>
      </If.Then>
    </If>
    <ui:LogMessage DisplayName="Log message - End" sap2010:WorkflowViewState.IdRef="LogMessage_2" Level="Trace" Message="[WorkflowName + &quot; end&quot;]" />
    <sads:DebugSymbol.Symbol></sads:DebugSymbol.Symbol>
  </Sequence>
