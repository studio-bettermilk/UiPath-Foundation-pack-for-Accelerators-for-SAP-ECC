  <Sequence sap2010:Annotation.AnnotationText="- Overview (這支流程的功能是：把一個「表名稱→資料表」的字典（Dictionary&lt;String, DataTable&gt;），全部轉換組合成一長串純文字訊息，方便直接寫進Log記錄裡查看。)&#xA;Convert the value of in_TargetMessage for log output.&#xA;&#xA;- Input/Output&#xA;in_TargetMessage as input data &lt;Dictionary&lt;String,DataTable&gt;&gt;&#xA;out_Message as Made Message &lt;String&gt;" DisplayName="AddBAPILog" sap:VirtualizedContainerService.HintSize="880,1924" sap2010:WorkflowViewState.IdRef="Sequence_430">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Default="AddBAPILog" Name="WorkflowName" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
        <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:Comment sap2010:Annotation.AnnotationText="舉例說明&#xD;&#xA;假設 in_TargetMessage 內容是：&#xD;&#xA;&#xD;&#xA;Key=&quot;Header&quot; → Value=DataTable(一列: [1000, &quot;測試物料&quot;])&#xD;&#xA;Key=&quot;Return&quot; → Value=DataTable(兩列: [E, &quot;錯誤：欄位缺失&quot;], [S, &quot;已成功處理&quot;])&#xD;&#xA;&#xD;&#xA;跑完流程後，out_Message 會變成類似這樣的一長串文字：&#xD;&#xA;&#xD;&#xA; Header:1000,測試物料  Return:E,錯誤：欄位缺失 S,已成功處理 " sap:VirtualizedContainerService.HintSize="488,313" sap2010:WorkflowViewState.IdRef="Comment_1" Text="// Write your comments in the Text property">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    </ui:Comment>
    <ui:Comment sap2010:Annotation.AnnotationText="這支流程的用途&#xD;&#xA;這是 SRC_BAPIv2.2_REGISTER 模組裡的一個Log輔助工具，主要用在 BAPI 執行前後，把「要送進SAP的參數內容」或「SAP回傳的結果/錯誤訊息（例如Return表）」，統一轉成單一行、好讀的純文字，方便寫進系統Log裡追蹤除錯，而不用把整個複雜的 Dictionary&lt;String, DataTable&gt; 物件直接丟進Log（那樣通常只會顯示物件型態名稱，看不到實際內容）。這跟您之前問過的 ExecuteBAPI.xaml（BAPI安全執行器）、ConvertAuthorityLogToBAPILogFormat.xaml（授權失敗訊息格式化）是同一類「把複雜資料轉成好讀Log文字」的輔助流程家族。" sap:VirtualizedContainerService.HintSize="488,313" sap2010:WorkflowViewState.IdRef="Comment_2" Text="// Write your comments in the Text property">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    </ui:Comment>
    <ui:LogMessage DisplayName="Log message - Start" sap:VirtualizedContainerService.HintSize="488,57" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Trace" Message="[WorkflowName + &quot;  start&quot;]">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsExpanded">False</x:Boolean>
          <x:Boolean x:Key="IsPinned">False</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    </ui:LogMessage>
    <ui:ForEach x:TypeArguments="scg:KeyValuePair(x:String, sd:DataTable)" CurrentIndex="{x:Null}" sap2010:Annotation.AnnotationText="DataTable Loop&#xA;&#xA;用外層 ForEach 逐一走過 in_TargetMessage 這個字典的每一組 KeyValuePair（item）&#xA;&gt; 每組 item 代表一張資料表，item.Key＝表名稱、item.Value＝該表的 DataTable" DisplayName="For Each DataTable" sap:VirtualizedContainerService.HintSize="488,1093" sap2010:WorkflowViewState.IdRef="ForEach`1_2" Values="[in_TargetMessage]">
      <ui:ForEach.Body>
        <ActivityAction x:TypeArguments="scg:KeyValuePair(x:String, sd:DataTable)">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="scg:KeyValuePair(x:String, sd:DataTable)" Name="item" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Body" sap:VirtualizedContainerService.HintSize="486,868" sap2010:WorkflowViewState.IdRef="Sequence_433">
            <sap:WorkflowViewStateService.ViewState>
              <scg:Dictionary x:TypeArguments="x:String, x:Object">
                <x:Boolean x:Key="IsExpanded">True</x:Boolean>
              </scg:Dictionary>
            </sap:WorkflowViewStateService.ViewState>
            <Assign sap2010:Annotation.AnnotationText="先把 Key（表名稱）串接到 out_Message 後面&#xD;&#xA;&#xD;&#xA;out_Message = out_Message &amp; &quot; &quot; &amp; item.Key &amp; &quot;:&quot;&#xD;&#xA;&#xD;&#xA;例如若表名稱是 &quot;BAPI_MATERIAL_SAVEDATA&quot;，此時 out_Message 會變成：... BAPI_MATERIAL_SAVEDATA:" DisplayName="Assign Key join" sap:VirtualizedContainerService.HintSize="452,301" sap2010:WorkflowViewState.IdRef="Assign_2">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">[out_Message]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">[out_Message &amp; " " &amp; item.Key &amp; ":"]</InArgument>
              </Assign.Value>
              <sap:WorkflowViewStateService.ViewState>
                <scg:Dictionary x:TypeArguments="x:String, x:Object">
                  <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
                </scg:Dictionary>
              </sap:WorkflowViewStateService.ViewState>
            </Assign>
            <ui:ForEach x:TypeArguments="sd:DataRow" CurrentIndex="{x:Null}" sap2010:Annotation.AnnotationText="Row Loop&#xD;&#xA;&#xD;&#xA;用內層 ForEach 逐一走過這張表（item.Value）的每一列（row） - 每一列都執行： vb out_Message = out_Message &amp; string.Join(&quot;,&quot;, row.ItemArray).Replace(Chr(34),&quot;&quot;) &amp; &quot; &quot; - row.ItemArray 是這一列所有欄位的值（陣列） - string.Join(&quot;,&quot;, ...) 把這些值用逗號串接成一行，例如：&quot;1000,MAT001,件&quot; - .Replace(Chr(34),&quot;&quot;) 把字串裡的雙引號字元去掉（Chr(34) 就是 &quot;），避免Log訊息裡出現多餘的引號造成混淆或格式錯亂 - 最後補一個空格，接著串到 out_Message 後面" DisplayName="For Each Row" sap:VirtualizedContainerService.HintSize="452,507" sap2010:WorkflowViewState.IdRef="ForEach`1_1" Values="[item.Value.Rows]">
              <ui:ForEach.Body>
                <ActivityAction x:TypeArguments="sd:DataRow">
                  <ActivityAction.Argument>
                    <DelegateInArgument x:TypeArguments="sd:DataRow" Name="row" />
                  </ActivityAction.Argument>
                  <Sequence DisplayName="Body" sap:VirtualizedContainerService.HintSize="450,226" sap2010:WorkflowViewState.IdRef="Sequence_434">
                    <sap:WorkflowViewStateService.ViewState>
                      <scg:Dictionary x:TypeArguments="x:String, x:Object">
                        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                      </scg:Dictionary>
                    </sap:WorkflowViewStateService.ViewState>
                    <Assign DisplayName="Assign RowData join" sap:VirtualizedContainerService.HintSize="416,166" sap2010:WorkflowViewState.IdRef="Assign_3">
                      <Assign.To>
                        <OutArgument x:TypeArguments="x:String">[out_Message]</OutArgument>
                      </Assign.To>
                      <Assign.Value>
                        <InArgument x:TypeArguments="x:String">[out_Message &amp; string.Join(",", row.ItemArray ).Replace(Chr(34),"") &amp; " "]</InArgument>
                      </Assign.Value>
                    </Assign>
                  </Sequence>
                </ActivityAction>
              </ui:ForEach.Body>
              <sap:WorkflowViewStateService.ViewState>
                <scg:Dictionary x:TypeArguments="x:String, x:Object">
                  <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
                </scg:Dictionary>
              </sap:WorkflowViewStateService.ViewState>
            </ui:ForEach>
          </Sequence>
        </ActivityAction>
      </ui:ForEach.Body>
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    </ui:ForEach>
    <ui:LogMessage DisplayName="Log message - End" sap:VirtualizedContainerService.HintSize="488,48" sap2010:WorkflowViewState.IdRef="LogMessage_2" Level="Trace" Message="[WorkflowName + &quot;  end&quot;]">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsExpanded">False</x:Boolean>
          <x:Boolean x:Key="IsPinned">False</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    </ui:LogMessage>
  </Sequence>
