  <Sequence sap2010:Annotation.AnnotationText="- Overview (把 SAP 授權檢查失敗的錯誤訊息，轉換成統一格式的 Log 文字，方便寫入 Log 檔案後，日後好閱讀、好追查是「誰、對哪個權限物件、哪些欄位值」被擋下來。)&#xA;Convert the result of Authority check for log output.&#xA;&#xA;- Input/Output&#xA;in_BAPIArgument as BAPI Argument  &lt;DataRow&gt;&#xA;in_ExceptionMessage as  Authority Check  Error Log&lt;String&gt;&#xA;out_WriteLog as Converted Log &lt;String&gt;&#xA;&#xA;- Output format&#xA;AuthorizationObject[Authorized] Field[Value]  Field[Value]  Field[Value]...&#xA;" DisplayName="ConvertAuthorityLogToBAPILogFormat" sap:VirtualizedContainerService.HintSize="973,2746" sap2010:WorkflowViewState.IdRef="Sequence_18">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Default="ConvertAuthorityLogToBAPILogFormat" Name="WorkflowName" />
      <Variable x:TypeArguments="x:Int32" Name="DataCount" />
      <Variable x:TypeArguments="x:Int32" Name="MaxCount" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
        <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:Comment sap:VirtualizedContainerService.HintSize="496,128" sap2010:WorkflowViewState.IdRef="Comment_1" Text="輸出格式說明（在流程註解裡有寫）：&#xD;&#xA;NOT_AUTHORIZED NEW_BUFFERING[3] USER[TESTUSER] OBJECT[F_BKPF_BUK] BUKRS[1000]" />
    <ui:Comment sap:VirtualizedContainerService.HintSize="496,264" sap2010:WorkflowViewState.IdRef="Comment_2" Text="這個流程是被 CheckAuthority.xaml 呼叫的：當 AUTHORITY_CHECK 檢查結果不是 &quot;USER_IS_AUTHORIZED&quot;（也就是沒有權限、或有其他錯誤）時，就會呼叫這個流程，把原始的例外訊息轉成一行好讀的 Log 文字，最終回傳給 out_Authority，讓上層的 ExecuteBAPI.xaml 知道「沒有權限，這筆不能執行 BAPI」，並且這行文字也會被寫進 Log 檔，方便日後追查是哪個使用者、哪個權限物件、哪些欄位值造成授權失敗。" />
    <ui:LogMessage DisplayName="Log message - Start" sap:VirtualizedContainerService.HintSize="496,57" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Trace" Message="[WorkflowName + &quot;  start&quot;]">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsExpanded">False</x:Boolean>
          <x:Boolean x:Key="IsPinned">False</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    </ui:LogMessage>
    <Assign sap2010:Annotation.AnnotationText="Set&#xA;-NEW_BUFFERING&#xA;-Authorized&#xA;-AuthorizationObject&#xD;&#xA;&#xD;&#xA;組出 Log 字串的「前段」：例外訊息 + 基本資訊&#xA;&gt; 把 in_ExceptionMessage（例如錯誤代碼或說明）先放最前面&#xD;&#xA;&gt; 接著串上：&#xD;&#xA;&gt;&gt; NEW_BUFFERING[值]（第 0 欄，也就是那個固定值 &quot;3&quot;）&#xD;&#xA;&gt;&gt; USER[值]（第 2 欄，被檢查權限的使用者帳號）&#xD;&#xA;&gt;&gt; OBJECT[值]（第 1 欄，被檢查的權限物件，例如 F_BKPF_BUK）" DisplayName="Assign Authority information" sap:VirtualizedContainerService.HintSize="496,416" sap2010:WorkflowViewState.IdRef="Assign_9">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[out_WriteLog]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[in_ExceptionMessage &amp; " " &amp; "NEW_BUFFERING" &amp; "[" &amp; in_BAPIArgument(0).ToString &amp; "] " &amp; "USER" &amp; "[" &amp; in_BAPIArgument(2).ToString &amp; "] " &amp; "OBJECT" &amp; "[" &amp; in_BAPIArgument(1).ToString &amp; "]"]</InArgument>
      </Assign.Value>
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    </Assign>
    <Assign sap2010:Annotation.AnnotationText="Set the position of the first Field variable.&#xD;&#xA;設定第一個計數器:&#xD;&#xA;&gt; MaxCount = 22：DataRow 總共有 22 欄（3 個基本欄位 + 10 組 Field/Value，每組 2 欄 = 20 欄，3+20=23，不過這裡用 22 當終止值，實際上跑到第 10 組 Field10/Value10 就會結束）" DisplayName="Assign Initialize DataCount" sap:VirtualizedContainerService.HintSize="496,285" sap2010:WorkflowViewState.IdRef="Assign_12">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Int32">[DataCount]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Int32">3</InArgument>
      </Assign.Value>
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    </Assign>
    <Assign sap2010:Annotation.AnnotationText="Set the maximum number of columns for in_BAPIArgument.&#xD;&#xA;&#xD;&#xA;設定第二個計數器:&#xD;&#xA;&gt; MaxCount = 22：DataRow 總共有 22 欄（3 個基本欄位 + 10 組 Field/Value，每組 2 欄 = 20 欄，3+20=23，不過這裡用 22 當終止值，實際上跑到第 10 組 Field10/Value10 就會結束）" DisplayName="Assign MaxCount" sap:VirtualizedContainerService.HintSize="496,318" sap2010:WorkflowViewState.IdRef="Assign_16">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Int32">[MaxCount]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Int32">22</InArgument>
      </Assign.Value>
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    </Assign>
    <While sap2010:Annotation.AnnotationText="Set&#xA;- Field&#xA;- Value&#xD;&#xA;&#xD;&#xA;用一個 While 迴圈，每次處理一組 Field/Value&#xD;&#xA;&gt; 條件：DataCount &lt; MaxCount&#xD;&#xA;&gt; 每次迴圈：&#xD;&#xA;&gt;&gt; 檢查這組資料是否為空白（in_BAPIArgument(DataCount) 是不是空的）&#xD;&#xA;&gt;&gt;&gt; 是空白 → 表示後面已經沒有更多有效的 Field/Value 資料了，直接把 DataCount 設成 MaxCount，強制跳出迴圈（提早結束，不用跑完剩下的空欄位）&#xD;&#xA;&gt;&gt;&gt; 不是空白 → 把這組 Field[Value] 串接到 out_WriteLog 後面，格式是：&quot; Field名 [Value值]&quot;&#xD;&#xA;&gt; 不論上面是哪種情況，最後都把 DataCount + 2（因為 Field 跟 Value 是成對的兩欄，一次要跳過 2 個索引，才會對到下一組 Field/Value）" DisplayName="While FieldAndValue" sap:VirtualizedContainerService.HintSize="496,1130" sap2010:WorkflowViewState.IdRef="While_1">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
      <While.Condition>[DataCount &lt; MaxCount]</While.Condition>
      <Sequence sap:VirtualizedContainerService.HintSize="450,695" sap2010:WorkflowViewState.IdRef="Sequence_20">
        <sap:WorkflowViewStateService.ViewState>
          <scg:Dictionary x:TypeArguments="x:String, x:Object">
            <x:Boolean x:Key="IsExpanded">True</x:Boolean>
          </scg:Dictionary>
        </sap:WorkflowViewStateService.ViewState>
        <If Condition="[string.IsNullOrWhiteSpace(in_BAPIArgument(DataCount).ToString)]" DisplayName="If : Check if DataCount is blank" sap:VirtualizedContainerService.HintSize="416,469" sap2010:WorkflowViewState.IdRef="If_4">
          <If.Then>
            <Assign sap2010:Annotation.AnnotationText="In case of no data, set MaxCount and terminate the process." DisplayName="Assign BreakValue" sap:VirtualizedContainerService.HintSize="334,143" sap2010:WorkflowViewState.IdRef="Assign_15">
              <Assign.To>
                <OutArgument x:TypeArguments="x:Int32">[DataCount]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:Int32">[MaxCount]</InArgument>
              </Assign.Value>
            </Assign>
          </If.Then>
          <If.Else>
            <Assign DisplayName="Assign join Data" sap:VirtualizedContainerService.HintSize="334,143" sap2010:WorkflowViewState.IdRef="Assign_13">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">[out_WriteLog]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">[out_WriteLog &amp; " " &amp; in_BAPIArgument(DataCount).ToString &amp; "[" &amp; in_BAPIArgument(DataCount+1).ToString &amp; "]"]</InArgument>
              </Assign.Value>
            </Assign>
          </If.Else>
        </If>
        <Assign sap2010:Annotation.AnnotationText="Since Field and Value are output at once, add 2 to DataCount." DisplayName="Assign Increment" sap:VirtualizedContainerService.HintSize="416,166" sap2010:WorkflowViewState.IdRef="Assign_14">
          <Assign.To>
            <OutArgument x:TypeArguments="x:Int32">[DataCount]</OutArgument>
          </Assign.To>
          <Assign.Value>
            <InArgument x:TypeArguments="x:Int32">[DataCount + 2]</InArgument>
          </Assign.Value>
        </Assign>
      </Sequence>
    </While>
    <ui:LogMessage DisplayName="Log message - End" sap:VirtualizedContainerService.HintSize="496,48" sap2010:WorkflowViewState.IdRef="LogMessage_2" Level="Trace" Message="[WorkflowName + &quot;  end&quot;]">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsExpanded">False</x:Boolean>
          <x:Boolean x:Key="IsPinned">False</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    </ui:LogMessage>
  </Sequence>
