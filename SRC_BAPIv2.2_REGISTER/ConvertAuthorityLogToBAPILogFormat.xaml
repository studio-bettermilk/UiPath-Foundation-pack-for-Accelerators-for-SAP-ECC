  <Sequence sap2010:Annotation.AnnotationText="- Overview&#xA;Convert the result of Authority check for log output.&#xA;&#xA;- Input/Output&#xA;in_BAPIArgument as BAPI Argument  &lt;DataRow&gt;&#xA;in_ExceptionMessage as  Authority Check  Error Log&lt;String&gt;&#xA;out_WriteLog as Converted Log &lt;String&gt;&#xA;&#xA;- Output format&#xA;AuthorizationObject[Authorized] Field[Value]  Field[Value]  Field[Value]...&#xA;" DisplayName="ConvertAuthorityLogToBAPILogFormat" sap2010:WorkflowViewState.IdRef="Sequence_18">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Default="ConvertAuthorityLogToBAPILogFormat" Name="WorkflowName" />
      <Variable x:TypeArguments="x:Int32" Name="DataCount" />
      <Variable x:TypeArguments="x:Int32" Name="MaxCount" />
    </Sequence.Variables>
    <ui:LogMessage DisplayName="Log message - Start" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Trace" Message="[WorkflowName + &quot;  start&quot;]" />
    <Assign sap2010:Annotation.AnnotationText="Set&#xA;-NEW_BUFFERING&#xA;-Authorized&#xA;-AuthorizationObject&#xA;" DisplayName="Assign Authority information" sap2010:WorkflowViewState.IdRef="Assign_9">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[out_WriteLog]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[in_ExceptionMessage &amp; " " &amp; "NEW_BUFFERING" &amp; "[" &amp; in_BAPIArgument(0).ToString &amp; "] " &amp; "USER" &amp; "[" &amp; in_BAPIArgument(2).ToString &amp; "] " &amp; "OBJECT" &amp; "[" &amp; in_BAPIArgument(1).ToString &amp; "]"]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign sap2010:Annotation.AnnotationText="Set the position of the first Field variable." DisplayName="Assign Initialize DataCount" sap2010:WorkflowViewState.IdRef="Assign_12">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Int32">[DataCount]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Int32">3</InArgument>
      </Assign.Value>
    </Assign>
    <Assign sap2010:Annotation.AnnotationText="Set the maximum number of columns for in_BAPIArgument." DisplayName="Assign MaxCount" sap2010:WorkflowViewState.IdRef="Assign_16">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Int32">[MaxCount]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Int32">22</InArgument>
      </Assign.Value>
    </Assign>
    <While sap2010:Annotation.AnnotationText="Set&#xA;- Field&#xA;- Value" DisplayName="While FieldAndValue" sap2010:WorkflowViewState.IdRef="While_1" Condition="[DataCount &lt; MaxCount]">
      <Sequence sap2010:WorkflowViewState.IdRef="Sequence_20">
        <If Condition="[string.IsNullOrWhiteSpace(in_BAPIArgument(DataCount).ToString)]" DisplayName="If : Check if DataCount is blank" sap2010:WorkflowViewState.IdRef="If_4">
          <If.Then>
            <Assign sap2010:Annotation.AnnotationText="In case of no data, set MaxCount and terminate the process." DisplayName="Assign BreakValue" sap2010:WorkflowViewState.IdRef="Assign_15">
              <Assign.To>
                <OutArgument x:TypeArguments="x:Int32">[DataCount]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:Int32">[MaxCount]</InArgument>
              </Assign.Value>
            </Assign>
          </If.Then>
          <If.Else>
            <Assign DisplayName="Assign join Data" sap2010:WorkflowViewState.IdRef="Assign_13">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">[out_WriteLog]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">[out_WriteLog &amp; " " &amp; in_BAPIArgument(DataCount).ToString &amp; "[" &amp; in_BAPIArgument(DataCount+1).ToString &amp; "]"]</InArgument>
              </Assign.Value>
            </Assign>
          </If.Else>
        </If>
        <Assign sap2010:Annotation.AnnotationText="Since Field and Value are output at once, add 2 to DataCount." DisplayName="Assign Increment" sap2010:WorkflowViewState.IdRef="Assign_14">
          <Assign.To>
            <OutArgument x:TypeArguments="x:Int32">[DataCount]</OutArgument>
          </Assign.To>
          <Assign.Value>
            <InArgument x:TypeArguments="x:Int32">[DataCount + 2]</InArgument>
          </Assign.Value>
        </Assign>
      </Sequence>
    </While>
    <ui:LogMessage DisplayName="Log message - End" sap2010:WorkflowViewState.IdRef="LogMessage_2" Level="Trace" Message="[WorkflowName + &quot;  end&quot;]" />
