  <Sequence sap2010:Annotation.AnnotationText="- Overview (這支流程是一個成功訊息組裝工具，功能是：當BAPI執行成功時，把「Success」這個成功訊息（以及選填的編號）組成統一格式，加進回傳訊息清單裡，方便後續統一輸出到Log記錄。)&#xA;Convert the execution result of BAPI into string type.&#xA;&#xA;- Input/Output&#xA;in_OutputNo as The optional number for BAPI &lt;String&gt;&#xA;out_ReturnMessage as Return values &lt;List&lt;Dictioary&lt;String, String&gt;&gt;" DisplayName="AddSuccessMessageToBAPILog" sap:VirtualizedContainerService.HintSize="880,2108" sap2010:WorkflowViewState.IdRef="Sequence_436">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Default="WriteSuccessMessage" Name="WorkflowName" />
      <Variable x:TypeArguments="scg:Dictionary(x:String, x:String)" Default="[new Dictionary(of String, String)]" Name="OutputTemp" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
        <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:Comment sap2010:Annotation.AnnotationText="舉例說明&#xD;&#xA;假設 in_OutputNo = &quot;MAT001&quot;：&#xD;&#xA;&#xD;&#xA;out_ReturnMessage = [&#xD;&#xA;    { &quot;Message=&quot; : &quot;Success&quot;, &quot;Number=&quot; : &quot;MAT001&quot; }&#xD;&#xA;]&#xD;&#xA;&#xD;&#xA;若 in_OutputNo 是空字串：&#xD;&#xA;&#xD;&#xA;out_ReturnMessage = [&#xD;&#xA;    { &quot;Message=&quot; : &quot;Success&quot; }&#xD;&#xA;]&#xD;&#xA;" sap:VirtualizedContainerService.HintSize="452,330" sap2010:WorkflowViewState.IdRef="Comment_1" Text="// Write your comments in the Text property">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    </ui:Comment>
    <ui:Comment sap2010:Annotation.AnnotationText="🔗 這支流程在整套系統裡的角色&#xD;&#xA;這是 SRC_BAPIv2.2_REGISTER 模組裡「BAPI成功執行後的訊息記錄工具」，跟它功能相對的應該還有一支類似的「失敗訊息組裝工具」（例如可能叫 AddErrorMessageToBAPILog.xaml，用同樣的Dictionary&lt;String,String&gt;格式，但內容改成錯誤訊息）。這種設計讓 ExecuteBAPI.xaml（您之前問過的BAPI安全執行器）不管執行成功或失敗，都能用統一的資料結構（List&lt;Dictionary&lt;String,String&gt;&gt;）記錄結果，方便最後統一整理、輸出到CSV/Excel的Log檔案裡（就像您之前問過的SRC_BAPIv2.2_REGISTER.xaml主流程結尾的&quot;WriteLlog&quot;那段邏輯）。" sap:VirtualizedContainerService.HintSize="452,313" sap2010:WorkflowViewState.IdRef="Comment_2" Text="// Write your comments in the Text property">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    </ui:Comment>
    <ui:Comment sap:VirtualizedContainerService.HintSize="452,89" sap2010:WorkflowViewState.IdRef="Comment_3" Text="// Write your comments in the Text property" />
    <ui:LogMessage DisplayName="Log message - Start" sap:VirtualizedContainerService.HintSize="452,57" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Trace" Message="[WorkflowName + &quot;  start&quot;]">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsExpanded">False</x:Boolean>
          <x:Boolean x:Key="IsPinned">False</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    </ui:LogMessage>
    <Assign sap2010:Annotation.AnnotationText="初始化 out_ReturnMessage&#xD;&#xA;建立一個空的 List&lt;Dictionary&lt;String, String&gt;&gt;" DisplayName="Assign out_ReturnMessage (Initialize)" sap:VirtualizedContainerService.HintSize="452,220" sap2010:WorkflowViewState.IdRef="Assign_18">
      <Assign.To>
        <OutArgument x:TypeArguments="scg:List(scg:Dictionary(x:String, x:String))">[out_ReturnMessage]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="scg:List(scg:Dictionary(x:String, x:String))">[new List(of Dictionary(of String, String))]</InArgument>
      </Assign.Value>
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    </Assign>
    <Assign sap2010:Annotation.AnnotationText="組裝成功訊息內容（OutputTemp 這個暫存字典）&#xD;&#xA;&gt; OutputTemp(&quot;Message=&quot;) = &quot;Success&quot;&#xD;&#xA;&gt; ⚠️ 這裡的Key寫法比較特別，是 &quot;Message=&quot;（含等號），而不是單純的 &quot;Message&quot;，這是這個模組慣用的Log格式標記法，方便後續把整個字典轉成文字時，能直接組出類似 Message=Success 這樣的鍵值對格式字串" DisplayName="Assign Message" sap:VirtualizedContainerService.HintSize="452,301" sap2010:WorkflowViewState.IdRef="Assign_20">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[OutputTemp("Message=")]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">Success</InArgument>
      </Assign.Value>
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    </Assign>
    <If sap2010:Annotation.AnnotationText="判斷 in_OutputNo 是否有填值（也就是您目前選中的 Sequence_436 裡的 If_4）&#xD;&#xA;&gt; 若 in_OutputNo 去除頭尾空白後不是空字串 → 補上 OutputTemp(&quot;Number=&quot;) = in_OutputNo&#xD;&#xA;&gt; 若沒填 → 不加這個Key（代表這次的BAPI沒有需要記錄的編號）" Condition="[Not String.IsNullOrWhitespace(in_OutputNo.Trim)]" DisplayName="Check If OutputNo has values." sap:VirtualizedContainerService.HintSize="452,488" sap2010:WorkflowViewState.IdRef="If_4">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
      <If.Then>
        <Assign DisplayName="Assign Number" sap:VirtualizedContainerService.HintSize="450,143" sap2010:WorkflowViewState.IdRef="Assign_21">
          <Assign.To>
            <OutArgument x:TypeArguments="x:String">[OutputTemp("Number=")]</OutArgument>
          </Assign.To>
          <Assign.Value>
            <InArgument x:TypeArguments="x:String">[in_OutputNo]</InArgument>
          </Assign.Value>
        </Assign>
      </If.Then>
    </If>
    <ui:Comment sap:VirtualizedContainerService.HintSize="452,108" sap2010:WorkflowViewState.IdRef="Comment_4" Text=" 用 AddToCollection 把 OutputTemp 這個字典加進 out_ReturnMessage 清單裡" />
    <AddToCollection x:TypeArguments="scg:Dictionary(x:String, x:String)" Collection="[out_ReturnMessage]" DisplayName="Add To Collection (Dictionary)" sap:VirtualizedContainerService.HintSize="452,54" sap2010:WorkflowViewState.IdRef="AddToCollection`1_1" Item="[OutputTemp]" />
    <ui:LogMessage DisplayName="Log message - End" sap:VirtualizedContainerService.HintSize="452,48" sap2010:WorkflowViewState.IdRef="LogMessage_2" Level="Trace" Message="[WorkflowName + &quot;  end&quot;]">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsExpanded">False</x:Boolean>
          <x:Boolean x:Key="IsPinned">False</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    </ui:LogMessage>
  </Sequence>
