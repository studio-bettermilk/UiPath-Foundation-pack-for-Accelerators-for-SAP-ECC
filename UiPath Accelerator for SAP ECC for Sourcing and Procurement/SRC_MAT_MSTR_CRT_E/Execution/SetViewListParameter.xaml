  <Sequence sap2010:Annotation.AnnotationText="- Overview&#xA;Set in Config collection a list parameter with all &quot;Select View Itens&quot; must be used for Material data input according each worksheet defined in Controller collection.&#xA;If there's no input data for the target worksheet, &quot;Select View Itens&quot; will not be included in the list.&#xA;&#xA;- Input/Output&#xA;in_HeaderIndex as Input Data header index &lt;String&gt;&#xA;in_InputDataSheet as Data read from input file &lt;Dictionay&lt;String,DataTable&gt;&gt;&#xA;in_Config as Config Parameters &lt;Dictionary&lt;String, Object&gt;&gt;&#xA;in_dt_Controller as Parameters used to control SAP GUI screen &lt;DataRow&gt;" DisplayName="SetViewListParameter" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Default="SetViewListParameter" Name="WorkflowName" />
      <Variable x:TypeArguments="scg:List(x:String)" Name="ViewItemList" />
    </Sequence.Variables>
    <ui:LogMessage DisplayName="Log message - Start" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Trace" Message="[WorkflowName + &quot;  start&quot;]" />
    <Assign DisplayName="Assign ViewItemList (Initialization)" sap2010:WorkflowViewState.IdRef="Assign_2">
      <Assign.To>
        <OutArgument x:TypeArguments="scg:List(x:String)">[ViewItemList]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="scg:List(x:String)">[New List(Of String)]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:ForEachRow CurrentIndex="{x:Null}" DataTable="[in_dt_Controller]" DisplayName="For Each Controller Row" sap2010:WorkflowViewState.IdRef="ForEachRow_1">
      <ui:ForEachRow.Body>
        <ActivityAction x:TypeArguments="sd:DataRow">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="sd:DataRow" Name="row" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Add View Item into collection" sap2010:WorkflowViewState.IdRef="Sequence_2">
            <Sequence.Variables>
              <Variable x:TypeArguments="x:Int32" Name="HeaderCount" />
            </Sequence.Variables>
            <Assign sap2010:Annotation.AnnotationText="Get the total number of input data of target worksheet using HeaderIndex as primary key." DisplayName="Assign HeaderCount" sap2010:WorkflowViewState.IdRef="Assign_3">
              <Assign.To>
                <OutArgument x:TypeArguments="x:Int32">[HeaderCount]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:Int32">[in_InputDataSheet(row("SheetName").ToString).Select("No = '" &amp; in_HeaderIndex &amp; "'" ).Count]</InArgument>
              </Assign.Value>
            </Assign>
            <If sap2010:Annotation.AnnotationText="Add to View Item List if Input Data has any record to be inputted and target worksheet is assigned as ViewItem. " Condition="[HeaderCount &gt; 0 AND Convert.ToBoolean(row(&quot;ViewItem&quot;))]" DisplayName="If View Item must be enabled" sap2010:WorkflowViewState.IdRef="If_3">
              <If.Then>
                <AddToCollection x:TypeArguments="x:String" Collection="[ViewItemList]" DisplayName="Add To Collection" sap2010:WorkflowViewState.IdRef="AddToCollection`1_1" Item="[row(&quot;ViewItemName_&quot; &amp; in_Config(&quot;Language&quot;).ToString).ToString]" />
              </If.Then>
            </If>
          </Sequence>
        </ActivityAction>
      </ui:ForEachRow.Body>
    </ui:ForEachRow>
    <Assign sap2010:Annotation.AnnotationText="Store view item list into Config " DisplayName="Assign ViewItemList" sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Object">[in_Config("SelectView_DisplayItems")]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Object">[ViewItemList]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:LogMessage DisplayName="Log message - End" sap2010:WorkflowViewState.IdRef="LogMessage_2" Level="Trace" Message="[WorkflowName + &quot;  end&quot;]" />
    <sads:DebugSymbol.Symbol></sads:DebugSymbol.Symbol>
  </Sequence>
