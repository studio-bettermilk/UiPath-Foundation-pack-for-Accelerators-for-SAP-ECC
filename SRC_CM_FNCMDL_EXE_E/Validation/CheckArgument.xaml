    <If sap2010:Annotation.AnnotationText="Check Resource File Path " Condition="[Not System.IO.File.Exists(in_Config(&quot;ResourceFilePath&quot;).ToString)]" DisplayName="If path exists for ResourceFile" sap2010:WorkflowViewState.IdRef="If_7">
