    <If sap2010:Annotation.AnnotationText="Check Input File Path " Condition="[Not System.IO.File.Exists(in_Config(&quot;InputFilePath&quot;).ToString)]" DisplayName="If path exists for InputFile" sap2010:WorkflowViewState.IdRef="If_1">
