    <ui:ForEach x:TypeArguments="ce:IXLWorksheet" CurrentIndex="{x:Null}" sap2010:Annotation.AnnotationText="用 ClosedXML 開啟輸入檔，逐一遍歷所有工作表（ForEach，用 New XLWorkbook(in_InputFilePath).Worksheets）&#xA;&gt; 每個工作表都執行：&#xA;&gt;&gt; 用 ReadRange 讀取該工作表資料 → 存入 out_InputData(sheet.Name)&#xA;&gt;&gt; 用 AddToCollection 把工作表名稱加進 out_SheetNames" DisplayName="For Each Sheet in Excel File" sap:VirtualizedContainerService.HintSize="522,557" sap2010:WorkflowViewState.IdRef="ForEach`1_12" Values="[New XLWorkbook(in_InputFilePath).Worksheets]">
      <ui:ForEach.Body>
        <ActivityAction x:TypeArguments="ce:IXLWorksheet">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="ce:IXLWorksheet" Name="sheet" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Add Sheet Name into Collection" sap:VirtualizedContainerService.HintSize="450,332" sap2010:WorkflowViewState.IdRef="Sequence_51">
            <sap:WorkflowViewStateService.ViewState>
              <scg:Dictionary x:TypeArguments="x:String, x:Object">
                <x:Boolean x:Key="IsExpanded">True</x:Boolean>
              </scg:Dictionary>
            </sap:WorkflowViewStateService.ViewState>
            <ui:ReadRange AddHeaders="True" DataTable="[out_InputData(sheet.Name.ToString)]" DisplayName="Read Range InputData" sap:VirtualizedContainerService.HintSize="416,227" sap2010:WorkflowViewState.IdRef="ReadRange_2" SheetName="[sheet.Name.ToString]" WorkbookPath="[in_InputFilePath]">
              <ui:ReadRange.Range>
                <InArgument x:TypeArguments="x:String">
                  <Literal x:TypeArguments="x:String" Value="" />
                </InArgument>
              </ui:ReadRange.Range>
            </ui:ReadRange>
            <AddToCollection x:TypeArguments="x:String" Collection="[out_SheetNames]" DisplayName="Add Sheet Name" sap:VirtualizedContainerService.HintSize="416,45" sap2010:WorkflowViewState.IdRef="AddToCollection`1_4" Item="[sheet.Name.ToString]" />
          </Sequence>
        </ActivityAction>
      </ui:ForEach.Body>
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    </ui:ForEach>
    <RemoveFromCollection x:TypeArguments="x:String" sap2010:Annotation.AnnotationText="用 RemoveFromCollection 把 &quot;SRC_Log&quot; 這個工作表名稱從 out_SheetNames 移除&#xA;&gt; 因為SRC_Log是專門用來記錄執行結果的工作表，不是真正的「輸入資料」，所以要排除在後續處理範圍外" Collection="[out_SheetNames]" DisplayName="Remove &quot;SRC_Log&quot;" sap:VirtualizedContainerService.HintSize="522,180" sap2010:WorkflowViewState.IdRef="RemoveFromCollection`1_2" Item="SRC_Log">
