        </Assign.Value>
      </Assign>
      <Assign sap2010:Annotation.AnnotationText="Remove all from last slash &quot;/&quot; part and append &quot;'/&gt;&quot; at end of string." DisplayName="Assign TableSelector (Remove tbl part)" sap2010:WorkflowViewState.IdRef="Assign_30">
