    <ui:ForEach x:TypeArguments="sd:DataRow" sap2010:Annotation.AnnotationText="Main Loop&#xA;Repeat the process for the number of DataRow rows." CurrentIndex="[RowCount]" DisplayName="For Each row in in_TargetValue" sap2010:WorkflowViewState.IdRef="ForEach`1_4" Values="[in_TargetValue]">
