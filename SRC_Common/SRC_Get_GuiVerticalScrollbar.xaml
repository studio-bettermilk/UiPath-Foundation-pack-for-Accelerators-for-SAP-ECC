lly&#xD;&#xA;      Try&#xD;&#xA;       System.Runtime.InteropServices.Marshal.ReleaseComObject(VScroll)&#xD;&#xA;      Catch ex As Exception&#xD;&#xA;      End Try&#xD;&#xA;     End Try&#xD;&#xA;    Finally&#xD;&#xA;     Try&#xD;&#xA;      System.Runtime.InteropServices.Marshal.ReleaseComObject(ControlID)&#xD;&#xA;     Catch ex As Exception&#xD;&#xA;     End Try&#xD;&#xA;    End Try&#xD;&#xA;   Finally&#xD;&#xA;    Try&#xD;&#xA;     System.Runtime.InteropServices.Marshal.ReleaseComObject(session)&#xD;&#xA;    Catch ex As Exception&#xD;&#xA;    End Try&#xD;&#xA;   End Try   &#xD;&#xA;  Finally&#xD;&#xA;   Try&#xD;&#xA;    System.Runtime.InteropServices.Marshal.ReleaseComObject(connection)&#xD;&#xA;   Catch ex As Exception&#xD;&#xA;   End Try&#xD;&#xA;  End Try  &#xD;&#xA; Finally&#xD;&#xA;  Try&#xD;&#xA;   System.Runtime.InteropServices.Marshal.ReleaseComObject(application)&#xD;&#xA;  Catch ex As Exception&#xD;&#xA;  End Try&#xD;&#xA; End Try&#xD;&#xA;Finally&#xD;&#xA; Try&#xD;&#xA;  System.Runtime.InteropServices.Marshal.FinalReleaseComObject(SapGuiAuto)&#xD;&#xA;  System.GC.Collect()&#xD;&#xA;  System.GC.WaitForPendingFinalizers()&#xD;&#xA; Catch ex As Exception&#xD;&#xA; End Try&#xD;&#xA;End Try" DisplayName="Invoke code for GuiScrollbar.VerticalScrollbar" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
