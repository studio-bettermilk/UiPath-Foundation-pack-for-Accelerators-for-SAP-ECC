        <OutArgument x:TypeArguments="x:String" x:Key="out_IconName">[out_IconName]</OutArgument>
        <OutArgument x:TypeArguments="x:String" x:Key="out_Tooltip">[out_Tooltip]</OutArgument>
      </ui:InvokeCode.Arguments>
    </ui:InvokeCode>
