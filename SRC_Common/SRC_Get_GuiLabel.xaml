    <ui:InvokeCode ContinueOnError="{x:Null}" Code="'-Begin-----------------------------------------------------------------&#xA;Dim SapGuiAuto As Object = Nothing&#xA;Try&#xA; SapGuiAuto = GetObject(&quot;SAPGUI&quot;)&#xA; Dim application As Object = Nothing&#xA; Try&#xA;  application = SapGuiAuto.GetType.InvokeMember(&quot;GetScriptingEngine&quot;, Reflection.BindingFlags.InvokeMethod, Nothing, SapGuiAuto, Nothing)&#xA;  Dim connection As Object = Nothing&#xA;  Try&#xA;   connection = application.GetType.InvokeMember(&quot;Children&quot;, Reflection.BindingFlags.GetProperty, Nothing, application, {0})&#xA;   Dim session As Object = Nothing&#xA;   Try&#xA;    session = connection.GetType.InvokeMember(&quot;Children&quot;, Reflection.BindingFlags.GetProperty, Nothing, connection, {0})&#xA;    Dim ControlID As Object = Nothing&#xA;    Try&#xA;     ControlID = session.GetType.InvokeMember(&quot;findById&quot;, Reflection.BindingFlags.InvokeMethod, Nothing, session, {&quot;wnd[0]/&quot; &amp; in_ControlID})&#xA;     out_ColorIndex = CType(ControlID.GetType.InvokeMember(&quot;ColorIndex&quot;, Reflection.BindingFlags.GetProperty, Nothing, ControlID, Nothing), Integer)&#xA;     out_ColorIntensified = CType(ControlID.GetType.InvokeMember(&quot;ColorIntensified&quot;, Reflection.BindingFlags.GetProperty, Nothing, ControlID, Nothing), Boolean)&#xA;     out_DisplayedText = CType(ControlID.GetType.InvokeMember(&quot;DisplayedText&quot;, Reflection.BindingFlags.GetProperty, Nothing, ControlID, Nothing), String)&#xA;     out_IconName = CType(ControlID.GetType.InvokeMember(&quot;IconName&quot;, Reflection.BindingFlags.GetProperty, Nothing, ControlID, Nothing), String)&#xA;     out_Tooltip = CType(ControlID.GetType.InvokeMember(&quot;Tooltip&quot;, Reflection.BindingFlags.GetProperty, Nothing, ControlID, Nothing), String)&#xA;    Finally&#xA;     Try&#xA;      System.Runtime.InteropServices.Marshal.ReleaseComObject(ControlID)&#xA;     Catch ex As Exception&#xA;     End Try&#xA;    End Try&#xA;   Finally&#xA;    Try&#xA;     System.Runtime.InteropServices.Marshal.ReleaseComObject(session)&#xA;    Catch ex As Exception&#xA;    End Try&#xA;   End Try   &#xA;  Finally&#xA;   Try&#xA;    System.Runtime.InteropServices.Marshal.ReleaseComObject(connection)&#xA;   Catch ex As Exception&#xA;   End Try&#xA;  End Try  &#xA; Finally&#xA;  Try&#xA;   System.Runtime.InteropServices.Marshal.ReleaseComObject(application)&#xA;  Catch ex As Exception&#xA;  End Try&#xA; End Try&#xA;Finally&#xA; Try&#xA;  System.Runtime.InteropServices.Marshal.FinalReleaseComObject(SapGuiAuto)&#xA;  System.GC.Collect()&#xA;  System.GC.WaitForPendingFinalizers()&#xA; Catch ex As Exception&#xA; End Try&#xA;End Try" DisplayName="Invoke code for GuiLabel" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
