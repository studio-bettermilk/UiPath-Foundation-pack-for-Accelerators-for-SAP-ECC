  <Sequence sap2010:Annotation.AnnotationText="- Overview&#xA;Create the DataTable based on the argument information.&#xA;&#xA;- Input&#xA;in_Text as Data String &lt;List&lt;String&gt;&gt;&#xA;in_Len_Str as Number of strings &lt;List&lt;String&gt;&gt;&#xA;in_dt_Fields as Information of FIELDS &lt;DataTable&gt;&#xA;&#xA;- Output&#xA;out_dt_OutputData as Extracted Data from Data String &lt;DataTable&gt;" DisplayName="SRC_MakeTextListToDataTable" sap2010:WorkflowViewState.IdRef="Sequence_3">
