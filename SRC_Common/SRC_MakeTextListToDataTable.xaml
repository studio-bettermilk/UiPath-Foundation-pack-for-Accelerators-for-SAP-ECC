            <ui:ForEach x:TypeArguments="x:String" sap2010:Annotation.AnnotationText="Separate by character position" CurrentIndex="[Index]" DisplayName="For Each Set Row.Item" sap2010:WorkflowViewState.IdRef="ForEach`1_2" Values="[in_Len_Str]">
              <ui:ForEach.Body>
                <ActivityAction x:TypeArguments="x:String">
                  <ActivityAction.Argument>
                    <DelegateInArgument x:TypeArguments="x:String" Name="len" />
                  </ActivityAction.Argument>
                  <Sequence DisplayName="Body Set Row.Item" sap2010:WorkflowViewState.IdRef="Sequence_5">
                    <Sequence.Variables>
                      <Variable x:TypeArguments="x:Int32" Name="EndPoint" />
                    </Sequence.Variables>
                    <Assign sap2010:Annotation.AnnotationText="Get last character position" DisplayName="Assign EndPoint" sap2010:WorkflowViewState.IdRef="Assign_5">
                      <Assign.To>
                        <OutArgument x:TypeArguments="x:Int32">[EndPoint]</OutArgument>
                      </Assign.To>
                      <Assign.Value>
                        <InArgument x:TypeArguments="x:Int32">[Integer.Parse(len)]</InArgument>
                      </Assign.Value>
                    </Assign>
                    <If sap2010:Annotation.AnnotationText="Check if the string acquisition start position exceeds the total number of characters" Condition="[StartPoint &gt; item.Length]" DisplayName="If  StartPoint &gt; item.Length" sap2010:WorkflowViewState.IdRef="If_1">
                      <If.Then>
                        <Assign DisplayName="Assign blank" sap2010:WorkflowViewState.IdRef="Assign_13">
                          <Assign.To>
                            <OutArgument x:TypeArguments="x:Object">[Row.Item(Index)]</OutArgument>
                          </Assign.To>
                          <Assign.Value>
                            <InArgument x:TypeArguments="x:Object">[""]</InArgument>
                          </Assign.Value>
                        </Assign>
                      </If.Then>
                      <If.Else>
                        <Assign DisplayName="Assign Item separated by character position" sap2010:WorkflowViewState.IdRef="Assign_6">
                          <Assign.To>
                            <OutArgument x:TypeArguments="x:Object">[Row.Item(Index)]</OutArgument>
                          </Assign.To>
                          <Assign.Value>
                            <InArgument x:TypeArguments="x:Object" xml:space="preserve">[item.Substring(StartPoint , if (item.Length &gt;= (StartPoint + EndPoint) ,  EndPoint, (item.Length - StartPoint) )).Trim]</InArgument>
                          </Assign.Value>
                        </Assign>
                      </If.Else>
                    </If>
                    <Assign DisplayName="Assign Update start position" sap2010:WorkflowViewState.IdRef="Assign_7">
                      <Assign.To>
                        <OutArgument x:TypeArguments="x:Int32">[StartPoint]</OutArgument>
                      </Assign.To>
                      <Assign.Value>
                        <InArgument x:TypeArguments="x:Int32">[StartPoint + EndPoint]</InArgument>
                      </Assign.Value>
                    </Assign>
                  </Sequence>
                </ActivityAction>
              </ui:ForEach.Body>
            </ui:ForEach>
            <ui:AddDataRow ArrayRow="{x:Null}" DataRow="[Row]" DataTable="[TempDataTable]" DisplayName="Add Data Row" sap2010:WorkflowViewState.IdRef="AddDataRow_2" />
