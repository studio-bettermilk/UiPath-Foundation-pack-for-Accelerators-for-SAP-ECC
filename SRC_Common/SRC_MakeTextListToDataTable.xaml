              <Variable x:TypeArguments="sd:DataRow" Name="Row" />
              <Variable x:TypeArguments="x:Int32" Name="Index" />
            </Sequence.Variables>
            <Assign DisplayName="Assign Initialize StartPoint" sap2010:WorkflowViewState.IdRef="Assign_1">
              <Assign.To>
