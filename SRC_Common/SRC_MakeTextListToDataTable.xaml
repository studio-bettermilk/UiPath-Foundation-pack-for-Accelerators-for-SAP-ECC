    <ui:ForEach x:TypeArguments="x:String" CurrentIndex="{x:Null}" sap2010:Annotation.AnnotationText="Divide Data string for each delimiter ( length ) to set the Datatable." DisplayName="For Each Add Data Row" sap2010:WorkflowViewState.IdRef="ForEach`1_3" Values="[in_Text]">
      <ui:ForEach.Body>
        <ActivityAction x:TypeArguments="x:String">
          <ActivityAction.Argument>
