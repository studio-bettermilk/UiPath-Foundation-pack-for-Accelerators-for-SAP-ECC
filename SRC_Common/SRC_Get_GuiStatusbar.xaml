  <Sequence sap2010:Annotation.AnnotationText="- Overview&#xA;Return the specified properties of Gui Status Bar Object using SAP Gui Scripiting API. &#xA;&#xA;- Input/Output&#xA;out_MessageType as Message Type &lt;String&gt;&#xA;out_MessageId as Message ID &lt;String&gt;&#xA;out_MessageNumber as Message Number &lt;String&gt;&#xA;out_MessageText as Message Text &lt;String&gt;&#xA;&#xA;* MessageType summary&#xA;---------------------------&#xA;S = Success&#xA;W = Warning&#xA;E = Error&#xA;A = Abort&#xA;I = Information" DisplayName="SRC_Get_GuiStatusbar" sap2010:WorkflowViewState.IdRef="Sequence_1">
