    </sap:WorkflowViewStateService.ViewState>
    <ui:Comment sap2010:Annotation.AnnotationText="MessageType&#xD;&#xA;對照表（來自流程的Overview備註）&#xD;&#xA;代碼 | 意義&#xD;&#xA;S Success(成功)&#xD;&#xA;W Warning(警告)&#xD;&#xA;E Error(錯誤)&#xD;&#xA;A Abort(中止)&#xD;&#xA;I Information(資訊)" sap:VirtualizedContainerService.HintSize="450,232" sap2010:WorkflowViewState.IdRef="Comment_1" Text="// Write your comments in the Text property">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    </ui:Comment>
    <ui:Comment sap2010:Annotation.AnnotationText="這支流程 vs.&#xD;&#xA;SRC_Get_GuiLabel.xaml&#xD;&#xA;的差異總結 &#xD;&#xA;項目 | SRC_Get_GuiLabel.xaml | SRC_Get_GuiStatusbar.xaml（本流程）&#xD;&#xA;目標控件 | 任意指定(in_ControlID參數) | 固定為狀態列(sbar)&#xD;&#xA;輸入參數 | 需要in_ControlID | 無輸入參數&#xD;&#xA;讀取的屬性 | 顏色、顯示文字、圖示、提示 | 訊息類型、訊息ID、訊息編號、訊息文字&#xD;&#xA;主要用途 | 判斷任意欄位/標籤的視覺狀態 | 專門判斷SAP執行後的成功/失敗訊息" sap:VirtualizedContainerService.HintSize="450,297" sap2010:WorkflowViewState.IdRef="Comment_4" Text="// Write your comments in the Text property">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    </ui:Comment>
    <ui:Comment sap2010:Annotation.AnnotationText="這支流程的用途與角色&#xD;&#xA;這是整個「GUI操作路線」裡最關�keys的錯誤/成功判斷工具：每次透過SAP GUI畫面操作完成一個動作後（例如存檔、送出、執行交易），SAP幾乎都會在狀態列顯示結果訊息。上層流程（例如您之前問過的 SRC_CM_FNCMDL_EXE_E.xaml、SRC_CM_GET_TBL_E.xaml）通常會呼叫這支流程，取得 out_MessageType，然後：&#xD;&#xA;&gt; 若是 &quot;E&quot;(錯誤)或&quot;A&quot;(中止) → 判定這次操作失敗，把out_MessageText記錄進Log，可能還要重試或中斷流程&#xD;&#xA;&gt; 若是 &quot;S&quot;(成功) → 判定操作成功，繼續下一步&#xD;&#xA;這跟您之前問過BAPI路線裡的 AddSuccessMessageToBAPILog.xaml（記錄BAPI成功訊息）、CheckAuthority.xaml（用例外判斷授權失敗）是功能對等的概念——只是這支是專門給GUI操作路線使用的「執行結果判斷工具」。" sap:VirtualizedContainerService.HintSize="450,379" sap2010:WorkflowViewState.IdRef="Comment_5" Text="// Write your comments in the Text property">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    </ui:Comment>
    <ui:LogMessage DisplayName="Log message - Start" sap:VirtualizedContainerService.HintSize="450,57" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Trace" Message="[WorkflowName + &quot; start&quot;]">
      <sap:WorkflowViewStateService.ViewState>
