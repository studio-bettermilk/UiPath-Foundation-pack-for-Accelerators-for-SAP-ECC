  <Sequence sap2010:Annotation.AnnotationText="- OverView&#xA;Add the Log File content into a new worksheet named [SRC_Log] in Excel Input File.&#xA;&#xA;- Input/Output&#xA;in_ExcelFilePath as Input File Path &lt;String&gt;&#xA;in_dt_LogData as Log Content read from Log File &lt;DataTable&gt;" DisplayName="SRC_WriteLogToExcel" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Default="SRC_WriteLogToExcel" Name="WorkflowName" />
    </Sequence.Variables>
    <ui:LogMessage DisplayName="Log message - Start" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Info" Message="[WorkflowName + &quot; start&quot;]" />
    <Sequence DisplayName="Delete [SRC_Log] worksheet" sap2010:WorkflowViewState.IdRef="Sequence_2">
      <Sequence.Variables>
        <Variable x:TypeArguments="ce:XLWorkbook" Name="Workbook" />
        <Variable x:TypeArguments="ce:IXLWorksheet" Name="Worksheet" />
      </Sequence.Variables>
      <Assign DisplayName="Assign Workbook (Initialization)" sap2010:WorkflowViewState.IdRef="Assign_1">
        <Assign.To>
          <OutArgument x:TypeArguments="ce:XLWorkbook">[Workbook]</OutArgument>
        </Assign.To>
        <Assign.Value>
          <InArgument x:TypeArguments="ce:XLWorkbook">[New XLWorkbook(in_ExcelFilePath)]</InArgument>
        </Assign.Value>
      </Assign>
      <Assign DisplayName="Assign Worksheet (Initialization)" sap2010:WorkflowViewState.IdRef="Assign_4">
        <Assign.To>
          <OutArgument x:TypeArguments="ce:IXLWorksheet">[Worksheet]</OutArgument>
        </Assign.To>
        <Assign.Value>
          <InArgument x:TypeArguments="ce:IXLWorksheet">[Nothing]</InArgument>
        </Assign.Value>
      </Assign>
      <If Condition="[Workbook.TryGetWorksheet(&quot;SRC_Log&quot;, Worksheet)]" DisplayName="If [SRC_Log] sheet exists" sap2010:WorkflowViewState.IdRef="If_1">
        <If.Then>
          <InvokeMethod DisplayName="Invoke Method Delete [SRC_Log]" sap2010:WorkflowViewState.IdRef="InvokeMethod_1" MethodName="Delete">
            <InvokeMethod.TargetObject>
              <InArgument x:TypeArguments="ce:IXLWorksheet">[Workbook.Worksheet("SRC_Log")]</InArgument>
            </InvokeMethod.TargetObject>
          </InvokeMethod>
        </If.Then>
      </If>
      <InvokeMethod DisplayName="Invoke Method Save after Delete" sap2010:WorkflowViewState.IdRef="InvokeMethod_2" MethodName="Save">
        <InvokeMethod.TargetObject>
          <InArgument x:TypeArguments="ce:XLWorkbook">[Workbook]</InArgument>
        </InvokeMethod.TargetObject>
      </InvokeMethod>
    </Sequence>
    <ui:WriteRange AddHeaders="True" DataTable="[in_dt_LogData]" DisplayName="Write Range" sap2010:WorkflowViewState.IdRef="WriteRange_1" SheetName="SRC_Log" StartingCell="A1" WorkbookPath="[in_ExcelFilePath]" />
    <Sequence DisplayName="Change the position of the sheet" sap2010:WorkflowViewState.IdRef="Sequence_3">
      <Sequence.Variables>
        <Variable x:TypeArguments="ce:XLWorkbook" Name="Workbook" />
      </Sequence.Variables>
      <Assign DisplayName="Assign Workbook" sap2010:WorkflowViewState.IdRef="Assign_5">
        <Assign.To>
          <OutArgument x:TypeArguments="ce:XLWorkbook">[Workbook]</OutArgument>
        </Assign.To>
        <Assign.Value>
          <InArgument x:TypeArguments="ce:XLWorkbook">[New XLWorkbook(in_ExcelFilePath)]</InArgument>
        </Assign.Value>
      </Assign>
      <Assign sap2010:Annotation.AnnotationText="Move [SRC_Log] to the first sheet" DisplayName="Assign Workbook.Worksheet(&quot;SRC_Log&quot;).Position" sap2010:WorkflowViewState.IdRef="Assign_2">
        <Assign.To>
          <OutArgument x:TypeArguments="x:Int32">[Workbook.Worksheet("SRC_Log").Position]</OutArgument>
        </Assign.To>
        <Assign.Value>
          <InArgument x:TypeArguments="x:Int32">1</InArgument>
        </Assign.Value>
      </Assign>
      <Assign sap2010:Annotation.AnnotationText="Change [SRC_Log] Date/Number format to text." DisplayName="Assign Workbook.Worksheet(&quot;SRC_Log&quot;).Style.NumberFormat.NumberFormatId" sap2010:WorkflowViewState.IdRef="Assign_3">
        <Assign.To>
          <OutArgument x:TypeArguments="x:Int32">[Workbook.Worksheet("SRC_Log").Style.NumberFormat.NumberFormatId]</OutArgument>
        </Assign.To>
        <Assign.Value>
          <InArgument x:TypeArguments="x:Int32">49</InArgument>
        </Assign.Value>
      </Assign>
      <InvokeMethod DisplayName="Invoke Method Save after Change position" sap2010:WorkflowViewState.IdRef="InvokeMethod_3" MethodName="Save">
        <InvokeMethod.TargetObject>
          <InArgument x:TypeArguments="ce:XLWorkbook">[Workbook]</InArgument>
        </InvokeMethod.TargetObject>
      </InvokeMethod>
    </Sequence>
