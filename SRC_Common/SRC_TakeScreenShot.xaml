          <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    </ui:SaveImage>
    <Assign sap2010:Annotation.AnnotationText="回傳結果路徑&#xD;&#xA;Assign out_ScreenShotPath：把ScreenShotFile(完整路徑)指派給輸出參數out_ScreenShotPath，讓呼叫端可以取得這張截圖確切存在哪裡" DisplayName="Assign out_ScreenShotPath" sap:VirtualizedContainerService.HintSize="450,252" sap2010:WorkflowViewState.IdRef="Assign_2">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[out_ScreenShotPath]</OutArgument>
      </Assign.To>
      <Assign.Value>
