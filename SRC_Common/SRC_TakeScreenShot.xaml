  <Sequence sap2010:Annotation.AnnotationText="- Overview (這支流程的功能非常直觀：擷取目前整個畫面(全螢幕)的截圖，並存成圖片檔案到指定路徑，是自動化流程裡常用來記錄畫面證據(例如出錯時存證、或每個關鍵步驟留紀錄)的工具。)&#xA;Creates a screenshot file with the specified filename and path.&#xA;&#xA;- Input/Output&#xA;in_FileName as Screenshot Filename &lt;String&gt;&#xA;in_OutputPath as Screenshot save path &lt;String&gt;&#xA;out_ScreenShotPath as Output created screenshot filename with relative path &lt;String&gt;" DisplayName="SRC_TakeScreenShot" sap:VirtualizedContainerService.HintSize="939,1771" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="ScreenShotFile" />
      <Variable x:TypeArguments="ui:Image" Name="ScreenShot" />
      <Variable x:TypeArguments="x:String" Default="SRC_TakeScreenShot" Name="WorkFlowName" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
        <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:Comment sap:VirtualizedContainerService.HintSize="450,206" sap2010:WorkflowViewState.IdRef="Comment_1" Text="這支流程的邏輯很精簡，只有四個核心動作：組路徑 → 截全螢幕圖 → 存檔 → 回傳路徑。因為截圖的目標鎖定在桌面(Program Manager)而不是特定視窗，所以效果等同於「按下鍵盤PrtScn鍵擷取整個畫面」，適合用來在流程執行過程中的任意時間點留下畫面證據。" />
    <ui:Comment sap:VirtualizedContainerService.HintSize="450,167" sap2010:WorkflowViewState.IdRef="Comment_5" Text="這支流程的功能非常直觀：擷取目前整個畫面(全螢幕)的截圖，並存成圖片檔案到指定路徑，是自動化流程裡常用來記錄畫面證據(例如出錯時存證、或每個關鍵步驟留紀錄)的工具。" />
    <ui:LogMessage DisplayName="Log message - Start" sap:VirtualizedContainerService.HintSize="450,57" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Info" Message="[WorkflowName + &quot; start&quot;]">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsExpanded">False</x:Boolean>
          <x:Boolean x:Key="IsPinned">False</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    </ui:LogMessage>
    <Assign sap2010:Annotation.AnnotationText="Concatenate Screenshot FilePath and FileName.&#xD;&#xA;&#xD;&#xA;組合完整檔案路徑(Assign ScreenShotFile)&#xD;&#xA;&gt; 把in_OutputPath(資料夾路徑)與in_FileName(檔案名稱)用&quot;\&quot;符號串接起來，組成一個完整路徑字串，存到變數ScreenShotFile裡" DisplayName="Assign ScreenShotFile" sap:VirtualizedContainerService.HintSize="450,285" sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[ScreenShotFile]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[in_OutputPath + "\" + in_FileName]</InArgument>
      </Assign.Value>
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    </Assign>
    <ui:TakeScreenshot WaitBefore="{x:Null}" sap2010:Annotation.AnnotationText="擷取螢幕截圖(TakeScreenshot)&#xD;&#xA;&gt; 使用TakeScreenshot活動，對Target設定為&lt;wnd app='explorer.exe' cls='Progman' title='Program Manager' /&gt;(也就是Windows桌面本身)進行截圖&#xD;&#xA;&gt; 因為Target指向的是桌面(Program Manager)而不是特定應用程式視窗，所以這裡拍到的是整個螢幕畫面，不論當時SAP或其他視窗開在哪個位置都會一併被截取進去&#xD;&#xA;&gt; 截圖結果會存到ui:Image型別的變數ScreenShot裡(記憶體中的圖片物件，尚未寫入硬碟)" DisplayName="Take full window screenshot " sap:VirtualizedContainerService.HintSize="450,294" sap2010:WorkflowViewState.IdRef="TakeScreenshot_1" Screenshot="[ScreenShot]">
      <ui:TakeScreenshot.Target>
        <ui:Target ClippingRegion="{x:Null}" Element="{x:Null}" Id="3f9457a1-1307-4b61-a1d9-849d9e24d7f7" Selector="&lt;wnd app='explorer.exe' cls='Progman' title='Program Manager' /&gt;" TimeoutMS="30" WaitForReady="INTERACTIVE" />
      </ui:TakeScreenshot.Target>
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    </ui:TakeScreenshot>
    <ui:SaveImage sap2010:Annotation.AnnotationText="存檔(SaveImage)&#xD;&#xA;使用SaveImage活動，把記憶體中的ScreenShot圖片物件，寫入到ScreenShotFile路徑，正式產生圖片檔案" DisplayName="Save screenshot image" FileName="[ScreenShotFile]" sap:VirtualizedContainerService.HintSize="450,244" sap2010:WorkflowViewState.IdRef="SaveImage_1" Image="[ScreenShot]">
      <sap:WorkflowViewStateService.ViewState>
