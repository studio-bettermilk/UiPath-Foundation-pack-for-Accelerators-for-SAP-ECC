  <Sequence sap2010:Annotation.AnnotationText="- Overview&#xA;Creates a screenshot file with the specified filename and path.&#xA;&#xA;- Input/Output&#xA;in_FileName as Screenshot Filename &lt;String&gt;&#xA;in_OutputPath as Screenshot save path &lt;String&gt;&#xA;out_ScreenShotPath as Output created screenshot filename with relative path &lt;String&gt;" DisplayName="SRC_TakeScreenShot" sap2010:WorkflowViewState.IdRef="Sequence_1">
