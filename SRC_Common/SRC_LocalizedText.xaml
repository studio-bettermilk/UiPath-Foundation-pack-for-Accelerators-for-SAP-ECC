            </Sequence.Variables>
            <ui:ReadRange AddHeaders="True" DataTable="[dt_MessageData]" DisplayName="Read Range for each worksheet in Message File" sap2010:WorkflowViewState.IdRef="ReadRange_3" SheetName="[ws.Name.ToString]" WorkbookPath="[MessageFilePath]">
              <ui:ReadRange.Range>
                <InArgument x:TypeArguments="x:String">
                  <Literal x:TypeArguments="x:String" Value="" />
                </InArgument>
              </ui:ReadRange.Range>
            </ui:ReadRange>
            <ui:ForEachRow CurrentIndex="{x:Null}" DataTable="[dt_MessageData]" DisplayName="For each row in MessageData" sap2010:WorkflowViewState.IdRef="ForEachRow_1">
              <ui:ForEachRow.Body>
                <ActivityAction x:TypeArguments="sd:DataRow">
                  <ActivityAction.Argument>
                    <DelegateInArgument x:TypeArguments="sd:DataRow" Name="row" />
                  </ActivityAction.Argument>
                  <If Condition="[NOT String.IsNullOrEmpty(row(&quot;No.&quot;).ToString.Trim)]" DisplayName="If No in MessageFile is empty or null" sap2010:WorkflowViewState.IdRef="If_7">
                    <If.Then>
                      <If sap2010:Annotation.AnnotationText="If target language dosen't exist in MessageFile use &quot;en-US&quot; as default." Condition="[row(Language) IsNot Nothing]" DisplayName="If target language dosen't exist in MessageFile" sap2010:WorkflowViewState.IdRef="If_8">
                        <If.Then>
                          <Assign DisplayName="Add key/value pair Messages" sap2010:WorkflowViewState.IdRef="Assign_25">
                            <Assign.To>
                              <OutArgument x:TypeArguments="x:String">[Messages(ws.Name &amp; row("No.").ToString)]</OutArgument>
                            </Assign.To>
                            <Assign.Value>
                              <InArgument x:TypeArguments="x:String">[row(Language).ToString]</InArgument>
                            </Assign.Value>
                          </Assign>
                        </If.Then>
                        <If.Else>
                          <Assign DisplayName="Add key/value pair Messages (Case Default)" sap2010:WorkflowViewState.IdRef="Assign_29">
                            <Assign.To>
                              <OutArgument x:TypeArguments="x:String">[Messages(ws.Name &amp; row("No.").ToString)]</OutArgument>
                            </Assign.To>
                            <Assign.Value>
                              <InArgument x:TypeArguments="x:String">[row("en-US").ToString]</InArgument>
                            </Assign.Value>
                          </Assign>
                        </If.Else>
                      </If>
                    </If.Then>
                  </If>
                </ActivityAction>
              </ui:ForEachRow.Body>
            </ui:ForEachRow>
          </Sequence>
        </ActivityAction>
      </ui:ForEach.Body>
    </ui:ForEach>
    <Assign DisplayName="Assign out_Messages (Output Argument)" sap2010:WorkflowViewState.IdRef="Assign_27">
