      </Assign.Value>
    </Assign>
    <ui:ForEach x:TypeArguments="ce:IXLWorksheet" CurrentIndex="{x:Null}" DisplayName="For Each Sheet in Message File" sap2010:WorkflowViewState.IdRef="ForEach`1_1" Values="[New XLWorkbook(MessageFilePath).Worksheets]">
