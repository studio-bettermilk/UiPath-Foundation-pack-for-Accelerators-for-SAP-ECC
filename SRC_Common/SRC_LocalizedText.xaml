  <Sequence sap2010:Annotation.AnnotationText="-Overview&#xA;Return a dictionary object with localized message based on OS Language, specified in Message_File.xlsx.&#xD;&#xA;&#xA;-Input/Output&#xA;out_Messages as Dictionary with all localized messages. Dictionary &lt;String, String&gt;" DisplayName="SRC_LocalizedText" sap2010:WorkflowViewState.IdRef="Sequence_10">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="Language" />
      <Variable x:TypeArguments="x:String" Default="SRC_LocalizedText" Name="WorkflowName" />
      <Variable x:TypeArguments="x:String" Name="MessageFilePath" />
      <Variable x:TypeArguments="scg:Dictionary(x:String, x:String)" Name="Messages" />
    </Sequence.Variables>
    <ui:LogMessage DisplayName="Log message - Start" sap2010:WorkflowViewState.IdRef="LogMessage_5" Level="Info" Message="[WorkflowName + &quot; start&quot;]" />
