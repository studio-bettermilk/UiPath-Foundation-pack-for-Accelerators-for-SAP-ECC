    <ui:Comment sap2010:Annotation.AnnotationText="逐工作表(Sheet)讀取Excel 用ForEach迴圈跑過Message_File.xlsx裡的每一個工作表(New XLWorkbook(MessageFilePath).Worksheets)：&#xD;&#xA;對每個工作表用ReadRange把整張表(含標頭列)讀進dt_MessageData這個DataTable&#xD;&#xA;再用ForEachRow逐行掃描這個DataTable" sap:VirtualizedContainerService.HintSize="514,199" sap2010:WorkflowViewState.IdRef="Comment_6" Text="//">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    </ui:Comment>
    <ui:ForEach x:TypeArguments="ce:IXLWorksheet" CurrentIndex="{x:Null}" DisplayName="For Each Sheet in Message File" sap:VirtualizedContainerService.HintSize="514,1757" sap2010:WorkflowViewState.IdRef="ForEach`1_1" Values="[New XLWorkbook(MessageFilePath).Worksheets]">
      <ui:ForEach.Body>
        <ActivityAction x:TypeArguments="ce:IXLWorksheet">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="ce:IXLWorksheet" Name="ws" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Add Sheet Name into Collection" sap:VirtualizedContainerService.HintSize="512,1626" sap2010:WorkflowViewState.IdRef="Sequence_9">
            <Sequence.Variables>
              <Variable x:TypeArguments="sd:DataTable" Name="dt_MessageData" />
            </Sequence.Variables>
            <sap:WorkflowViewStateService.ViewState>
              <scg:Dictionary x:TypeArguments="x:String, x:Object">
                <x:Boolean x:Key="IsExpanded">True</x:Boolean>
              </scg:Dictionary>
            </sap:WorkflowViewStateService.ViewState>
            <ui:ReadRange AddHeaders="True" DataTable="[dt_MessageData]" DisplayName="Read Range for each worksheet in Message File" sap:VirtualizedContainerService.HintSize="478,227" sap2010:WorkflowViewState.IdRef="ReadRange_3" SheetName="[ws.Name.ToString]" WorkbookPath="[MessageFilePath]">
              <ui:ReadRange.Range>
                <InArgument x:TypeArguments="x:String">
                  <Literal x:TypeArguments="x:String" Value="" />
                </InArgument>
              </ui:ReadRange.Range>
            </ui:ReadRange>
            <ui:Comment sap2010:Annotation.AnnotationText="逐列判斷並組字典Key 對DataTable裡的每一列(row)：&#xD;&#xA;&gt; 第一層判斷：如果該列的&quot;No.&quot;欄位不是空白或Null(代表這是一筆有效的訊息編號)，才繼續往下處理&#xD;&#xA;&gt; 第二層判斷：檢查該列是否存在與目前系統語系同名的欄位(即row(Language) IsNot Nothing，例如若Language=&quot;zh-TW&quot;，就檢查Excel裡有沒有一欄叫zh-TW)&#xD;&#xA;&gt;&gt; 若有：取該語系欄位的值，寫入Messages(工作表名稱 &amp; &quot;No.&quot;欄位值) = 該語系文字&#xD;&#xA;&gt;&gt; 若沒有(Else，找不到對應語系欄)：改用&quot;en-US&quot;欄位的值作為預設語言(Fallback)，同樣寫入Messages(工作表名稱 &amp; &quot;No.&quot;欄位值)&#xD;&#xA;&#xD;&#xA;也就是說，字典的Key是「工作表名稱 + 訊息編號」組合而成(例如&quot;Sheet1&quot; &amp; &quot;001&quot; = &quot;Sheet1001&quot;)，這樣可以避免不同工作表之間訊息編號重複衝突；Value則是該語系(或英文預設)對應的實際文字內容。" sap:VirtualizedContainerService.HintSize="478,395" sap2010:WorkflowViewState.IdRef="Comment_8" Text="// Write your comments in the Text property">
              <sap:WorkflowViewStateService.ViewState>
                <scg:Dictionary x:TypeArguments="x:String, x:Object">
                  <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
                </scg:Dictionary>
              </sap:WorkflowViewStateService.ViewState>
            </ui:Comment>
            <ui:ForEachRow ColumnNames="{x:Null}" CurrentIndex="{x:Null}" DataTable="[dt_MessageData]" DisplayName="For each row in MessageData" sap:VirtualizedContainerService.HintSize="478,944" sap2010:WorkflowViewState.IdRef="ForEachRow_1">
              <ui:ForEachRow.Body>
                <ActivityAction x:TypeArguments="sd:DataRow">
                  <ActivityAction.Argument>
                    <DelegateInArgument x:TypeArguments="sd:DataRow" Name="row" />
                  </ActivityAction.Argument>
                  <If Condition="[NOT String.IsNullOrEmpty(row(&quot;No.&quot;).ToString.Trim)]" DisplayName="If No in MessageFile is empty or null" sap:VirtualizedContainerService.HintSize="452,701" sap2010:WorkflowViewState.IdRef="If_7">
                    <If.Then>
                      <If sap2010:Annotation.AnnotationText="If target language dosen't exist in MessageFile use &quot;en-US&quot; as default." Condition="[row(Language) IsNot Nothing]" DisplayName="If target language dosen't exist in MessageFile" sap:VirtualizedContainerService.HintSize="450,482" sap2010:WorkflowViewState.IdRef="If_8">
                        <sap:WorkflowViewStateService.ViewState>
                          <scg:Dictionary x:TypeArguments="x:String, x:Object">
                            <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
                          </scg:Dictionary>
                        </sap:WorkflowViewStateService.ViewState>
                        <If.Then>
                          <Assign DisplayName="Add key/value pair Messages" sap:VirtualizedContainerService.HintSize="343,143" sap2010:WorkflowViewState.IdRef="Assign_25">
                            <Assign.To>
                              <OutArgument x:TypeArguments="x:String">[Messages(ws.Name &amp; row("No.").ToString)]</OutArgument>
                            </Assign.To>
                            <Assign.Value>
                              <InArgument x:TypeArguments="x:String">[row(Language).ToString]</InArgument>
                            </Assign.Value>
                          </Assign>
                        </If.Then>
                        <If.Else>
                          <Assign DisplayName="Add key/value pair Messages (Case Default)" sap:VirtualizedContainerService.HintSize="343,143" sap2010:WorkflowViewState.IdRef="Assign_29">
                            <Assign.To>
                              <OutArgument x:TypeArguments="x:String">[Messages(ws.Name &amp; row("No.").ToString)]</OutArgument>
                            </Assign.To>
                            <Assign.Value>
                              <InArgument x:TypeArguments="x:String">[row("en-US").ToString]</InArgument>
                            </Assign.Value>
                          </Assign>
                        </If.Else>
                      </If>
                    </If.Then>
                  </If>
                </ActivityAction>
              </ui:ForEachRow.Body>
            </ui:ForEachRow>
          </Sequence>
        </ActivityAction>
      </ui:ForEach.Body>
    </ui:ForEach>
    <ui:Comment sap2010:Annotation.AnnotationText="Assign out_Messages：把組好的Messages字典指派給輸出參數out_Messages，讓呼叫端可以拿到完整的多語系訊息對照表" sap:VirtualizedContainerService.HintSize="514,150" sap2010:WorkflowViewState.IdRef="Comment_9" Text="//">
