    </ui:Comment>
    <ui:TypeInto DelayBefore="{x:Null}" DelayBetweenKeys="{x:Null}" DelayMS="{x:Null}" Activate="True" AlterIfDisabled="True" sap2010:Annotation.AnnotationText="Type the transaction code." ClickBeforeTyping="False" DisplayName="Type into SAP transaction code" EmptyField="False" sap:VirtualizedContainerService.HintSize="450,199" sap2010:WorkflowViewState.IdRef="TypeInto_1" SendWindowMessages="False" SimulateType="True" Text="[in_TransactionCode]">
