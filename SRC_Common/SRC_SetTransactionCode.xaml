          <x:Boolean x:Key="IsPinned">False</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    </ui:LogMessage>
    <ui:Comment sap2010:Annotation.AnnotationText="輸入交易碼(TypeInto)&#xD;&#xA;&gt; 使用TypeInto活動，把in_TransactionCode的文字值輸入到in_Selector所定位的元件裡&#xD;&#xA;&gt; 這裡有幾個重要屬性設定：&#xD;&#xA;&gt;&gt; SimulateType=&quot;True&quot;：採用**模擬輸入(Simulate Type)**的方式打字，速度快且不受畫面焦點干擾，是自動化最穩定的輸入方式&#xD;&#xA;&gt;&gt; ClickBeforeTyping=&quot;False&quot;：輸入前不需要先點擊該元件(通常SAP交易碼輸入欄本身就有固定焦點位置)&#xD;&#xA;&gt;&gt; AlterIfDisabled=&quot;True&quot;：如果元件目前是disabled(不可互動)狀態，仍會嘗試強制修改讓輸入動作可以進行&#xD;&#xA;&gt;&gt; EmptyField=&quot;False&quot;：輸入前不會先清空欄位內容(這通常是因為交易碼輸入欄本身是空的，或流程假設呼叫前欄位已是乾淨狀態)" sap:VirtualizedContainerService.HintSize="450,346" sap2010:WorkflowViewState.IdRef="Comment_2" Text="//">
      <sap:WorkflowViewStateService.ViewState>
