  <Sequence sap2010:Annotation.AnnotationText="- Overview&#xA;Aggregate and change the following data aquired from TBTCO and add into DataTable.&#xA;　・Aggregate the scheduled start date and time (row(&quot;AGGREGATE_SDLDATETIME&quot;))&#xA;　・Aggregate the delay time (row(&quot;AGGREGATE_DELAY&quot;))&#xA;　・Aggregate the processing time (row(&quot;AGGREGATE_DURATION&quot;))&#xA;　・Change the format of start time (row(&quot;STRTTIME&quot;))&#xA;&#xA;- Input/Output&#xA;io_dt_JobOverview as the job search results aquired from TBTCO&lt;DataTable&gt;" DisplayName="AggregateItem" sap2010:WorkflowViewState.IdRef="Sequence_12">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Default="AggregateItem" Name="WorkflowName" />
    </Sequence.Variables>
    <ui:LogMessage DisplayName="Log message - Start" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Info" Message="[WorkflowName + &quot;  start&quot;]" />
    <ui:ForEachRow CurrentIndex="{x:Null}" DataTable="[io_dt_JobOverview]" DisplayName="For Each Row" sap2010:WorkflowViewState.IdRef="ForEachRow_2">
      <ui:ForEachRow.Body>
        <ActivityAction x:TypeArguments="sd:DataRow">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="sd:DataRow" Name="row" />
          </ActivityAction.Argument>
          <Sequence sap2010:WorkflowViewState.IdRef="Sequence_13">
            <If Condition="[Not (String.IsNullOrEmpty(row.Item(&quot;SDLSTRTDT&quot;).ToString) OrElse String.IsNullOrEmpty(row.Item(&quot;SDLSTRTTM&quot;).ToString))]" DisplayName="If - Check if SDLSTRTDT Else SDLSTRTTM  has a value" sap2010:WorkflowViewState.IdRef="If_6">
              <If.Then>
                <Sequence sap2010:WorkflowViewState.IdRef="Sequence_11">
                  <Assign sap2010:Annotation.AnnotationText="Aggregate the scheduled start date and time." DisplayName="Assign : AGGREGATE_SDLDATETIME" sap2010:WorkflowViewState.IdRef="Assign_18">
                    <Assign.To>
                      <OutArgument x:TypeArguments="x:Object">[row("AGGREGATE_SDLDATETIME")]</OutArgument>
                    </Assign.To>
                    <Assign.Value>
                      <InArgument x:TypeArguments="x:Object">[DateTime.ParseExact(row("SDLSTRTDT").ToString + row("SDLSTRTTM").ToString, "yyyyMMddHHmmss",nothing)]</InArgument>
                    </Assign.Value>
                  </Assign>
                  <If Condition="[Not String.IsNullOrEmpty(row.Item(&quot;STRTDATE&quot;).ToString)]" DisplayName="If - Check if STRTDATE  has a value" sap2010:WorkflowViewState.IdRef="If_5">
                    <If.Then>
                      <Sequence sap2010:WorkflowViewState.IdRef="Sequence_10">
                        <Assign sap2010:Annotation.AnnotationText="Aggregate the time difference between the scheduled and the execution start time (delay time). " DisplayName="Assign : AGGREGATE_DELAY" sap2010:WorkflowViewState.IdRef="Assign_16">
                          <Assign.To>
                            <OutArgument x:TypeArguments="x:Object">[row("AGGREGATE_DELAY")]</OutArgument>
                          </Assign.To>
                          <Assign.Value>
                            <InArgument x:TypeArguments="x:Object" xml:space="preserve">[DateDiff( _
    "s", _
	DateTime.ParseExact(row("SDLSTRTDT").ToString +row("SDLSTRTTM").ToString,"yyyyMMddHHmmss",Nothing), _
	DateTime.ParseExact(row("STRTDATE").ToString +row("STRTTIME").ToString,"yyyyMMddHHmmss",Nothing), _
	Nothing
).ToString]</InArgument>
                          </Assign.Value>
                        </Assign>
                        <If Condition="[Not String.IsNullOrEmpty(row.Item(&quot;ENDDATE&quot;).ToString)]" DisplayName="If - Check if ENDDATE  has a value" sap2010:WorkflowViewState.IdRef="If_4">
                          <If.Then>
                            <Assign sap2010:Annotation.AnnotationText="Aggregate processing time from start to end of the job." DisplayName="Assign : DURATION" sap2010:WorkflowViewState.IdRef="Assign_17">
                              <Assign.To>
                                <OutArgument x:TypeArguments="x:Object">[row("AGGREGATE_DURATION")]</OutArgument>
                              </Assign.To>
                              <Assign.Value>
                                <InArgument x:TypeArguments="x:Object" xml:space="preserve">[DateDiff( _
    "s", _
	DateTime.ParseExact(row("STRTDATE").ToString + row("STRTTIME").ToString,"yyyyMMddHHmmss",Nothing), _
	DateTime.ParseExact(row("ENDDATE").ToString + row("ENDTIME").ToString,"yyyyMMddHHmmss",Nothing), _
	Nothing
).ToString]</InArgument>
                              </Assign.Value>
                            </Assign>
                          </If.Then>
                        </If>
                      </Sequence>
                    </If.Then>
                  </If>
                </Sequence>
              </If.Then>
            </If>
            <If Condition="[Not String.IsNullOrEmpty(row.Item(&quot;STRTTIME&quot;).ToString)]" DisplayName="If - Check if STRTTIME  has a value" sap2010:WorkflowViewState.IdRef="If_7">
              <If.Then>
                <Assign sap2010:Annotation.AnnotationText="Change the format of &quot;STRTTIME&quot;.&#xA;HHmmss =&gt; HH:mm:ss" DisplayName="Assign : STRTTIME" sap2010:WorkflowViewState.IdRef="Assign_19">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:Object">[row("STRTTIME")]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:Object">[DateTime.ParseExact(row("STRTTIME").ToString,"HHmmss",nothing).ToString("HH:mm:ss")]</InArgument>
                  </Assign.Value>
                </Assign>
              </If.Then>
            </If>
          </Sequence>
        </ActivityAction>
      </ui:ForEachRow.Body>
    </ui:ForEachRow>
