  <Sequence sap2010:Annotation.AnnotationText="- Overview&#xD;&#xA;Rewrite the job status stored on List to query which is sent to RFC_READ_TABLE and store it in DataTable.&#xD;&#xA;- Input/Output&#xD;&#xA;out_dt_Options as search criteria table [OPTIONS] that searches SAP table [TBTCO]&lt;DataTable&gt;&#xD;&#xA;out_SelectedStatus as Job status &lt;List(Of String)&gt;" DisplayName="InsertOptionsStatus" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Default="InsertOptionsStatus" Name="WorkflowName" />
    </Sequence.Variables>
    <ui:LogMessage DisplayName="Log message - Start" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Info" Message="[WorkflowName + &quot;  start&quot;]" />
    <Sequence DisplayName="Insert Options - STATUS" sap2010:WorkflowViewState.IdRef="Sequence_3">
      <Sequence.Variables>
        <Variable x:TypeArguments="x:String" Name="OptionStringStatus" />
      </Sequence.Variables>
      <Assign DisplayName="Assign - OptionStringStatus" sap2010:WorkflowViewState.IdRef="Assign_1">
        <Assign.To>
          <OutArgument x:TypeArguments="x:String">[OptionStringStatus]</OutArgument>
        </Assign.To>
        <Assign.Value>
          <InArgument x:TypeArguments="x:String">[nothing]</InArgument>
        </Assign.Value>
      </Assign>
      <If Condition="[in_SelectedStatus.Count &gt; 0]" DisplayName="If job status is selected" sap2010:WorkflowViewState.IdRef="If_3">
        <If.Then>
          <Sequence sap2010:WorkflowViewState.IdRef="Sequence_2">
            <Sequence.Variables>
              <Variable x:TypeArguments="x:Int32" Name="IndexNo" />
            </Sequence.Variables>
            <ui:ForEach x:TypeArguments="x:String" sap2010:Annotation.AnnotationText="Combine selected job status separated by commas." CurrentIndex="[IndexNo]" DisplayName="For Each (SelectedStatus)" sap2010:WorkflowViewState.IdRef="ForEach`1_1" Values="[in_SelectedStatus]">
              <ui:ForEach.Body>
                <ActivityAction x:TypeArguments="x:String">
                  <ActivityAction.Argument>
                    <DelegateInArgument x:TypeArguments="x:String" Name="status" />
                  </ActivityAction.Argument>
                  <If Condition="[in_SelectedStatus.Count -1  = IndexNo]" DisplayName="If : SelectedStatus.Count -1  = Position" sap2010:WorkflowViewState.IdRef="If_1">
                    <If.Then>
                      <Assign sap2010:Annotation.AnnotationText="The last array" DisplayName="Assign : OptionStringStatus (End of array)" sap2010:WorkflowViewState.IdRef="Assign_2">
                        <Assign.To>
                          <OutArgument x:TypeArguments="x:String">[OptionStringStatus]</OutArgument>
                        </Assign.To>
                        <Assign.Value>
                          <InArgument x:TypeArguments="x:String">[OptionStringStatus +"'" +status + "'"]</InArgument>
                        </Assign.Value>
                      </Assign>
                    </If.Then>
                    <If.Else>
                      <Assign sap2010:Annotation.AnnotationText="Other than the last array" DisplayName="Assign : OptionStringStatus (First Array and After)" sap2010:WorkflowViewState.IdRef="Assign_3">
                        <Assign.To>
                          <OutArgument x:TypeArguments="x:String">[OptionStringStatus]</OutArgument>
                        </Assign.To>
                        <Assign.Value>
                          <InArgument x:TypeArguments="x:String" xml:space="preserve">[OptionStringStatus +"'" +status + "'"  + ","]</InArgument>
                        </Assign.Value>
                      </Assign>
                    </If.Else>
                  </If>
                </ActivityAction>
              </ui:ForEach.Body>
            </ui:ForEach>
            <If Condition="[io_dt_Options.Rows.Count = 0]" DisplayName="If : Branch by number of records in DataTable (Status)" sap2010:WorkflowViewState.IdRef="If_2">
              <If.Then>
                <ui:AddDataRow DataRow="{x:Null}" ArrayRow="[{&quot;STATUS IN (&quot; &amp; OptionStringStatus &amp; &quot;)&quot;}]" DataTable="[io_dt_Options]" DisplayName="Add Data Row(First row) - Status" sap2010:WorkflowViewState.IdRef="AddDataRow_1" />
              </If.Then>
              <If.Else>
                <ui:AddDataRow DataRow="{x:Null}" ArrayRow="[{&quot;AND STATUS IN (&quot; + OptionStringStatus + &quot;)&quot;}]" DataTable="[io_dt_Options]" DisplayName="Add Data Row(2nd row and after) - Status" sap2010:WorkflowViewState.IdRef="AddDataRow_2" />
              </If.Else>
            </If>
          </Sequence>
        </If.Then>
      </If>
    </Sequence>
    <ui:LogMessage DisplayName="Log message - End" sap2010:WorkflowViewState.IdRef="LogMessage_2" Level="Info" Message="[WorkflowName + &quot;  end&quot;]" />
    <sads:DebugSymbol.Symbol></sads:DebugSymbol.Symbol>
  </Sequence>
